# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# environment — never commit real secrets
.env
.env.*
!.env.example
!.env.test.example

# test / coverage
coverage/
.vitest/
test-results/
playwright-report/
# throwaway Platform Admin credentials generated by `pnpm e2e:seed`
.e2e-admin.json
# throwaway visual-fixture credentials generated by `pnpm e2e:seed`
.e2e-visual.json

# prisma
packages/database/prisma/*.db
packages/database/generated/

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Redis snapshots. A runtime artifact of a local `redis-server`, never project
# content — and a data dump has no business in history (CLAUDE.md §2.6).
*.rdb

# Probe files written INTO package sources by tests/unit/module-boundaries.test.ts
# and its pool equivalent, then deleted. They exist only while the suite runs,
# and a `git status` during a run would otherwise offer them for commit.
**/src/__boundary_probe.ts
**/src/__pool_probe.ts
# The isolation gate's own self-test backs these up before editing them.
**/.schema.gate-test.bak
**/.tenant-models.gate-test.bak

# Throwaway Prisma output from tests/unit/prisma-config.test.ts (F-91). Never
# committed; removed by the test itself, and listed here so a crashed run
# cannot leave a generated client in a diff.
packages/database/.tmp-generate-*/
