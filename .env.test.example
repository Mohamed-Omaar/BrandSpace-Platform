# Test environment template — PLACEHOLDERS ONLY, never real credentials.
# Copy to `.env.test` (git-ignored). CI generates this file from a local
# throwaway PostgreSQL service; see .github/workflows/ci.yml.

NODE_ENV=test
APP_ENV=development
LOG_LEVEL=error
DATA_REGION=local

# Application role: NOBYPASSRLS. The isolation tests depend on this being a
# non-superuser, non-owner role — running them as a superuser would prove nothing.
DATABASE_URL=postgresql://brandspace_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/brandspace_test?schema=public
DATABASE_MIGRATION_URL=postgresql://brandspace_migrator:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/brandspace_test?schema=public

# PLATFORM connection — the ONE identity that RLS grants cross-tenant visibility.
#
# SET THIS ONLY in processes that perform audited platform operations
# (Platform Admin, the seed, platform workers). It MUST be absent from:
#   - the public website
#   - the customer dashboard
#   - tenant-facing API processes
#   - ordinary workers
#
# Leaving it unset makes asPlatform() fail closed, which is the correct
# behaviour for a process that has no business doing cross-tenant work.
# Never prefix it with NEXT_PUBLIC_: that would ship it to a browser.
DATABASE_PLATFORM_URL=postgresql://brandspace_platform:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/brandspace_test?schema=public

REDIS_URL=redis://localhost:6379/1

CUSTOMER_SESSION_SECRET=test-only-customer-session-secret-value-0000000000
PLATFORM_SESSION_SECRET=test-only-platform-session-secret-value-1111111111
SECRET_VAULT_KEK=test-only-vault-key-encryption-key-value-22222222222
# Phase 6 — a SEPARATE key domain for customer social tokens (D-136).
SOCIAL_TOKEN_VAULT_KEK=test-only-social-token-kek-value-33333333333333
# Phase 6 — the OAuth callback is built from this at request time.
PUBLIC_API_BASE_URL=http://localhost:3002
# Phase 6 — where the OAuth callback sends the browser BACK to (D-141). The API
# has no UI: a completed redirect ends at the dashboard. Unset, the callback
# fails closed rather than guessing an origin.
PUBLIC_DASHBOARD_BASE_URL=http://localhost:3001
BRANDSPACE_API_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Seed
#
# The Platform Owner's password. There is NO default: leave this unset and the
# seeded owner is created WITHOUT a password and cannot sign in, which is the
# safe outcome. Set it to a strong, local-only value to enable sign-in.
#
# The seed refuses placeholder-looking values, so replace this line rather than
# uncommenting it as-is. The value is never printed by the seed.
# SEED_PLATFORM_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_ONLY_VALUE
#
# Phase 2B: the same rule for the two seeded CUSTOMER workspace owners. Absent
# means they are created without a password and must be invited.
# SEED_CUSTOMER_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_ONLY_VALUE
