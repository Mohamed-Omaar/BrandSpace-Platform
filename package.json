{
  "name": "brandspace",
  "version": "0.1.0",
  "private": true,
  "description": "BrandSpace \u2014 bilingual multi-tenant AI brand and social media operating system",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @brandspace/database generate",
    "db:migrate": "pnpm --filter @brandspace/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @brandspace/database migrate:deploy",
    "db:reset": "pnpm --filter @brandspace/database reset",
    "db:seed": "pnpm --filter @brandspace/database seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "vitest run --project isolation",
    "test:unit": "vitest run --project unit",
    "gate:isolation": "tsx scripts/isolation-gate.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm gate:isolation && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "unrs-resolver"
    ]
  }
}
