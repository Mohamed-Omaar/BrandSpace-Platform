# BrandSpace — environment template.
#
# SECURITY: this file contains PLACEHOLDERS ONLY. Never commit a real key, token,
# password, or connection string. Copy to `.env` (git-ignored) and fill in locally.
# CLAUDE.md §2.3 and §2.6.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug

# D-03: first customers are in Saudi Arabia / the GCC. Use the closest compliant
# region when deployment begins. Kept as configuration so the region is portable.
DATA_REGION=local

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
#
# TWO ROLES, DELIBERATELY. docs/SECURITY.md §2.2:
#   - DATABASE_URL           -> tenant application role. NOBYPASSRLS, owns
#                               nothing, and NO policy grants it cross-tenant
#                               visibility. This is what makes RLS meaningful.
#   - DATABASE_MIGRATION_URL -> owner/migrator role. Runs migrations only.
#                               NEVER used to serve a request.
#   - DATABASE_PLATFORM_URL  -> platform role. The only identity named by a
#                               cross-tenant RLS policy. Confined to platform
#                               processes. See below.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://brandspace_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/brandspace_dev?schema=public
DATABASE_MIGRATION_URL=postgresql://brandspace_migrator:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/brandspace_dev?schema=public

# PLATFORM connection — the ONE identity that RLS grants cross-tenant visibility.
#
# SET THIS ONLY in processes that perform audited platform operations
# (Platform Admin, the API, the seed, platform workers). It MUST be absent from:
#   - the public website
#   - the customer dashboard
#   - ordinary workers
#
# PHASE 5A CHANGED WHAT "THE API" MEANS HERE, and the change is worth stating.
# `apps/api` now serves a CUSTOMER-AUTHENTICATED route (Brand Brain chat), and
# it needs this credential because the AI Gateway reads platform-owned `ai.*`
# configuration and settles credits outside any tenant context (F-68). It was
# already in PLATFORM_SURFACE_APPS, so no boundary moved — but the line above
# used to read "tenant-facing API processes" as though the API served none, and
# that is no longer true.
#
# The consequence, stated rather than assumed away: a future flaw in `apps/api`
# has a blast radius of every tenant, not one. The route keeps the two
# identities strictly apart — TENANT under `withWorkspace` for all Brand Brain
# data, PLATFORM for the gateway alone — and splitting AI execution into its own
# process is the next step if that surface grows (F-75).
#
# Leaving it unset makes asPlatform() fail closed, which is the correct
# behaviour for a process that has no business doing cross-tenant work.
# Never prefix it with NEXT_PUBLIC_: that would ship it to a browser.
DATABASE_PLATFORM_URL=postgresql://brandspace_platform:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/brandspace_dev?schema=public

# ---------------------------------------------------------------------------
# Redis (cache, queues, locks, rate limits)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Object storage — S3-compatible (Cloudflare R2 is the intended initial target).
# Provider-agnostic by design: swapping providers is configuration, not code.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=brandspace-dev-media
STORAGE_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY

# ---------------------------------------------------------------------------
# Client origin — how a request's source address is established.
#
# READ BY `dashboard` AND `api` ONLY. Those two terminate unauthenticated
# customer requests and run the authentication rate limiter, which counts
# attempts per SOURCE. A process that cannot establish a source does not apply
# that ceiling at all, so in production both services REFUSE TO START without
# this. The web site, the Control Center and the worker never read it.
#
#   railway-edge  the leftmost X-Forwarded-For entry. Correct on Railway: the
#                 edge proxy strips whatever the client sent and writes the real
#                 connecting address first. Counting hops from the right cannot
#                 be correct there, because the number of internal hops changes
#                 with the routing path when the CDN layer is involved.
#   xff-hops      ordinary reverse proxy that appends its own peer. Requires
#                 TRUSTED_PROXY_HOPS.
#   direct        no proxy at all; the transport peer is the client. REFUSED in
#                 production: behind any balancer it puts every customer into
#                 one rate-limit bucket.
#
# Locally there is no proxy, so `direct` is the honest value.
# ---------------------------------------------------------------------------
CLIENT_ORIGIN_STRATEGY=direct
# Only read under xff-hops. Digits only, at least 1, at most 10 — a malformed
# value is REFUSED, never coerced to zero (which would mean "read no header").
# TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Hostnames (D-04)
#   production: brandspace.cc / app.brandspace.cc / admin.brandspace.cc
# ---------------------------------------------------------------------------
PUBLIC_WEB_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:3003

# ---------------------------------------------------------------------------
# Session realms — MUST be different values, each at least 32 characters.
# A shared key would let a customer session be verified by Platform Admin.
# Generate with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
CUSTOMER_SESSION_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_VALUE_FOR_CUSTOMERS
PLATFORM_SESSION_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_CHAR_RANDOM_VALUE_ADMIN

# ---------------------------------------------------------------------------
# Secret vault key-encryption key (envelope encryption; KMS-ready).
# Generate with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
SECRET_VAULT_KEK=REPLACE_WITH_32_PLUS_CHAR_RANDOM_VALUE_FOR_VAULT_KEK

# ---------------------------------------------------------------------------
# Phase 6 — Social Publishing.
#
# SOCIAL TOKEN VAULT. A SEPARATE key-encryption key from SECRET_VAULT_KEK above,
# and deliberately so (D-136). The publish worker holds this one and has
# database access; if the two domains shared a key, that worker could unwrap
# every PLATFORM provider credential in the database — the exact reach F-07
# exists to deny it. One key, one blast radius.
#
# Generate with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
SOCIAL_TOKEN_VAULT_KEK=REPLACE_WITH_DIFFERENT_32_PLUS_CHAR_RANDOM_VALUE_SOCIAL
# Production uses a managed KMS key instead; with this set, the development
# provider is never constructed.
# SOCIAL_TOKEN_VAULT_KMS_KEY_ARN=REPLACE_WITH_MANAGED_KMS_KEY_ARN

# ---------------------------------------------------------------------------
# Phase 9 — Customer MFA.
#
# A THIRD key domain, for the same reason as the second (D-206). The customer
# sign-in path must be able to verify a TOTP code, so whatever key seals that
# seed is reachable from the login surface. Sealing it with SECRET_VAULT_KEK
# would put every platform provider credential within reach of a login request;
# sealing it with SOCIAL_TOKEN_VAULT_KEK would do the same for every customer's
# OAuth token. One key, one blast radius: authenticator seeds and nothing else.
#
# Generate with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
CUSTOMER_MFA_VAULT_KEK=REPLACE_WITH_DIFFERENT_32_PLUS_CHAR_RANDOM_VALUE_MFA
# CUSTOMER_MFA_VAULT_KMS_KEY_ARN=REPLACE_WITH_MANAGED_KMS_KEY_ARN

# ---------------------------------------------------------------------------
# Phase 9 — the DEVELOPMENT billing provider.
#
# NOT A PAYMENT CREDENTIAL, and there is none in this repository to be one
# (D-204). This value signs and verifies the loopback billing events the
# development adapter produces, so a forged one is refused the same way a real
# provider's would be. It is required rather than defaulted: a deployment that
# forgot to set it must fail closed, not sign with a value readable in source.
#
# Generate with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
BILLING_DEV_WEBHOOK_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_VALUE_BILLING

# ---------------------------------------------------------------------------
# PUBLIC BASE URLS.
#
# EVERY OAUTH CALLBACK IS BUILT FROM THESE AT REQUEST TIME, never written down
# in code. That is what lets staging use its own hostnames without a single
# code change:
#
#   staging      https://staging.brandspace.cc
#   admin        https://admin-staging.brandspace.cc
#   api          https://api-staging.brandspace.cc
#
# The social callback is `<PUBLIC_API_BASE_URL>/v1/social/callback/<provider>`,
# and the URI recorded when a flow starts is the one the callback is checked
# against — so changing this does not retroactively complete a flow already in
# progress, it correctly fails it.
#
# EACH PROVIDER'S CONSOLE MUST LIST THE EXACT SAME URI. Providers match the
# redirect exactly, which is a security property rather than an inconvenience.
# ---------------------------------------------------------------------------
#
# BOTH OF THESE POINT AT apps/api, WHICH LISTENS ON 3003. They read 3002 until
# now, which is the ADMIN app's port (see ADMIN_URL above). Anyone who copied
# this template got a dashboard whose Content Studio, Creative Studio, Brand
# Brain chat, analytics export and social-account screens proxied to the Control
# Center, which answered 404s the proxy reported as a generic INTERNAL error —
# five broken surfaces and nothing naming the cause.
PUBLIC_API_BASE_URL=http://localhost:3003
PUBLIC_DASHBOARD_BASE_URL=http://localhost:3001
# Where the customer dashboard reaches apps/api server-side. Usually the same
# host as PUBLIC_API_BASE_URL; separate because one is a browser-visible URL and
# the other is an internal one, and in a private network they differ.
BRANDSPACE_API_URL=http://localhost:3003

# ---------------------------------------------------------------------------
# NO PROVIDER CREDENTIAL BELONGS IN THIS FILE.
#
# App ids, client secrets and webhook secrets for Meta, TikTok, LinkedIn and X
# are PLATFORM CONFIGURATION, not environment variables: they live in the
# `integrations.social-apps` configuration domain, their secrets resolve through
# the Secret Service by reference, and they are managed from the Control Center
# with validation, activation, rollback and an audit trail (CLAUDE.md §2.2,
# §2.3).
#
# Putting one here would make it un-rotatable without a deploy, un-auditable,
# and readable by every process that loads this file.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Phase 10 — THE PRODUCTION CONFIGURATION CONTRACT.
#
# WHAT IS VALIDATED, AND WHEN. `validateStartupConfiguration()` runs as the API
# and the worker come up. Outside production it logs what is missing and the
# process continues; in production it THROWS and the process does not start.
# A deployment with half an environment should fail where an operator is
# watching, not where a customer is.
#
# WHAT PRODUCTION ADDITIONALLY REQUIRES, beyond everything above:
#
#   - All three key domains present and DIFFERENT (SECRET_VAULT_KEK,
#     SOCIAL_TOKEN_VAULT_KEK, CUSTOMER_MFA_VAULT_KEK). Sharing one collapses
#     three blast radii into one (D-136, D-206).
#   - No secret containing a template marker — `REPLACE_WITH`, `change-me`,
#     `ci-only`, `example`, `localhost`. A value copied out of this file is not
#     a secret, and finding that out at the first sign-in is finding out too late.
#   - CUSTOMER_SESSION_SECRET and PLATFORM_SESSION_SECRET differing.
#   - DATABASE_PLATFORM_URL being a DIFFERENT ROLE from DATABASE_URL.
#   - BILLING_DEV_WEBHOOK_SECRET ABSENT — it belongs to the development payment
#     adapter, which cannot run in production, so its presence means a
#     production environment was assembled by copying a development one.
#   - https on the public URLs.
#
# WHAT IS *NOT* AN ENVIRONMENT VARIABLE, and never becomes one: AI provider
# keys, social app credentials, the payment provider's keys, the email
# provider's key, object-storage credentials. Every one of those is managed
# from Platform Admin > Integrations, stored in the vault by reference, and
# rotatable without a deploy. An environment variable is none of those things.
#
# NO DEVELOPMENT DOUBLE RUNS IN PRODUCTION. The deterministic AI provider, the
# outbox email provider, the filesystem object store, the development payment
# adapter and the mock social connectors each REFUSE to be constructed or
# registered when APP_ENV=production — so an unconfigured production deployment
# fails closed rather than serving invented content, reporting mail as sent, or
# marking a post published into the void.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=brandspace
# OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE_WITH_COLLECTOR_HOST

# ---------------------------------------------------------------------------
# Seed
#
# The Platform Owner's password. There is NO default: leave this unset and the
# seeded owner is created WITHOUT a password and cannot sign in, which is the
# safe outcome. Set it to a strong, local-only value to enable sign-in.
#
# The seed refuses placeholder-looking values, so replace this line rather than
# uncommenting it as-is. The value is never printed by the seed.
# SEED_PLATFORM_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_ONLY_VALUE
#
# Phase 2B: the same rule for the two seeded CUSTOMER workspace owners. Absent
# means they are created without a password and must be invited.
# SEED_CUSTOMER_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_ONLY_VALUE
