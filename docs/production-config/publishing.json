{
  "providers": {
    "facebook": {
      "enabled": false,
      "postKinds": ["text", "image", "carousel"],
      "maxBodyCharacters": 2200,
      "maxHashtags": 30,
      "maxMediaItems": 10,
      "supportsFirstComment": false,
      "supportsDelete": false,
      "supportsNativeScheduling": false,
      "supportsPostLookup": false,
      "scopes": ["pages_show_list", "pages_read_engagement", "pages_manage_posts"],
      "targetKind": "page",
      "mediaByUrl": true,
      "apiVersion": "v26.0",
      "dailyPublishCap": null,
      "expiringSoonHours": null
    },
    "instagram": {
      "enabled": false,
      "postKinds": ["image", "carousel", "reel"],
      "maxBodyCharacters": 2200,
      "maxHashtags": 30,
      "maxMediaItems": 10,
      "supportsFirstComment": false,
      "supportsDelete": false,
      "supportsNativeScheduling": false,
      "supportsPostLookup": false,
      "scopes": [
        "instagram_basic",
        "instagram_content_publish",
        "pages_show_list",
        "pages_read_engagement"
      ],
      "targetKind": "business_account",
      "mediaByUrl": true,
      "apiVersion": "v26.0",
      "dailyPublishCap": 25,
      "expiringSoonHours": 168
    },
    "tiktok": {
      "enabled": false,
      "postKinds": ["video"],
      "maxBodyCharacters": 2200,
      "maxHashtags": 30,
      "maxMediaItems": 1,
      "supportsFirstComment": false,
      "supportsDelete": false,
      "supportsNativeScheduling": false,
      "supportsPostLookup": false,
      "scopes": ["user.info.basic", "video.publish"],
      "targetKind": "profile",
      "apiVersion": "v2",
      "forcedAudience": "private",
      "rateLimit": {
        "requestsPerWindow": 6,
        "windowSeconds": 60
      },
      "mediaRules": {
        "video": {
          "mimeTypes": ["video/mp4", "video/quicktime", "video/webm"],
          "maxBytes": 4000000000,
          "maxDurationSeconds": 600
        }
      }
    },
    "linkedin": {
      "enabled": false,
      "postKinds": ["text", "image", "carousel", "video", "article"],
      "maxBodyCharacters": 2200,
      "maxHashtags": 30,
      "maxMediaItems": 10,
      "supportsFirstComment": false,
      "supportsDelete": false,
      "supportsNativeScheduling": false,
      "supportsPostLookup": false,
      "scopes": [],
      "targetKind": "profile"
    },
    "x": {
      "enabled": false,
      "postKinds": ["text", "image", "video", "thread"],
      "maxBodyCharacters": 2200,
      "maxHashtags": 30,
      "maxMediaItems": 10,
      "supportsFirstComment": false,
      "supportsDelete": false,
      "supportsNativeScheduling": false,
      "supportsPostLookup": false,
      "scopes": [],
      "targetKind": "profile"
    }
  },
  "oauth": {
    "stateTtlSeconds": 600,
    "maxConnectionsPerWorkspace": 25
  },
  "retry": {
    "maxAttempts": 5,
    "initialBackoffSeconds": 30,
    "backoffMultiplier": 2,
    "maxBackoffSeconds": 1800,
    "jitterRatio": 0.2
  },
  "dispatch": {
    "latenessToleranceMinutes": 120,
    "sweepBatchSize": 50,
    "tokenRefreshAtLifetimeRatio": 0.75,
    "claimLeaseSeconds": 900,
    "staleClaimBatchSize": 50,
    "reconnectRecheckSeconds": 60
  }
}
