{
  "name": "@brandspace/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./server-only-guard": "./src/server-only-guard.ts",
    "./platform": "./src/platform-client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly --declarationDir dist",
    "bootstrap:production-owner": "tsx prisma/bootstrap-production-owner.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@brandspace/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0",
    "@brandspace/auth": "workspace:*",
    "@brandspace/secrets": "workspace:*",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
