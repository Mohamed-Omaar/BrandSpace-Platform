// BrandSpace — identity and tenancy core (Phase 1).
//
// Conventions (docs/DATABASE.md §1):
//   - Every tenant-owned model carries `workspaceId` and is protected by RLS.
//   - Ledger and audit tables are immutable: the application role has no UPDATE/DELETE.
//   - Timestamps are timestamptz (UTC). Money and credits arrive in later phases.
//
// TENANCY MARKER: a model is "tenant-owned" if and only if it has a `workspaceId`
// field. scripts/isolation-gate.ts parses this file and fails CI when a tenant-owned
// model lacks an RLS policy or isolation-test coverage (D-29).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum WorkspaceStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  /// Phase 2B. Retained, read-only, excluded from the working directory. There is
  /// no hard-delete path through any interface (CLAUDE.md §2.5).
  ARCHIVED
  DELETED
}

enum WorkspaceType {
  INDIVIDUAL
  STARTUP
  COMPANY
  CREATOR
  AGENCY
  ENTERPRISE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum RoleRealm {
  WORKSPACE
  PLATFORM
}

enum Locale {
  AR
  EN
}

enum ActorType {
  USER
  PLATFORM_USER
  SYSTEM
  AUTOMATION
  COPILOT
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

enum AuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

// ---------------------------------------------------------------------------
// Phase 2A enums — configuration, secrets, platform sessions
// ---------------------------------------------------------------------------

enum ConfigurationStatus {
  DRAFT
  VALIDATED
  ACTIVE
  SUPERSEDED
  DISCARDED
}

enum DeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum SecretStatus {
  PENDING
  ACTIVE
  ROTATING
  DISABLED
  REVOKED
}

enum SecretVersionStatus {
  PENDING
  ACTIVE
  RETIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// Phase 2B enums — customers, invitations, entitlements, credits
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  /// Set by a sweep; expiry is also enforced by comparing `expiresAt` on read,
  /// so an unswept row is never accepted.
  EXPIRED
  /// A resend supersedes the previous token rather than reusing it.
  SUPERSEDED
}

enum OverrideStatus {
  ACTIVE
  REVOKED
}

enum CreditTransactionType {
  PLAN_GRANT
  PROMOTIONAL_GRANT
  ADMIN_ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  USAGE_CHARGE
  REFUND
  EXPIRY
  RESET
  /// Phase 3. A prepaid credit pack (D-11: top-ups are the only way to add
  /// credits mid-cycle, because there is no postpaid overage).
  ADDON_PURCHASE
  /// Phase 3. The one-off grant that comes with a trial (D-09).
  TRIAL_GRANT
}

// ---------------------------------------------------------------------------
// Phase 3 enums — subscriptions, credit buckets, reservations
// ---------------------------------------------------------------------------

/// The commercial state of a workspace. No payment provider is involved: money
/// movement arrives in Phase 7, and this enum describes only what the platform
/// itself knows.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
  /**
   * PHASE 9 ADDITIONS. Each names a state the lifecycle genuinely reaches and
   * that the customer's own screen has to be able to say out loud (§45).
   */
  /// A checkout was opened and NOTHING authoritative has come back yet.
  ///
  /// THE STATE THAT KEEPS THE PRODUCT HONEST. A browser landing on a success
  /// URL does not leave this state — only a verified provider event does
  /// (§22), so "paid" is never displayed on the strength of a redirect.
  CHECKOUT_PENDING
  /// Payment has failed, the dunning window has elapsed, and paid capability is
  /// withdrawn. DATA IS RETAINED (§40); this is reversible by recovery.
  SUSPENDED
}

enum BillingInterval {
  MONTH
  YEAR
}

/// Where a bucket of credits came from. It decides the default expiry (D-12)
/// and is what the customer's allocation breakdown is grouped by.
enum CreditGrantSource {
  PLAN_GRANT
  TRIAL_GRANT
  PROMOTIONAL_GRANT
  PACK_PURCHASE
  ADMIN_ADJUSTMENT
  ROLLOVER
}

enum CreditReservationStatus {
  OPEN
  SETTLED
  RELEASED
  /// Released by the sweeper because the caller never came back.
  EXPIRED
}

/// Phase 4. The AI request lifecycle — docs/AI-GATEWAY.md §6.1.
///
/// `PENDING → RESERVED → RUNNING → (SUCCEEDED | FAILED | TIMEOUT | CANCELLED |
/// MODERATION_BLOCKED)`. Every terminal status except SUCCEEDED releases the
/// reservation in full: docs/AI-GATEWAY.md §7.4 guarantee 1 is that a failed
/// request costs the customer nothing.
enum AiRequestStatus {
  PENDING
  RESERVED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMEOUT
  MODERATION_BLOCKED
}

/// Phase 4. The uniform provider error taxonomy — docs/AI-GATEWAY.md §3.
///
/// Retryability and fallback eligibility are derived from THIS, never from a
/// provider-specific message string. A provider that renames its errors must
/// not change how the gateway behaves.
enum AiFailureClass {
  AUTH_ERROR
  RATE_LIMITED
  QUOTA_EXCEEDED
  INVALID_REQUEST
  CONTENT_FILTERED
  CONTEXT_TOO_LONG
  MODEL_UNAVAILABLE
  PROVIDER_UNAVAILABLE
  TIMEOUT
  NETWORK_ERROR
  UNKNOWN
}

enum EmailMessageStatus {
  QUEUED
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Identity — NOT tenant-owned. A User is a global identity that may hold
// memberships in several workspaces. Access is constrained by Membership.
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  passwordHash    String?
  name            String?
  locale          Locale     @default(EN)
  /// NO DEFAULT (D-194). A person's zone is a fact about that person, and
  /// `Asia/Riyadh` was a guess about all of them. Whoever creates the row
  /// resolves it.
  timezone        String
  status          UserStatus @default(PENDING)

  // MFA. `mfaSecretRef` is the PLATFORM Secret Service reference, used where a
  // platform actor enrolled the account. A CUSTOMER has no platform actor to
  // enrol them, so their TOTP seed is sealed with the customer MFA key domain
  // and the envelope is kept here (D-206). Only the envelope: the seed itself is
  // never stored, logged or returned, and the two paths never share a key.
  mfaEnabled        Boolean   @default(false)
  mfaSecretRef      String?
  mfaSecretMaterial Json?
  mfaEnrolledAt     DateTime? @db.Timestamptz(6)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)
  lastLoginAt      DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships     Membership[]
  ownedWorkspaces Workspace[]  @relation("WorkspaceOwner")
  /// Prototype v94 Phase 2B-1 (D-328): workspaces this person asked to delete.
  deletionRequests Workspace[] @relation("WorkspaceDeletionRequester")
  invitesSent     Membership[] @relation("MembershipInviter")

  sessions            CustomerSession[]
  passwordResets      PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  invitationsAccepted Invitation[]         @relation("InvitationAcceptor")

  /// Phase 9 — self-service signup, verified identity and customer MFA.
  emailVerifications EmailVerificationToken[]
  legalAcceptances   UserLegalAcceptance[]
  mfaRecoveryCodes   UserMfaRecoveryCode[]

  memberSuggestions MemberSuggestion[]

  @@index([status])
  @@map("user")
}

// A platform staff account. Separate table, separate session realm, separate
// permission set — docs/SECURITY.md §3. A person may hold both a User and a
// PlatformUser account; the two never share a session.
model PlatformUser {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  passwordHash    String?
  name            String?
  status          UserStatus @default(PENDING)

  // D-27: 2FA is mandatory for platform roles. Enforced at login, not optional.
  mfaEnabled    Boolean   @default(false)
  /// Reference into the Secret Service — the TOTP secret is never a column.
  mfaSecretRef  String?
  mfaEnrolledAt DateTime? @db.Timestamptz(6)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)
  lastLoginAt      DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  supportSessions         SupportModeSession[]
  invitationsSent         Invitation[]              @relation("InvitationPlatformInviter")
  overridesGranted        WorkspaceOverride[]
  sessions                PlatformSession[]
  recoveryCodes           PlatformMfaRecoveryCode[]
  configVersionsAuthored  ConfigurationVersion[]    @relation("ConfigAuthor")
  configVersionsActivated ConfigurationVersion[]    @relation("ConfigActivator")
  secretsCreated          SecretRecord[]            @relation("SecretAuthor")
  integrationChecks       IntegrationHealthCheck[]

  @@index([status])
  @@map("platform_user")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// TENANT-OWNED. The isolation boundary itself: RLS restricts a Workspace row to
/// the workspace in the current request context.
model Workspace {
  id            String          @id @default(uuid()) @db.Uuid
  /// Self-referential tenant key so every tenant-owned table — including this one —
  /// is filtered by the same predicate. Always equal to `id`; enforced by a CHECK.
  workspaceId   String          @unique @db.Uuid
  slug          String          @unique
  name          String
  legalName     String?
  type          WorkspaceType   @default(STARTUP)
  status        WorkspaceStatus @default(TRIALING)
  /// NO PRODUCT-WIDE DEFAULT (D-194). These four decided that every customer was
  /// Saudi unless somebody remembered otherwise, which is not a default, it is an
  /// assumption. They are dropped rather than replaced: US/USD/New York would be
  /// the same mistake facing the other way. A creation path must resolve them,
  /// and `CreateWorkspaceInput` makes that a compile error rather than a silent
  /// fallback. Existing rows keep exactly what they hold.
  country       String
  defaultLocale Locale
  timezone      String
  currency      String          @db.Char(3)

  ownerUserId String @db.Uuid
  owner       User   @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  trialEndsAt     DateTime? @db.Timestamptz(6)
  suspendedAt     DateTime? @db.Timestamptz(6)
  suspendedReason String?

  // --- Phase 2B: lifecycle provenance -------------------------------------
  // Who changed the status, when, and why. Shown in the Control Center so a
  // suspension is never an unexplained state (docs/ADMIN-CONTROL-CENTER.md §3.3).
  statusReason                  String?
  statusChangedAt               DateTime? @db.Timestamptz(6)
  statusChangedByPlatformUserId String?   @db.Uuid
  archivedAt                    DateTime? @db.Timestamptz(6)

  // --- Phase 2B: plan assignment ------------------------------------------
  // The plan KEY, resolved against the active `plans` configuration version.
  // Prices and allowances are configuration, never columns (CLAUDE.md §2.2).
  // Superseded by `Subscription` when billing arrives (Phase 3/8) — see D-40.
  planKey                      String?
  planAssignedAt               DateTime? @db.Timestamptz(6)
  planAssignedByPlatformUserId String?   @db.Uuid

  /// Optimistic concurrency for platform edits. Travels in the WHERE of a
  /// conditional UPDATE, so a lost update is refused rather than silent.
  lockVersion Int @default(0)

  /// Advanced by customer sessions. Null means "never signed in" — displayed as
  /// such rather than invented (docs/ADMIN-CONTROL-CENTER.md §3.2).
  lastActivityAt DateTime? @db.Timestamptz(6)

  // --- Phase 5B-2: AI generation policy the CUSTOMER controls ---------------

  /// D-115. The Arabic dialect this workspace writes in, as a configured KEY
  /// rather than an enum: the supported list and the default both live in the
  /// activated `content` configuration domain, so adding a dialect is an
  /// operator change and not a migration (CLAUDE.md §2.2).
  ///
  /// NULL means "not configured", which resolves to the activated default —
  /// shipped as `msa`. It does NOT mean Saudi, and nothing here may make it so.
  arabicDialect String?

  /// D-117 / F-73. How long persisted AI output is kept, in days.
  ///
  /// NULL is the D-116 default: retained while the subscription is active, then
  /// a grace window after cancellation. A positive value is the CUSTOMER asking
  /// for something shorter, and the service — never the screen — applies it.
  ///
  /// It reaches content only. Audit events, the credit ledger and billing
  /// records have their own retention and are out of this column's reach.
  aiContentRetentionDays Int?

  // --- Prototype v94 Phase 2B-1: the owner's deletion request (A8, D-328) ---
  /// The owner asked for this workspace to be deleted. Both columns are set
  /// together or not at all (CHECK `workspace_deletion_request_coherent`).
  /// While `deletionScheduledFor` is set the workspace is PENDING DELETION:
  /// its data is closed to every member, nothing publishes, no credit is
  /// spent, and an owner may cancel; at the deadline a job marks it DELETED.
  deletionRequestedAt       DateTime? @db.Timestamptz(6)
  deletionScheduledFor      DateTime? @db.Timestamptz(6)
  deletionRequestedByUserId String?   @db.Uuid
  deletionRequestedBy       User?     @relation("WorkspaceDeletionRequester", fields: [deletionRequestedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships              Membership[]
  roles                    Role[]
  auditEvents              AuditEvent[]
  supportSessions          SupportModeSession[]
  invitations              Invitation[]
  overrides                WorkspaceOverride[]
  creditWallet             CreditWallet?
  creditLedger             CreditTransaction[]
  // --- Phase 3 -------------------------------------------------------------
  subscription             WorkspaceSubscription?
  creditGrants             CreditGrant[]
  creditReservations       CreditReservation[]
  usageCounters            UsageCounter[]
  usageEvents              UsageEvent[]
  betaCohorts              BetaCohortMembership[]
  emailMessages            EmailMessage[]
  // --- Phase 4 -------------------------------------------------------------
  aiRequests               AiRequest[]
  aiUsageLedger            AiUsageLedger[]
  // --- Phase 5 -------------------------------------------------------------
  brands                   Brand[]
  brandKnowledgeItems      BrandKnowledgeItem[]
  brandKnowledgeVersions   BrandKnowledgeVersion[]
  brandSourceDocuments     BrandSourceDocument[]
  brandSourceChunks        BrandSourceChunk[]
  brandKnowledgeCandidates BrandKnowledgeCandidate[]
  brandIngestionJobs       BrandIngestionJob[]
  brandBrainConversations  BrandBrainConversation[]
  brandBrainMessages       BrandBrainMessage[]

  /// Phase 5B-1 — Asset Library.
  assetFolders        AssetFolder[]
  assets              Asset[]
  assetVersions       AssetVersion[]
  assetDerivatives    AssetDerivative[]
  assetUploadSessions AssetUploadSession[]
  assetProcessingJobs AssetProcessingJob[]

  /// Phase 5B-2 — AI Content Studio.
  contentItems    ContentItem[]
  contentVariants ContentVariant[]
  calendarSlots   CalendarSlot[]

  /// Phase 5B-3 — Approvals.
  approvals        Approval[]
  approvalPolicies ApprovalPolicy[]

  /// Phase 5B-3 — Notifications. Workspace-owned only: a notification is
  /// addressed to a member OF this workspace, never to a user globally.
  notifications Notification[]

  /// Phase 6 — Social Publishing.
  socialConnections SocialConnection[]
  socialCredentials SocialCredential[]
  socialOAuthStates SocialOAuthState[]
  publishJobs       PublishJob[]
  publishAttempts   PublishAttempt[]

  /// Phase 7 — Analytics, Intelligence, Copilot and Automations.
  metricObservations        MetricObservation[]
  analyticsIngestionCursors AnalyticsIngestionCursor[]
  analyticsIngestionRuns    AnalyticsIngestionRun[]
  campaigns                 Campaign[]
  insights                  Insight[]
  insightEvidence           InsightEvidence[]
  copilotSessions           CopilotSession[]
  copilotMessages           CopilotMessage[]
  copilotActionPlans        CopilotActionPlan[]
  copilotToolCalls          CopilotToolCall[]
  automationRules           AutomationRule[]
  automationRuns            AutomationRun[]
  automationEvents          AutomationEvent[]

  /// Phase 9 — Commerce.
  billingProfile      BillingProfile?
  checkoutSessions    CheckoutSession[]
  invoices            Invoice[]
  invoiceLines        InvoiceLine[]
  creditNotes         CreditNote[]
  creditNoteLines     CreditNoteLine[]
  paymentAttempts     PaymentAttempt[]
  creditPackPurchases CreditPackPurchase[]
  noteThreads         NoteThread[]
  notes               Note[]
  noteMentions        NoteMention[]

  memberSuggestions MemberSuggestion[]

  @@index([status])
  @@index([ownerUserId])
  @@index([deletionScheduledFor])
  @@index([planKey])
  @@map("workspace")
}

/// TENANT-OWNED. Links a User to a Workspace with a role and optional brand scope.
model Membership {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  /// null = all brands in the workspace; a non-empty array restricts the member.
  brandScope String[] @db.Uuid

  status MembershipStatus @default(INVITED)

  invitedByUserId     String?   @db.Uuid
  /// Only the hash is stored — the raw invitation token exists solely in the emailed link.
  invitationTokenHash String?   @unique
  invitationExpiresAt DateTime? @db.Timestamptz(6)
  acceptedAt          DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy User?     @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@index([roleId])
  @@map("membership")
}

/// TENANT-OWNED (nullable tenant key).
/// `workspaceId = null` denotes a system role that every workspace may resolve.
/// A non-null value denotes a workspace-defined custom role.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String?   @db.Uuid
  key         String
  realm       RoleRealm @default(WORKSPACE)
  nameEn      String
  nameAr      String
  description String?
  isSystem    Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace     Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  memberships   Membership[]
  platformUsers PlatformUser[]
  invitations   Invitation[]

  @@unique([workspaceId, key])
  @@index([realm])
  @@map("role")
}

// Global permission catalogue. Not tenant-owned — the same permission keys exist
// for every tenant, and the catalogue leaks no customer data.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  resource    String
  action      String
  minScope    String
  description String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@index([resource])
  @@map("permission")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ---------------------------------------------------------------------------
// Audit — immutable
// ---------------------------------------------------------------------------

/// TENANT-OWNED (nullable tenant key).
/// `workspaceId = null` denotes a platform-only event. Because RLS compares with
/// `=`, a NULL never matches a workspace context, so platform events are invisible
/// to tenants without needing a special-case policy.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @db.Uuid
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)

  actorType      ActorType
  actorId        String?   @db.Uuid
  actorEmailHash String?

  action       String
  resourceType String?
  resourceId   String? @db.Uuid
  brandId      String? @db.Uuid

  severity AuditSeverity @default(INFO)
  outcome  AuditOutcome  @default(SUCCESS)
  reason   String?

  /// Redacted before write — never contains secrets or tokens.
  before Json?
  after  Json?

  ip        String?
  userAgent String?
  requestId String?
  traceId   String?

  /// Set when the action occurred inside a support-mode session (D-28).
  supportModeSessionId String? @db.Uuid

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_event")
}

/// TENANT-OWNED. A time-boxed, reason-tagged, read-only-by-default platform access
/// grant over one workspace — D-28. True impersonation is prohibited.
model SupportModeSession {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  platformUserId String  @db.Uuid
  reason         String
  ticketRef      String?

  /// Read-only unless a separate elevated grant was issued and justified.
  writeEnabled Boolean @default(false)

  grantedAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  endedAt   DateTime? @db.Timestamptz(6)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, grantedAt(sort: Desc)])
  @@index([platformUserId, grantedAt(sort: Desc)])
  @@index([expiresAt])
  /// A-10. At most ONE live session per (workspace, operator), enforced by a
  /// PARTIAL unique index created in migration
  /// 20260908100000_support_mode_single_active. Prisma cannot express a
  /// `WHERE "endedAt" IS NULL` index, so it lives in the migration and is
  /// recorded here so nobody concludes the guarantee is only in code.
  @@map("support_mode_session")
}

// ===========================================================================
// PLATFORM-OWNED MODELS (Phase 2A)
//
// These carry NO workspaceId and are NOT tenant-owned. They are reachable only
// through the platform database identity: RLS grants them to brandspace_platform
// alone, and all privileges are REVOKED from brandspace_app, so the tenant role
// cannot read them even if a policy were mistakenly added later.
//
// scripts/isolation-gate.ts verifies both properties for every model listed in
// PLATFORM_OWNED_MODELS (packages/database/src/tenant-models.ts).
// ===========================================================================

/// PLATFORM-OWNED. One immutable version of one configuration domain.
model ConfigurationVersion {
  id            String                @id @default(uuid()) @db.Uuid
  domain        String
  environment   DeploymentEnvironment
  versionNumber Int
  schemaVersion Int                   @default(1)

  /// The configuration document. Never contains a secret value — secret-bearing
  /// fields hold a `secretRef` resolved server-side by the Secret Service.
  payload         Json
  payloadChecksum String

  status ConfigurationStatus @default(DRAFT)

  previousVersionId   String? @db.Uuid
  rollbackOfVersionId String? @db.Uuid

  validationReport Json?
  impactPreview    Json?

  createdByPlatformUserId   String  @db.Uuid
  activatedByPlatformUserId String? @db.Uuid
  changeReason              String

  /// Optimistic concurrency: an update must present the lockVersion it read, so
  /// two administrators editing the same draft cannot silently overwrite one
  /// another. The loser gets a conflict, not a lost edit.
  lockVersion Int @default(0)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  activatedAt   DateTime? @db.Timestamptz(6)
  deactivatedAt DateTime? @db.Timestamptz(6)

  createdBy   PlatformUser  @relation("ConfigAuthor", fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)
  activatedBy PlatformUser? @relation("ConfigActivator", fields: [activatedByPlatformUserId], references: [id], onDelete: SetNull)

  @@unique([domain, environment, versionNumber])
  @@index([domain, environment, status])
  @@index([activatedAt(sort: Desc)])
  @@map("configuration_version")
}

/// PLATFORM-OWNED. The logical secret. Holds NO ciphertext — material lives in
/// SecretVersion so rotation can keep two versions valid at once.
model SecretRecord {
  id          String                @id @default(uuid()) @db.Uuid
  /// Stable reference used by configuration, e.g. "ai/openai/production/api-key".
  ref         String
  environment DeploymentEnvironment
  category    String
  name        String
  description String?

  status SecretStatus @default(PENDING)

  createdByPlatformUserId String    @db.Uuid
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  lastRotatedAt           DateTime? @db.Timestamptz(6)
  lastUsedAt              DateTime? @db.Timestamptz(6)
  disabledAt              DateTime? @db.Timestamptz(6)
  revokedAt               DateTime? @db.Timestamptz(6)
  expiresAt               DateTime? @db.Timestamptz(6)

  createdBy PlatformUser    @relation("SecretAuthor", fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)
  versions  SecretVersion[]

  @@unique([ref, environment])
  @@index([environment, status])
  @@index([category])
  /// F-53. The Control Center's paginated listing orders by
  /// `[category, name, id]` inside one environment. Without this the database
  /// sorts the whole matching set to return one page, which is the cost
  /// pagination exists to avoid. `id` is included so the index covers the total
  /// order the query actually asks for.
  @@index([environment, category, name, id])
  @@map("secret_record")
}

/// PLATFORM-OWNED. One encrypted version of a secret.
///
/// Envelope encryption: `wrappedDataKey` is a data key encrypted by the KEK
/// (KMS or the local development provider); `ciphertext` is the secret value
/// encrypted by that data key with AES-256-GCM. The plaintext value is never
/// stored, never logged, and never returned by any API.
model SecretVersion {
  id             String @id @default(uuid()) @db.Uuid
  secretRecordId String @db.Uuid
  version        Int

  /// AEAD ciphertext, IV and auth tag. Base64, so a dump is never a usable key.
  ciphertext        String
  iv                String
  authTag           String
  /// The data key, itself encrypted by the key-encryption key.
  wrappedDataKey    String
  /// Which KEK wrapped the data key, so rotation of the KEK is traceable.
  keyProvider       String
  keyId             String
  algorithm         String @default("AES-256-GCM")
  /// Bound into the AEAD additional data, so ciphertext cannot be replayed into
  /// another ref, environment or version.
  encryptionContext String

  /// Audit-safe metadata. The ONLY things ever shown in the UI or an API.
  maskedHint  String
  fingerprint String

  status SecretVersionStatus @default(PENDING)

  createdByPlatformUserId String    @db.Uuid
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  activatedAt             DateTime? @db.Timestamptz(6)
  retiredAt               DateTime? @db.Timestamptz(6)

  secretRecord SecretRecord @relation(fields: [secretRecordId], references: [id], onDelete: Cascade)

  @@unique([secretRecordId, version])
  @@index([secretRecordId, status])
  @@map("secret_version")
}

/// PLATFORM-OWNED. A Platform Admin session. Separate table from any customer
/// session by design — the two realms never share storage (docs/SECURITY.md §3).
model PlatformSession {
  id             String @id @default(uuid()) @db.Uuid
  platformUserId String @db.Uuid

  /// Only the hash is stored; the raw token exists solely in the cookie.
  tokenHash String @unique

  /// D-27: platform roles require MFA. A session is unusable until this is set.
  mfaVerifiedAt    DateTime? @db.Timestamptz(6)
  /// Step-up re-authentication for high-impact operations.
  stepUpVerifiedAt DateTime? @db.Timestamptz(6)

  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  revokedReason     String?

  ip        String?
  userAgent String?

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, revokedAt])
  @@index([expiresAt])
  @@map("platform_session")
}

/// PLATFORM-OWNED. Single-use MFA recovery codes. Hashed, never recoverable.
model PlatformMfaRecoveryCode {
  id             String @id @default(uuid()) @db.Uuid
  platformUserId String @db.Uuid
  codeHash       String @unique

  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, usedAt])
  @@map("platform_mfa_recovery_code")
}

// ===========================================================================
// PHASE 2B — customers, workspaces, customer authentication, invitations,
// entitlement overrides and the credit ledger.
//
// Classification rules (packages/database/src/tenant-models.ts):
//   - carries `workspaceId`            -> tenant-owned, RLS + isolation test
//   - identity, no `workspaceId`       -> RLS policy still required, because a
//                                         session row names a person
// ===========================================================================

/// IDENTITY. A customer session. Deliberately NOT tenant-owned: a User is a
/// global identity who may hold memberships in several workspaces, and the
/// workspace is chosen AFTER authentication. The realm separation from
/// `PlatformSession` is physical — a different table, cookie, audience and
/// signing key (docs/SECURITY.md §3).
model CustomerSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// Only the SHA-256 hash is stored; the raw token exists solely in the cookie.
  tokenHash String @unique

  /// The workspace this session is currently scoped to. Null until the member
  /// picks one. Switching writes a NEW value here after re-verifying membership
  /// server-side — a client claim never selects a workspace.
  activeWorkspaceId String? @db.Uuid

  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  revokedReason     String?

  /// Phase 9. Null on an MFA-enrolled account means the session has presented a
  /// password and nothing else, and it resolves to NOTHING until the second
  /// factor is verified. Accounts without MFA ignore this column entirely.
  mfaVerifiedAt DateTime? @db.Timestamptz(6)

  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([activeWorkspaceId])
  @@map("customer_session")
}

/// IDENTITY. Single-use, expiring password-reset tokens, stored hashed.
/// Not tenant-owned: a reset happens before any workspace is chosen.
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique

  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  ip String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/// TENANT-OWNED. A workspace invitation.
///
/// Modelled separately from `Membership` (docs/DATABASE.md §10) because an
/// invitee may have no `User` row at all, and `Membership.userId` is required.
/// The token is stored ONLY as a SHA-256 hash; the raw value exists solely in
/// the emailed link. Acceptance is a single conditional UPDATE, so two
/// concurrent acceptances cannot both win.
model Invitation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  /// Lower-cased at write time so a case variant cannot accept someone else's
  /// invitation. Compared against the authenticated user's email.
  email  String
  roleId String @db.Uuid

  /// null = all brands; a non-empty array restricts the future member.
  brandScope String[] @db.Uuid

  tokenHash String           @unique
  status    InvitationStatus @default(PENDING)

  expiresAt     DateTime  @db.Timestamptz(6)
  acceptedAt    DateTime? @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  revokedReason String?

  /// Exactly one inviter is set: a workspace member, or a platform actor acting
  /// through the Control Center. Never both.
  invitedByUserId         String? @db.Uuid
  invitedByPlatformUserId String? @db.Uuid

  acceptedByUserId String? @db.Uuid

  /// A resend creates a new row and points the old one here, so the audit trail
  /// shows the chain rather than a mutated token.
  supersededByInvitationId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role              Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedByUser     User?         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedByPlatform PlatformUser? @relation("InvitationPlatformInviter", fields: [invitedByPlatformUserId], references: [id], onDelete: SetNull)
  acceptedByUser    User?         @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, email])
  @@index([expiresAt])
  @@map("invitation")
}

/// TENANT-OWNED. An owner-granted, per-customer deviation from the plan.
/// docs/DATABASE.md §8.4. Precedence level 2 — it beats plan entitlement but
/// NEVER beats the kill switch (docs/ADMIN-CONTROL-CENTER.md §5.3).
model WorkspaceOverride {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  /// Feature key from the active `entitlements` configuration version.
  featureKey String

  enabled    Boolean
  /// null = unlimited for a quota feature; ignored for a boolean feature.
  limitValue Int?
  /// A-4. The chosen option for an `enum` feature; null for every other type.
  /// Separate from `limitValue` because a quota answers "how many" and an enum
  /// answers "which one" — collapsing them left enum features unresolvable.
  enumValue  String?

  reason String

  grantedByPlatformUserId String @db.Uuid

  effectiveFrom  DateTime       @default(now()) @db.Timestamptz(6)
  effectiveUntil DateTime?      @db.Timestamptz(6)
  status         OverrideStatus @default(ACTIVE)

  revokedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedBy PlatformUser @relation(fields: [grantedByPlatformUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, featureKey])
  @@index([effectiveUntil])
  @@map("workspace_override")
}

/// TENANT-OWNED. One wallet per workspace.
///
/// `balanceMilliCredits` is a materialised projection of the ledger, updated
/// only inside the same transaction as its `CreditTransaction` row and
/// reconcilable by replay. Milli-credits internally, whole credits displayed
/// (D-14). A CHECK constraint refuses a negative balance.
model CreditWallet {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid

  balanceMilliCredits          BigInt @default(0)
  reservedMilliCredits         BigInt @default(0)
  lifetimeGrantedMilliCredits  BigInt @default(0)
  lifetimeConsumedMilliCredits BigInt @default(0)

  /// Phase 3 (docs/DATABASE.md §7.1). The cycle boundary that drives the
  /// monthly grant and the rollover sweep, and the low-balance notice state.
  /// `nextResetAt` is the subscription's period end, not a calendar month: a
  /// customer who starts on the 20th resets on the 20th.
  lastResetAt               DateTime? @db.Timestamptz(6)
  nextResetAt               DateTime? @db.Timestamptz(6)
  lowBalanceNotifiedAt      DateTime? @db.Timestamptz(6)
  /// The threshold percentage most recently notified, so a wallet that crosses
  /// 20% and later 5% produces two notices rather than one or a stream.
  lowBalanceNotifiedPercent Int?

  /// Optimistic-lock counter, in addition to the row lock taken on every write.
  version Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  grants       CreditGrant[]
  reservations CreditReservation[]

  /// D-112: gives this table's workspace-scoped foreign keys something to
  /// reference. `id` is already the primary key, so this constrains nothing new.
  @@unique([workspaceId, id], name: "credit_wallet_workspace_scope")
  @@map("credit_wallet")
}

/// TENANT-OWNED and IMMUTABLE. The credit ledger.
/// `idempotencyKey` is unique, so a retry can never double-adjust a balance.
model CreditTransaction {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  walletId    String @db.Uuid

  type                     CreditTransactionType
  /// Signed. Negative for charges and expiries.
  amountMilliCredits       BigInt
  /// The wallet balance immediately after this row committed.
  balanceAfterMilliCredits BigInt

  reason String

  /// Unique. A retry with the same key returns the original row.
  idempotencyKey String @unique

  actorType ActorType
  actorId   String?   @db.Uuid

  /// Phase 3 (docs/DATABASE.md §7.2). On a GRANT row this is when the bucket
  /// expires; on a CHARGE row `sourceGrantId` names the bucket it drew from, so
  /// FIFO-by-expiry consumption is reconstructible from the ledger alone.
  expiresAt     DateTime? @db.Timestamptz(6)
  sourceGrantId String?   @db.Uuid
  reservationId String?   @db.Uuid

  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    CreditWallet @relation(fields: [workspaceId, walletId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "credit_transaction_wallet_fkey")

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([walletId, type])
  @@index([workspaceId, expiresAt])
  @@index([reservationId])
  @@map("credit_transaction")
}

/// TENANT-OWNED (nullable tenant key). The email outbox.
///
/// There is no external email vendor: sending is an interface, and the default
/// implementation writes here (D-41). `workspaceId` is null for messages that
/// precede any workspace, such as a password reset.
///
/// The body carries no token: a reset or invitation link is composed from the
/// raw token, which is never persisted. Only the destination and the template
/// key are stored.
model EmailMessage {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String? @db.Uuid

  toEmail     String
  templateKey String
  locale      Locale @default(EN)

  /// Template variables, redacted before write. Never contains a raw token.
  variables Json?

  status     EmailMessageStatus @default(QUEUED)
  sentAt     DateTime?          @db.Timestamptz(6)
  failedAt   DateTime?          @db.Timestamptz(6)
  failReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([toEmail, createdAt(sort: Desc)])
  @@index([status])
  @@map("email_message")
}

/// GLOBAL CATALOGUE. A tenant-readable projection of the three configuration
/// domains a customer's own entitlements depend on.
///
/// WHY THIS EXISTS. Effective features resolve from the ACTIVE `entitlements`,
/// `plans` and `feature-flags` configuration versions — but
/// `configuration_version` is PLATFORM-owned, with every privilege revoked from
/// the tenant role, and it also holds `integrations.*` and `operations` payloads
/// that are none of a customer's business. Rather than weaken that table's
/// protection, the Configuration Service PROJECTS the three customer-relevant
/// payloads here when it activates one, and the customer application reads only
/// this.
///
/// It carries no `workspaceId` and no secrets: feature keys, plan keys, limits
/// and flag rules, identical for every tenant — the same shape as `permission`.
model EntitlementCatalogueSnapshot {
  /// One of: entitlements, plans, feature-flags, credits, brand-brain.
  ///
  /// Constrained by a CHECK in the migration, not by convention: a future
  /// caller cannot project an operational or integration payload where a
  /// customer can read it.
  domain      String
  environment DeploymentEnvironment

  /// The ACTIVE payload, copied verbatim at activation.
  payload Json

  /// Which configuration version this came from, for traceability.
  sourceVersionId String   @db.Uuid
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@id([domain, environment])
  @@map("entitlement_catalogue_snapshot")
}

// ---------------------------------------------------------------------------
// Phase 3 — subscriptions, credit buckets, reservations, usage, beta cohorts
// ---------------------------------------------------------------------------

/// TENANT-OWNED. The commercial state of one workspace.
///
/// WHAT THIS IS NOT. It is not the billing `Subscription` of docs/DATABASE.md
/// §8.5: there are no provider references, no invoice linkage and no payment
/// state, because payment collection is Phase 7 and this phase must not pretend
/// otherwise. Phase 7 extends this record rather than replacing it.
///
/// WHY IT EXISTS NOW. Three Phase 3 requirements need it and cannot be met from
/// `Workspace.planKey` alone:
///
///   * AC-04.7 — changing a plan's price must NOT reprice existing customers.
///     The agreed price is therefore COPIED here at assignment time, together
///     with the configuration version it came from. Later plan edits change the
///     catalogue, never this row.
///   * AC-04.11 — a workspace cannot start a second trial. `trialStartedAt`
///     survives the trial ending, the plan changing and the subscription being
///     cancelled, so "has this workspace ever had a trial?" stays answerable.
///   * Credit cycles — the monthly grant and the rollover sweep run on the
///     subscription's own period boundary, not the calendar month.
///
/// One row per workspace, evolving in place, so the trial history cannot be
/// erased by starting again.
model WorkspaceSubscription {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid

  planKey String
  status  SubscriptionStatus @default(TRIALING)

  billingInterval BillingInterval @default(MONTH)

  /// THE PINNED PRICE (AC-04.7). Copied from the plan configuration when the
  /// plan was assigned, in minor units of `currency`. Never recomputed.
  currency             String  @db.Char(3)
  pinnedMonthlyMinor   Int
  pinnedAnnualMinor    Int
  /// Which `plans` configuration version the price above was copied from.
  pinnedFromVersionId  String? @db.Uuid
  /// The allowance in force for this subscription, likewise pinned.
  pinnedMonthlyCredits Int     @default(0)

  currentPeriodStart DateTime @db.Timestamptz(6)
  currentPeriodEnd   DateTime @db.Timestamptz(6)

  /// Set once, ever. A second trial is refused by checking this is null.
  trialStartedAt DateTime? @db.Timestamptz(6)
  trialEndsAt    DateTime? @db.Timestamptz(6)

  /// A downgrade takes effect at period end (D-12), so the chosen plan waits
  /// here rather than being applied and reverted.
  pendingPlanKey         String?
  pendingPlanEffectiveAt DateTime? @db.Timestamptz(6)

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime? @db.Timestamptz(6)

  // --- Phase 9: the provider reference and the dunning clock ----------------

  /// The adapter serving this subscription, and the provider's own id for it.
  /// REFERENCES, never authority: entitlements resolve from the row above, so a
  /// provider outage cannot remove a paying customer's access
  /// (docs/BILLING-AND-CREDITS.md §1.1).
  providerKey            String?
  providerSubscriptionId String?

  /// The checkout that is currently trying to pay for this subscription.
  pendingCheckoutSessionId String? @db.Uuid

  /// When collection first failed. The dunning schedule is measured from here,
  /// so a later failure in the same episode does not restart the clock.
  pastDueSince      DateTime? @db.Timestamptz(6)
  /// When full access stops if nothing is collected. From `commerce.dunning`.
  graceEndsAt       DateTime? @db.Timestamptz(6)
  suspendedAt       DateTime? @db.Timestamptz(6)
  /// Set when the customer asks, cleared if they resume before it takes effect.
  cancelRequestedAt DateTime? @db.Timestamptz(6)

  /// The provider event that last moved this row, and when the provider says it
  /// happened. AN OUT-OF-ORDER DELIVERY IS RECOGNISED BY COMPARING AGAINST
  /// THIS: an event older than the state it describes is recorded and NOT
  /// applied (§28), rather than winding a subscription backwards.
  lastEventAt        DateTime? @db.Timestamptz(6)
  lastBillingEventId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The reverse lookup a webhook uses for a subscription-scoped event, for the
  /// same reason `billing_profile` carries one: the mapping must be ours.
  @@unique([providerKey, providerSubscriptionId])
  @@index([status, currentPeriodEnd])
  @@index([status, graceEndsAt])
  @@index([planKey])
  @@map("workspace_subscription")
}

/// TENANT-OWNED. One bucket of credits, consumed FIFO by nearest expiry (D-12).
///
/// A PROJECTION, exactly like `credit_wallet.balanceMilliCredits`. The ledger
/// remains the source of truth: the GRANT row that created this bucket carries
/// `expiresAt`, and every CHARGE row carries `sourceGrantId`, so
/// `remainingMilliCredits` is reconstructible by replay — which is what
/// `CreditService.reconcile()` actually does. The column exists so choosing the
/// next bucket is a short indexed read rather than an aggregate over the whole
/// ledger.
///
/// Updated only inside the same transaction as its ledger row, under the same
/// wallet row lock.
model CreditGrant {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  walletId    String @db.Uuid

  source CreditGrantSource

  /// Granted, spent and held. The three are kept apart deliberately:
  ///
  ///   remaining = amount - (charges settled against this bucket)   <- replay
  ///   reserved  = estimates currently held against this bucket
  ///   spendable = remaining - reserved
  ///
  /// `remaining` therefore still equals what a ledger replay computes, which is
  /// what `reconcile()` asserts. Holding a reservation moves `reserved` only,
  /// so an open reservation cannot make the bucket disagree with the ledger —
  /// and two concurrent reservations cannot both allocate the same credits,
  /// which they could if a reservation left no per-bucket trace at all.
  amountMilliCredits    BigInt
  remainingMilliCredits BigInt
  reservedMilliCredits  BigInt @default(0)

  /// null = never expires. D-12 sets 12 months for packs, 3 for promotional.
  expiresAt DateTime? @db.Timestamptz(6)

  /// The ledger row that created this bucket. Unique, so a retried grant cannot
  /// produce a second bucket from the same transaction.
  sourceTransactionId String @unique @db.Uuid

  reason    String
  grantedAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    CreditWallet @relation(fields: [workspaceId, walletId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "credit_grant_wallet_fkey")

  /// The consumption order: soonest expiry first, then oldest grant. NULLS LAST
  /// is applied in the query so never-expiring buckets are spent last.
  @@index([workspaceId, expiresAt, grantedAt])
  @@index([walletId, remainingMilliCredits])
  @@map("credit_grant")
}

/// TENANT-OWNED. One `reserve → confirm → settle` in flight.
///
/// The ledger records every movement; this row holds the STATE that makes the
/// protocol safe:
///
///   * `idempotencyKey` is unique, so a retried reserve returns the existing
///     reservation instead of holding the estimate twice (CLAUDE.md §2.4).
///   * `status` makes settle-twice and release-after-settle impossible.
///   * `allocations` records which buckets the estimate was taken from, so
///     settlement charges and releases the SAME buckets FIFO chose at reserve
///     time rather than re-deciding against a wallet that has since moved.
///   * `expiresAt` is what the sweeper uses. An abandoned reservation must be
///     released, and the leak count must stay at zero.
model CreditReservation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  walletId    String @db.Uuid

  /// Unique. A retry with the same key returns the original reservation.
  idempotencyKey String @unique

  /// What the caller asked to hold. Settlement may be less, never more.
  estimateMilliCredits BigInt
  /// Set at settlement. Null while open.
  settledMilliCredits  BigInt?

  status CreditReservationStatus @default(OPEN)

  /// `[{ grantId, milliCredits }]` — the FIFO decision, frozen at reserve time.
  allocations Json

  /// What the reservation is for. A task key, never request content.
  purpose String

  expiresAt     DateTime  @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  settledAt     DateTime? @db.Timestamptz(6)
  releasedAt    DateTime? @db.Timestamptz(6)
  /// Why it was released: caller cancelled, request failed, or swept.
  releaseReason String?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    CreditWallet @relation(fields: [workspaceId, walletId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "credit_reservation_wallet_fkey")

  @@index([workspaceId, status])
  /// The sweeper's query: everything still OPEN past its deadline.
  @@index([status, expiresAt])
  @@map("credit_reservation")
}

/// TENANT-OWNED. Consumption of one quota feature in one window.
///
/// `usedValue` is incremented by a single `INSERT … ON CONFLICT DO UPDATE`
/// carrying the limit in its WHERE clause, so the check and the increment are
/// one atomic statement. Two concurrent requests at the limit cannot both
/// succeed, and no row lock is held across application code.
model UsageCounter {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  featureKey  String
  /// Window bounds. `total` limits use a fixed epoch start so there is one row.
  periodStart DateTime @db.Timestamptz(6)
  periodEnd   DateTime @db.Timestamptz(6)

  usedValue Int @default(0)
  /// EXACT bytes, for a quota measured in storage (B-1). Only the
  /// `limit.storage_gb` counter moves it; every other counter leaves it at 0.
  /// On that counter `usedValue` is DERIVED from it — the gigabytes the total
  /// occupies, rounded up once — rather than a sum of per-file roundings.
  /// BIGINT because a workspace holds more than the 2 GiB an Int can count.
  usedBytes BigInt @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureKey, periodStart])
  @@index([workspaceId, featureKey, periodEnd])
  @@map("usage_counter")
}

/// TENANT-OWNED. The idempotency record for one usage recording.
///
/// Inserted in the SAME transaction as the counter increment. A retry violates
/// the unique key, the transaction rolls back, and the counter is untouched —
/// so recording usage twice for one logical action is impossible rather than
/// unlikely.
///
/// It carries a feature key and an amount. It never carries request content.
model UsageEvent {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  featureKey     String
  idempotencyKey String @unique
  amount         Int
  /// SIGNED bytes a storage movement moved (B-1); null for every unit quota.
  /// A byte movement records `amount` 0 — it is not a whole unit of anything.
  bytes          BigInt?

  counterId  String   @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, featureKey, occurredAt(sort: Desc)])
  @@map("usage_event")
}

/// TENANT-OWNED. One workspace's membership of one named beta cohort.
///
/// The cohort DEFINITIONS are configuration (`beta-cohorts`); membership is a
/// database row because it is per-customer state with an author, a reason and a
/// date — the same reasoning as `WorkspaceOverride`. Until this model existed
/// the precedence engine's beta-group dimension read a hard-coded empty set.
model BetaCohortMembership {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  cohortKey String

  addedByPlatformUserId String   @db.Uuid
  reason                String
  addedAt               DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, cohortKey])
  @@index([cohortKey])
  @@map("beta_cohort_membership")
}

/// TENANT-OWNED. One logical AI action — docs/DATABASE.md §6.5.
///
/// NO RAW PROMPT OR RESPONSE IS STORED HERE. `inputSummary` holds audit-safe
/// metadata only: token and asset counts, language, the prompt template
/// version, Brand Brain citation ids. docs/AI-GATEWAY.md §11 makes that the
/// default, and the column comment is not the enforcement — a unit test asserts
/// that the gateway never writes prompt text into it.
model AiRequest {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  /// Null for a platform- or system-initiated request.
  userId      String? @db.Uuid

  taskKey        String
  /// Unique. A retry with the same key returns the ORIGINAL result and never
  /// touches the wallet (docs/AI-GATEWAY.md §7.4 guarantee 2).
  idempotencyKey String @unique

  /// Which routing rule resolved, and to what. Model keys, not database ids:
  /// the registry is CONFIGURATION, so there is no model table to point at.
  routingTaskKey     String?
  resolvedModelKey   String?
  /// PHASE 10. Which CAPABILITY the task required, and — when the capability
  /// layer answered rather than a task rule — which profile chose the chain.
  ///
  /// Recorded because §9 asks the usage record to explain a request, and after
  /// Phase 10 "which model served this" is only half the answer: an operator
  /// looking at a surprising bill needs to know whether a human wrote that
  /// route or a ranking derived it. Null on rows written before Phase 10.
  routingCapability  String?
  /// `economy` / `balanced` / `premium` / `custom`, or null when a TASK rule
  /// resolved and no profile was consulted.
  routingProfile     String?
  /// Every model tried, in order, including the ones that failed. Fallback is
  /// invisible in reporting without it.
  ///
  /// `@default([])` is declared so the datamodel matches the column's database
  /// default. The default is load-bearing, not cosmetic: an insert that omits a
  /// scalar list does not send an empty array, so a row created without naming
  /// this column would violate NOT NULL.
  attemptedModelKeys String[] @default([])

  status         AiRequestStatus @default(PENDING)
  failureClass   AiFailureClass?
  /// Safe to show a customer. Never a raw provider error or a credential.
  failureMessage String?

  /// Audit-safe metadata. NEVER raw customer content.
  inputSummary Json?

  /// The model's output, stored ONLY when the routing rule opts in.
  ///
  /// docs/AI-GATEWAY.md §11 does not persist prompts or responses by default,
  /// and this column honours that: it stays null unless an operator turns
  /// `parameters.persistOutput` on for a rule. It exists because §7.4's second
  /// guarantee — "a duplicate request with the same idempotency key returns the
  /// original result" — cannot be met for a client that lost the response
  /// unless the result was kept somewhere. A caller that persists its own
  /// artifact does not need this and should leave it off.
  outputPayload Json?

  /// Usage units, as reported by the adapter and normalised by `extractUsage`.
  promptTokens     Int?
  completionTokens Int?
  imageCount       Int?
  durationSeconds  Int?

  /// What the PROVIDER charged us, in MICRO-MINOR units (a millionth of a
  /// minor unit). Minor units cannot hold a real token price: $0.15 per
  /// million input tokens is 0.015 of a cent per thousand tokens, which as an
  /// integer count of cents is zero. Accrues across attempts — including
  /// failed ones, which the customer is never billed for.
  providerCostMicroMinor BigInt @default(0)
  currency               String @default("USD") @db.Char(3)

  /// Milli-credits (D-14). Reserved generously up front, charged on the actual.
  creditsReservedMilli BigInt @default(0)
  creditsChargedMilli  BigInt @default(0)

  /// The reservation this request holds. One request, one reservation.
  creditReservationId String? @unique @db.Uuid

  latencyMs  Int?
  retryCount Int  @default(0)

  /// BYOK: the customer supplied the provider credential. Provider cost to
  /// BrandSpace is zero and the ledger says so, keeping margin honest.
  byok Boolean @default(false)

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  /// The deadline. The sweeper reconciles anything still RUNNING past it, so no
  /// reservation outlives its request (docs/AI-GATEWAY.md §6.1).
  deadlineAt  DateTime  @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ledger    AiUsageLedger[]

  /// D-112: gives this table's workspace-scoped foreign keys something to
  /// reference. `id` is already the primary key, so this constrains nothing new.
  @@unique([workspaceId, id], name: "ai_request_workspace_scope")
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, taskKey, status])
  /// The stuck-request sweep, ordered so the oldest is reconciled first — the
  /// A-7 lesson applied before the defect rather than after it.
  @@index([status, deadlineAt])
  @@map("ai_request")
}

/// TENANT-OWNED and IMMUTABLE. The financial truth for AI usage —
/// docs/DATABASE.md §6.6, docs/AI-GATEWAY.md §12.
///
/// Append-only: no updates, no deletes. A correction is a NEW row pointing at
/// the one it corrects, so replaying the table always reproduces the same
/// totals. The database enforces this with a trigger, not a convention.
model AiUsageLedger {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  aiRequestId String  @db.Uuid
  userId      String? @db.Uuid

  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  taskKey     String
  providerKey String
  modelKey    String

  /// `{ promptTokens, completionTokens, imageCount, durationSeconds }` — the
  /// units the cost was computed from, frozen at settlement.
  usageUnits Json

  providerCostMicroMinor BigInt @default(0)
  currency               String @default("USD") @db.Char(3)
  creditsChargedMilli    BigInt @default(0)

  /// The wallet movement this row accounts for, when there was one. A failed
  /// request writes a ledger row with zero credits and no transaction.
  creditTransactionId String? @db.Uuid

  byok        Boolean               @default(false)
  environment DeploymentEnvironment

  /// Set only on a correction row. Never edited; never deleted.
  correctsLedgerId String? @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request   AiRequest @relation(fields: [workspaceId, aiRequestId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "ai_usage_ledger_request_fkey")

  /// The row this one corrects, and the corrections against this one.
  ///
  /// Declared here as well as in the migration so the datamodel and the
  /// database agree: a foreign key that exists only in SQL is one a future
  /// `prisma migrate dev` would offer to drop. `Restrict` because a ledger row
  /// with a correction against it must not disappear out from under it.
  corrects    AiUsageLedger?  @relation("AiLedgerCorrection", fields: [workspaceId, correctsLedgerId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "ai_usage_ledger_corrects_fkey")
  correctedBy AiUsageLedger[] @relation("AiLedgerCorrection")

  /// D-112: gives this table's workspace-scoped foreign keys something to
  /// reference. `id` is already the primary key, so this constrains nothing new.
  @@unique([workspaceId, id], name: "ai_usage_ledger_workspace_scope")
  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([workspaceId, taskKey, occurredAt])
  @@index([modelKey, occurredAt])
  @@map("ai_usage_ledger")
}

// ===========================================================================
// Phase 5 — Brand and Brand Brain
//
// docs/PRODUCT.md §6A, docs/DATABASE.md §4.1–4.2, D-63/D-64/D-65.
//
// Brand Brain is the intelligence and memory layer. The schema is shaped by
// D-65's seven write-back requirements — provenance, evidence, confidence,
// approval state, versioning, reproducibility, human precedence — because each
// of them is a column somewhere or it is nothing.
//
// EVERY model below is TENANT-OWNED and additionally BRAND-SCOPED. The brand
// boundary is not a second opinion about the workspace boundary: a composite
// foreign key `(workspaceId, brandId)` references `brand(workspaceId, id)`, so
// the database itself refuses a row that points at another workspace's brand
// (docs/DATABASE.md §12, "Brand belongs to workspace").
// ===========================================================================

enum BrandStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The ten knowledge areas the product exposes. An area is a PRODUCT concept —
/// the customer sees it as a card and a node on the orb — so it is an enum
/// rather than configuration: adding one changes screens, copy and completion
/// rules together, which is a release rather than a setting.
enum BrandKnowledgeArea {
  IDENTITY
  AUDIENCE
  TONE_OF_VOICE
  OFFERS
  PROOF_POINTS
  DO_DONT
  COMPETITORS
  GLOSSARY
  STRATEGY
  LEARNINGS
}

/// D-64's four memories. They differ in truth condition, lifetime and
/// AUTHORITY, and `memoryPrecedence()` in packages/brand-brain reads this to
/// order retrieval. Canonical outranks Strategy outranks Content outranks
/// Learning — always, and not as a tie-break.
enum BrandMemoryLayer {
  CANONICAL
  STRATEGY
  CONTENT
  LEARNING
}

/// Where a knowledge item came from. The distinction that makes D-65's human
/// precedence enforceable: HUMAN beats DOCUMENT beats AI_INFERRED, and no
/// AI-inferred item may ever overwrite a human one.
enum BrandKnowledgeOrigin {
  HUMAN
  DOCUMENT
  AI_INFERRED
}

/// D-65's approval state, plus the two terminal states a real corpus needs.
/// Only ACTIVE items are eligible for production AI context.
enum BrandKnowledgeStatus {
  DRAFT
  PROPOSED
  ACTIVE
  STALE
  ARCHIVED
}

enum BrandSourceStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  QUARANTINED
}

enum BrandIngestionStage {
  QUEUED
  EXTRACTING
  CHUNKING
  EXTRACTING_FACTS
  COMPLETED
  FAILED
}

/// WHERE A KNOWLEDGE CANDIDATE CAME FROM — Phase 7.
///
/// Phase 5A had one source: an uploaded document. Phase 7 opens the second, and
/// D-64's write-back path needs the two told apart, because they land with
/// different authority. A candidate extracted from a document the customer
/// supplied becomes DOCUMENT knowledge once a human accepts it; a learning
/// inferred from performance stays AI_INFERRED even after acceptance, because a
/// human agreeing that an inference looks right does not turn it into a
/// statement the brand made about itself.
///
/// The column also decides what the review screen shows: a document candidate
/// diffs against its extract, and an analytics candidate shows the evidence and
/// the window it was drawn from.
enum BrandCandidateSource {
  DOCUMENT
  ANALYTICS
}

enum BrandCandidateStatus {
  PENDING
  ACCEPTED
  EDITED_ACCEPTED
  REJECTED
  SUPERSEDED
}

/// TENANT-OWNED. One brand inside a workspace — docs/DATABASE.md §4.1.
model Brand {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  slug String
  name String

  industry         String?
  description      String?
  websiteUrl       String?
  defaultLocale    Locale   @default(EN)
  supportedLocales Locale[] @default([])

  /// Brand kit. Structured, and validated at the boundary rather than trusted.
  colorPalette Json?
  typography   Json?
  voiceProfile Json?

  /// THE CANONICAL IDENTITY ASSETS (D-193).
  ///
  /// A REFERENCE INTO THE ONE ASSET LIBRARY, never a second copy of the file.
  /// The bytes live in `asset`; these columns say which of them IS this brand's
  /// logo, so the Creative Studio can find it later and nobody has to upload
  /// the same file per post.
  ///
  /// TENANT-SAFE BY CONSTRUCTION: the foreign key is composite on
  /// `(workspaceId, <column>)` (D-112), so a brand cannot name an asset in
  /// another workspace — the key has nowhere to point. A database trigger adds
  /// the rule a key cannot express: the asset must be this brand's own or
  /// workspace-shared, never another brand's.
  ///
  /// `ON DELETE SET NULL` names the column (D-114), so deleting the file clears
  /// the reference and never the tenant key.
  primaryLogoAssetId   String? @db.Uuid
  secondaryLogoAssetId String? @db.Uuid

  status BrandStatus @default(DRAFT)

  /// D-115. This brand's Arabic dialect, overriding the workspace's. NULL means
  /// "inherit", and the chain is brand → workspace → the activated default.
  /// A configured key, validated against the activated `content` domain.
  arabicDialect String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete (docs/DATABASE.md §2). Never applied to ledgers or audit.
  deletedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  primaryLogoAsset   Asset? @relation("BrandPrimaryLogo", fields: [workspaceId, primaryLogoAssetId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_primary_logo_fkey")
  secondaryLogoAsset Asset? @relation("BrandSecondaryLogo", fields: [workspaceId, secondaryLogoAssetId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_secondary_logo_fkey")

  knowledgeItems    BrandKnowledgeItem[]
  knowledgeVersions BrandKnowledgeVersion[]
  sourceDocuments   BrandSourceDocument[]
  sourceChunks      BrandSourceChunk[]
  candidates        BrandKnowledgeCandidate[]
  ingestionJobs     BrandIngestionJob[]
  conversations     BrandBrainConversation[]
  messages          BrandBrainMessage[]

  /// Phase 5B-1 — Asset Library. Every one is OPTIONALLY brand-scoped: a NULL
  /// brandId means the row belongs to the workspace rather than to a brand.
  assetFolders        AssetFolder[]
  assets              Asset[]
  assetVersions       AssetVersion[]
  assetUploadSessions AssetUploadSession[]
  assetProcessingJobs AssetProcessingJob[]

  /// Phase 5B-2 — AI Content Studio.
  contentItems    ContentItem[]
  contentVariants ContentVariant[]
  calendarSlots   CalendarSlot[]

  /// Phase 5B-3 — Approvals.
  approvals        Approval[]
  approvalPolicies ApprovalPolicy[]

  /// Phase 6 — Social Publishing. A connection belongs to exactly one brand
  /// (D-138), so BrandScope is a predicate here as everywhere else.
  socialConnections SocialConnection[]
  socialOAuthStates SocialOAuthState[]
  publishJobs       PublishJob[]

  /// Phase 7. Every one is brand-scoped with a NON-NULL brand except the
  /// Copilot session and plan, where null means the conversation has not yet
  /// settled which brand it is about (the tool calls always have).
  metricObservations        MetricObservation[]
  analyticsIngestionCursors AnalyticsIngestionCursor[]
  analyticsIngestionRuns    AnalyticsIngestionRun[]
  campaigns                 Campaign[]
  insights                  Insight[]
  insightEvidence           InsightEvidence[]
  copilotSessions           CopilotSession[]
  copilotActionPlans        CopilotActionPlan[]
  automationRules           AutomationRule[]
  automationRuns            AutomationRun[]
  automationEvents          AutomationEvent[]
  noteThreads               NoteThread[]

  /// The composite target a brand-scoped child points at. It is what makes
  /// `(workspaceId, brandId)` provable rather than merely conventional.
  memberSuggestions MemberSuggestion[]

  @@unique([workspaceId, id], name: "brand_workspace_scope")
  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, primaryLogoAssetId])
  @@index([workspaceId, secondaryLogoAssetId])
  @@map("brand")
}

/// TENANT-OWNED, BRAND-SCOPED. One unit of brand knowledge — docs/DATABASE.md
/// §4.2, and the carrier of every D-65 requirement.
model BrandKnowledgeItem {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  area   BrandKnowledgeArea
  memory BrandMemoryLayer     @default(CANONICAL)
  origin BrandKnowledgeOrigin @default(HUMAN)
  status BrandKnowledgeStatus @default(DRAFT)

  /// A stable key within (brand, area) — `audience.segment.founders`. Editing
  /// an item keeps its key; that is what makes a conflict detectable rather
  /// than appearing as two unrelated rows.
  itemKey String

  /// Localized `{ ar, en }`. Both locales are first-class (CLAUDE.md §4), and
  /// the boundary schema refuses a body with neither.
  title Json
  body  Json

  /// D-65 CONFIDENCE. Null for human-entered knowledge: a human statement is
  /// not a probability. 0–1000 (per mille) for anything inferred, kept integer
  /// so no float ever reaches money-adjacent comparisons.
  confidenceMilli Int?

  /// D-65 PROVENANCE. Which human, which document, which AI request.
  createdByUserId  String? @db.Uuid
  sourceDocumentId String? @db.Uuid
  aiRequestId      String? @db.Uuid

  /// D-65 EVIDENCE. Citations an inferred item must carry and a customer can
  /// inspect: `[{ chunkId, sourceDocumentId, locator, quote }]`. Never a raw
  /// provider response — only text the customer already owns.
  evidence Json?

  /// D-65 VERSIONING. Incremented on every accepted edit; retrieval cites it,
  /// and `brand_knowledge_version` keeps every prior value readable.
  version Int @default(1)

  /// Deterministic retrieval vector. NOT a vendor embedding: no embedding
  /// provider is approved (D-13), so this holds the local, reproducible
  /// index described in packages/brand-brain/src/retrieval.ts. The model key
  /// is recorded so re-indexing on a change is detectable.
  indexVector   Float[]   @default([])
  indexModelKey String?
  indexedAt     DateTime? @db.Timestamptz(6)

  /// Staleness. `reviewDueAt` is derived from validated configuration, never
  /// from a hard-coded interval.
  lastReviewedAt DateTime? @db.Timestamptz(6)
  reviewDueAt    DateTime? @db.Timestamptz(6)

  /// Set when this item conflicts with another and a human has not resolved
  /// it. D-65: a conflict is SURFACED, never silently resolved.
  conflictsWithItemId String? @db.Uuid

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand                @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_knowledge_item_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-83). Same oracle as the rest of the module, and
  /// the same collapse to "is this a document in my OWN workspace".
  ///
  /// `onDelete: SetNull` here is `ON DELETE SET NULL ("sourceDocumentId")` in
  /// the migration — the column list is NOT decoration. A bare SET NULL on a
  /// composite key nulls EVERY referencing column, `workspaceId` included, and
  /// `workspaceId` is NOT NULL, so deleting a source document would have begun
  /// failing outright. Prisma has no syntax for the column list; the migration
  /// carries it and D-114 records why.
  source    BrandSourceDocument? @relation(fields: [workspaceId, sourceDocumentId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_knowledge_item_source_fkey")

  versions   BrandKnowledgeVersion[]
  candidates BrandKnowledgeCandidate[]

  /// COMPOSITE (D-99, D-112, F-83), and a SELF-reference, so the oracle it
  /// closed was the sharpest kind: "is this id a knowledge item somewhere on
  /// the platform" asked of the very table that holds every tenant's approved
  /// brand knowledge. Column-scoped SET NULL, for the reason on `source`.
  conflictsWith BrandKnowledgeItem?  @relation("BrandKnowledgeConflict", fields: [workspaceId, conflictsWithItemId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_knowledge_item_conflict_fkey")
  conflicting   BrandKnowledgeItem[] @relation("BrandKnowledgeConflict")

  /// Phase 7 — where an insight cited this piece of approved brand knowledge,
  /// and the inferred learnings that were recorded as disagreeing with it.
  insightEvidence     InsightEvidence[]
  conflictingLearning BrandKnowledgeCandidate[] @relation("BrandCandidateConflict")

  /// One live item per key per area. A second row with the same key is an
  /// EDIT (a new version), not a duplicate — enforced here rather than hoped
  /// for in a service.
  /// The composite target every child of an item points at (D-99, D-112, F-83)
  /// — its versions, the candidates that would edit it, and the items that
  /// conflict with it.
  @@unique([workspaceId, id], name: "brand_knowledge_item_workspace_scope")
  @@unique([workspaceId, brandId, area, itemKey])
  @@index([workspaceId, brandId, area, status])
  @@index([workspaceId, brandId, status, memory])
  @@index([workspaceId, brandId, reviewDueAt])
  @@map("brand_knowledge_item")
}

/// TENANT-OWNED, BRAND-SCOPED and APPEND-ONLY. D-65 VERSIONING and
/// REPRODUCIBILITY: the previous value stays readable, so a generation can be
/// replayed against the exact state it used, and a rollback is a restore of a
/// row that was never destroyed.
///
/// Append-only is enforced by a database trigger, not a convention — the same
/// decision `ai_usage_ledger` made in Phase 4.
model BrandKnowledgeVersion {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  knowledgeItemId String @db.Uuid
  version         Int

  area   BrandKnowledgeArea
  memory BrandMemoryLayer
  origin BrandKnowledgeOrigin
  status BrandKnowledgeStatus

  title Json
  body  Json

  confidenceMilli Int?
  evidence        Json?

  /// Who made this version and why. `changeReason` is reviewer-supplied text,
  /// not customer content, and is shown back in the history.
  changedByUserId String? @db.Uuid
  changeReason    String?
  /// `created`, `edited`, `approved`, `rejected`, `archived`, `rolled_back`.
  changeKind      String

  recordedAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand              @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_knowledge_version_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-83). The append-only history is the last place
  /// a row should be attachable to another tenant's item: a version names the
  /// title and body it recorded, so a misattached row is that tenant's approved
  /// knowledge filed under someone else's identity.
  item      BrandKnowledgeItem @relation(fields: [workspaceId, knowledgeItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_knowledge_version_item_fkey")

  @@unique([knowledgeItemId, version])
  @@index([workspaceId, brandId, recordedAt(sort: Desc)])
  @@map("brand_knowledge_version")
}

/// TENANT-OWNED, BRAND-SCOPED. An uploaded source document.
///
/// The BYTES ARE NOT HERE. PostgreSQL holds a storage reference; the object
/// lives behind the storage abstraction (packages/brand-brain/src/storage.ts).
/// A row carries only what the product must query or display.
model BrandSourceDocument {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  fileName   String
  mimeType   String
  byteSize   Int
  /// SHA-256 of the content. Duplicate protection is a UNIQUE constraint on
  /// it per brand, so re-uploading the same file is idempotent by identity
  /// rather than by filename.
  checksum   String
  /// Opaque object-storage key. Never a URL, never a signed one: a signature
  /// in a database column is a credential with a long life.
  storageKey String

  status         BrandSourceStatus @default(UPLOADED)
  /// Safe to show a customer. Never a raw extractor error or a path.
  failureMessage String?

  /// Populated by extraction. `pageCount` is null for formats without pages.
  pageCount  Int?
  chunkCount Int  @default(0)
  /// Extracted characters — a size signal for the UI that is not the text.
  textLength Int  @default(0)

  /// Which area the uploader targeted, when they dropped the file on one.
  targetArea BrandKnowledgeArea?

  uploadedByUserId String? @db.Uuid
  /// The client's idempotency key for the upload itself.
  idempotencyKey   String

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_source_document_brand_fkey")

  chunks         BrandSourceChunk[]
  candidates     BrandKnowledgeCandidate[]
  ingestionJobs  BrandIngestionJob[]
  knowledgeItems BrandKnowledgeItem[]

  /// The composite target every child of a document points at (D-99, D-112,
  /// F-80). `id` is already the primary key, so this constrains nothing new —
  /// it exists because PostgreSQL requires a unique index behind a foreign key,
  /// and a workspace-scoped key is what stops another tenant's document id from
  /// being referenceable at all.
  @@unique([workspaceId, id], name: "brand_source_document_workspace_scope")
  @@unique([workspaceId, brandId, checksum])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, brandId, createdAt(sort: Desc)])
  @@map("brand_source_document")
}

/// TENANT-OWNED, BRAND-SCOPED. One retrievable chunk of a source document,
/// with the location reference that makes a citation checkable.
model BrandSourceChunk {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  sourceDocumentId String @db.Uuid
  chunkIndex       Int

  /// The chunk text. This IS customer content, which is why the chunk table is
  /// never read by any operator surface and never enters a log.
  text    String
  /// Human-readable location — "page 4", "section 2.1" — so a citation points
  /// somewhere a person can check.
  locator String?

  indexVector   Float[] @default([])
  indexModelKey String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand               @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_source_chunk_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-80). A plain `sourceDocumentId` does NOT keep
  /// the parent inside the tenant: PostgreSQL runs referential integrity with
  /// RLS BYPASSED, so a chunk carrying its own workspaceId was accepted against
  /// ANOTHER workspace's document — and the difference between "inserted" and
  /// "constraint violated" answered *does this document id exist?*. Pairing the
  /// reference with `workspaceId` collapses that to "is this a document in my
  /// OWN workspace", which discloses nothing.
  document  BrandSourceDocument @relation(fields: [workspaceId, sourceDocumentId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_source_chunk_document_fkey")

  @@unique([sourceDocumentId, chunkIndex])
  @@index([workspaceId, brandId])
  @@map("brand_source_chunk")
}

/// TENANT-OWNED, BRAND-SCOPED. A candidate fact extracted from a document,
/// waiting for a human.
///
/// THE GOVERNANCE BOUNDARY. Extraction writes here and NEVER to
/// `brand_knowledge_item`, so no upload can change approved knowledge on its
/// own. D-65's approval state is this table's existence.
model BrandKnowledgeCandidate {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  /// NULLABLE FROM PHASE 7. A document candidate names its document; an
  /// ANALYTICS candidate has none, because it was drawn from measurements rather
  /// than from a file. MATCH SIMPLE exempts the null case from the composite
  /// foreign key, so every candidate that DOES name a document is still checked.
  sourceDocumentId String? @db.Uuid
  /// The item this candidate would change, when one already exists. Null means
  /// it proposes something new. This is what the review screen diffs.
  targetItemId     String? @db.Uuid

  /// Phase 7. Which kind of candidate this is, and therefore what it may become.
  sourceKind BrandCandidateSource @default(DOCUMENT)

  /// Phase 7. The insight this learning was drawn from, so the reviewer can see
  /// the evidence rather than being asked to trust a sentence. D-65 calls this
  /// reproducibility, and an inference nobody can retrace is not reproducible.
  insightId String? @db.Uuid

  /// Phase 7. AN INFERENCE THAT DISAGREES WITH SOMETHING A HUMAN WROTE.
  ///
  /// Set when the proposed learning contradicts an ACTIVE, human-authored item.
  /// The candidate is still created and still reviewed — the conflict is
  /// SURFACED, never silently resolved, and accepting the learning never touches
  /// the item it disagrees with. D-65 is explicit that the platform does not
  /// correct the brand on the strength of a statistic.
  conflictsWithItemId String? @db.Uuid

  area    BrandKnowledgeArea
  itemKey String

  /// What extraction produced, kept EXACTLY as extracted even when a reviewer
  /// edits before accepting — the original stays inspectable.
  extractedTitle Json
  extractedBody  Json
  /// A reviewer's edit, when they changed it before accepting.
  reviewedTitle  Json?
  reviewedBody   Json?

  confidenceMilli Int
  evidence        Json

  status BrandCandidateStatus @default(PENDING)

  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime? @db.Timestamptz(6)
  reviewReason     String?
  /// The version this candidate produced once accepted — the audit link from
  /// a decision to its effect.
  resultingVersion Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand                @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_knowledge_candidate_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-83), for the reason on
  /// `BrandSourceChunk.document`.
  document  BrandSourceDocument? @relation(fields: [workspaceId, sourceDocumentId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_knowledge_candidate_document_fkey")
  /// COMPOSITE (D-99, D-112, F-83). This one crosses the GOVERNANCE boundary:
  /// `targetItemId` is the item a candidate would edit once accepted, so a
  /// foreign id here pointed the review screen's diff at another tenant's
  /// approved knowledge. NULL is legal and means "proposes something new",
  /// which MATCH SIMPLE exempts by construction. Column-scoped SET NULL, for
  /// the reason on `BrandKnowledgeItem.source`.
  target    BrandKnowledgeItem?  @relation(fields: [workspaceId, targetItemId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_knowledge_candidate_target_fkey")
  /// COMPOSITE (D-112), Phase 7. The insight and the conflicting item are both
  /// tenant-owned, and a foreign id in either would answer "does that exist?"
  /// across the boundary — sharper here than anywhere, because an analytics
  /// candidate's whole purpose is to point at evidence.
  insight   Insight?             @relation(fields: [workspaceId, insightId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_knowledge_candidate_insight_fkey")
  conflicts BrandKnowledgeItem?  @relation("BrandCandidateConflict", fields: [workspaceId, conflictsWithItemId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_knowledge_candidate_conflict_fkey")

  @@index([workspaceId, brandId, status])
  @@index([workspaceId, brandId, area, status])
  @@index([sourceDocumentId, status])
  @@index([workspaceId, sourceKind, status])
  @@map("brand_knowledge_candidate")
}

/// TENANT-OWNED, BRAND-SCOPED. The ingestion lifecycle for one document.
///
/// Idempotent and retryable (CLAUDE.md §5). One live job per document is a
/// partial unique index in the migration, so two uploads racing the same file
/// cannot both process it.
model BrandIngestionJob {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  sourceDocumentId String @db.Uuid

  stage       BrandIngestionStage @default(QUEUED)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(3)

  /// Safe to show a customer.
  failureMessage String?
  /// The internal reason, for operators. Never rendered to a customer and
  /// never a provider string.
  failureCode    String?

  /// Counters the UI reports honestly rather than guessing.
  chunksCreated     Int @default(0)
  candidatesCreated Int @default(0)

  /// The AI request that performed extraction, when one did. Reproducibility:
  /// an extraction can be traced to its gateway request and its cost.
  aiRequestId String? @db.Uuid

  queuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  startedAt     DateTime? @db.Timestamptz(6)
  completedAt   DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime? @db.Timestamptz(6)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand               @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_ingestion_job_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-80), for the reason on
  /// `BrandSourceChunk.document`. A job is the strongest form of the oracle: a
  /// queued job is observable in the UI, so a reference that merely fails later
  /// still answers the question at insert time.
  document  BrandSourceDocument @relation(fields: [workspaceId, sourceDocumentId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_ingestion_job_document_fkey")

  @@index([workspaceId, brandId, stage])
  @@index([stage, nextAttemptAt])
  @@map("brand_ingestion_job")
}

/// TENANT-OWNED, BRAND-SCOPED. A Brand Brain chat conversation.
model BrandBrainConversation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  /// The area the conversation was opened against, when it was opened from a
  /// node or a card. Null is the whole brain.
  area BrandKnowledgeArea?

  title String?

  startedByUserId String? @db.Uuid

  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  lastMessageAt DateTime @default(now()) @db.Timestamptz(6)

  /// D-78 RETENTION. Set from validated configuration when the conversation is
  /// created, because this feature DOES persist customer-visible AI output and
  /// therefore owns the artifact. Null is not allowed by the service.
  expiresAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_brain_conversation_brand_fkey")

  messages BrandBrainMessage[]

  /// The composite target every message points at (D-99, D-112, F-80). See the
  /// note on `BrandSourceDocument`.
  @@unique([workspaceId, id], name: "brand_brain_conversation_workspace_scope")
  @@index([workspaceId, brandId, lastMessageAt(sort: Desc)])
  @@index([expiresAt])
  @@map("brand_brain_conversation")
}

/// TENANT-OWNED, BRAND-SCOPED. One chat message.
///
/// D-78: this is persisted customer content, so it declares an owner (this
/// feature), a retention window, and a purge that clears the BODY while leaving
/// the accounting — `aiRequestId`, credits, the ledger — untouched.
model BrandBrainMessage {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  conversationId String @db.Uuid

  /// `user` or `assistant`. A system prompt is never persisted.
  role         String
  /// The message text. Nulled by the retention purge; the row survives so the
  /// conversation's shape and its accounting links remain.
  body         String?
  /// True once the body has been purged, so the UI says "expired" rather than
  /// rendering an empty bubble.
  bodyPurgedAt DateTime? @db.Timestamptz(6)

  /// Citations for a grounded answer: `[{ itemId, area, version, locator,
  /// sourceDocumentId, fileName }]`. A fabricated source is impossible because
  /// the service writes only ids it actually retrieved.
  citations Json?

  /// True when the assistant declined for lack of approved knowledge. Recorded
  /// so "honest refusal" is measurable rather than asserted.
  insufficientKnowledge Boolean @default(false)

  aiRequestId    String? @db.Uuid
  /// Client idempotency key, so a retried send never bills twice.
  idempotencyKey String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime? @db.Timestamptz(6)

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand        Brand                  @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_brain_message_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-80). The chat oracle was the sharpest of the
  /// three: posting into another workspace's conversation id SUCCEEDED, so a
  /// leaked id was not merely probeable but writable — the message landed in a
  /// conversation its author could not read.
  conversation BrandBrainConversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_brain_message_conversation_fkey")

  @@unique([workspaceId, conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@map("brand_brain_message")
}

// ---------------------------------------------------------------------------
// Phase 5B-1 — Asset Library (docs/PRODUCT.md §5 module 13, docs/DATABASE.md
// §4.6 and §12, docs/SECURITY.md §11).
//
// SIX TENANT-OWNED TABLES. Every one carries `workspaceId` and is protected by
// RLS. Five of them are BRAND-SCOPED, and their brand scope is NULLABLE on
// purpose: docs/DATABASE.md §4.6 says "brandId (null = workspace-level)", and a
// multi-brand company's logo pack, font files and legal boilerplate genuinely
// belong to the workspace rather than to one of its brands.
//
// THE COMPOSITE FOREIGN KEY STILL APPLIES, and a nullable column does not
// weaken it. PostgreSQL's default MATCH SIMPLE satisfies a composite key when
// ANY referencing column is NULL, so a workspace-level row (brandId IS NULL) is
// exempt by construction while every brand-scoped row is checked against
// `brand(workspaceId, id)`. A row pointing at another workspace's brand is
// refused by the database rather than by a service that remembered to look.
// ---------------------------------------------------------------------------

/// What kind of thing an asset is. docs/DATABASE.md §4.6.
enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  FONT
}

/// docs/DATABASE.md §4.6. `ai_generated` exists so an image the AI Creative
/// Studio produces lands in the same library under the same quota (U-09)
/// without a second table; nothing in this phase writes it.
enum AssetSource {
  UPLOAD
  AI_GENERATED
  IMPORTED
}

/// The malware verdict. docs/SECURITY.md §11.3.
///
/// PENDING IS THE ONLY LEGAL STARTING STATE and it means QUARANTINED, not
/// "probably fine". `isSelectable` and every download path require CLEAN.
enum AssetScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

/// docs/DATABASE.md §4.6. An asset is usable only at READY + CLEAN.
enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  PROCESSING_FAILED
  QUARANTINED
  ARCHIVED
}

/// A bounded, approved transformation of an asset's bytes.
///
/// AN ENUM RATHER THAN A STRING, so the set of derivatives the platform will
/// ever produce is a schema fact. An open string would let a caller ask for
/// anything and let the worker produce work nobody bounded.
enum AssetDerivativeKind {
  THUMBNAIL
  PREVIEW
}

/// The lifecycle of one upload session. docs/SECURITY.md §11.1.
enum AssetUploadSessionStatus {
  PENDING
  COMPLETED
  ABORTED
  EXPIRED
}

/// The stages one asset's processing passes through, mirroring
/// `BrandIngestionStage` so both pipelines read the same way in an operator's
/// dashboard.
enum AssetProcessingStage {
  QUEUED
  SCANNING
  INSPECTING
  DERIVING
  COMPLETED
  FAILED
}

/// TENANT-OWNED, OPTIONALLY BRAND-SCOPED. A folder in the Asset Library —
/// docs/DATABASE.md §12 (`AssetFolder`, "asset library hierarchy").
model AssetFolder {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  /// NULL = a workspace-level folder, visible to every brand in the workspace.
  brandId     String? @db.Uuid

  /// NULL = a root folder. A tree rather than a path string, because a rename
  /// of a folder halfway up must not require rewriting every descendant's row.
  parentFolderId String? @db.Uuid

  name String

  createdByUserId String? @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete (docs/DATABASE.md §2).
  deletedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_folder_brand_fkey")

  /// COMPOSITE, and not merely tidy. A plain foreign key on `parentFolderId`
  /// does NOT keep the parent inside the tenant: PostgreSQL runs referential
  /// integrity checks with RLS BYPASSED, so a tenant can reference a row it
  /// cannot read. That is an existence oracle — an insert that succeeds only
  /// when the id names a real folder somewhere on the platform tells the
  /// caller it exists, which is exactly the inference CLAUDE.md §2.1 forbids.
  /// Pairing the parent with `workspaceId` collapses the oracle to "is this a
  /// folder in my OWN workspace", which discloses nothing. Found by the
  /// isolation suite, which asserted the refusal and got a created row.
  parent         AssetFolder?         @relation("AssetFolderTree", fields: [workspaceId, parentFolderId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "asset_folder_parent_fkey")
  children       AssetFolder[]        @relation("AssetFolderTree")
  assets         Asset[]
  uploadSessions AssetUploadSession[]

  /// The composite target every child of a folder points at.
  @@unique([workspaceId, id], name: "asset_folder_workspace_scope")
  /// The listing query: one brand's folders under one parent, by name.
  @@index([workspaceId, brandId, parentFolderId, name])
  @@index([workspaceId, parentFolderId])
  @@map("asset_folder")
}

/// TENANT-OWNED, OPTIONALLY BRAND-SCOPED. docs/DATABASE.md §4.6.
///
/// THE ROW IS THE CURRENT VERSION. `AssetVersion` carries the history, and the
/// denormalised bytes fields here always describe the version `currentVersion`
/// names. Reading a library page therefore touches one table, which is what a
/// grid of two hundred thumbnails needs.
model Asset {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  /// NULL = a workspace-level asset (docs/DATABASE.md §4.6).
  brandId     String? @db.Uuid
  folderId    String? @db.Uuid

  name String
  kind AssetKind

  /// The type decided from the file's OWN SIGNATURE at upload, never the
  /// browser's claim (docs/SECURITY.md §11.2).
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  durationMs Int?

  /// Opaque object-storage key. Never a URL and never a signed one: a
  /// signature in a database column is a credential with a long life.
  storageKey     String
  checksumSha256 String

  source      AssetSource @default(UPLOAD)
  aiRequestId String?     @db.Uuid

  license        String?
  rightsExpiryAt DateTime? @db.Timestamptz(6)

  /// docs/DATABASE.md §4.6 stores tags as an array with a GIN index rather than
  /// as a join table. Kept exactly as specified: a tag here is a label, not an
  /// entity with its own identity, and a catalogue table would be a second
  /// source of truth for the same string.
  tags String[] @default([])

  scanStatus AssetScanStatus @default(PENDING)
  /// A stable reason key, never a scanner's own message. Both translations live
  /// in the message catalogue.
  scanReason String?
  scannedAt  DateTime?       @db.Timestamptz(6)

  status        AssetStatus @default(UPLOADING)
  /// Safe to show a customer. A stable reason key, never a parser error or a path.
  failureReason String?

  /// Which version the columns above describe. Starts at 1.
  currentVersion  Int     @default(1)
  /// docs/DATABASE.md §4.6. Set when this asset supersedes another.
  replacesAssetId String? @db.Uuid

  uploadedByUserId String? @db.Uuid

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)
  /// Soft delete. The object and its derivatives are removed by the retention
  /// sweep, not by the request that pressed the button.
  deletedAt  DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_brand_fkey")

  /// The brands that name this asset as a canonical logo (D-193). Back-relations
  /// only; the reference lives on `brand`.
  primaryLogoOf   Brand[]      @relation("BrandPrimaryLogo")
  secondaryLogoOf Brand[]      @relation("BrandSecondaryLogo")
  /// COMPOSITE, for the reason spelled out on AssetFolder.parent: a plain key
  /// would let a tenant file its own asset under another tenant folder, and
  /// would answer "does this folder id exist anywhere" for free.
  folder          AssetFolder? @relation(fields: [workspaceId, folderId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "asset_folder_fkey")

  versions       AssetVersion[]
  derivatives    AssetDerivative[]
  uploadSessions AssetUploadSession[]
  processingJobs AssetProcessingJob[]

  /// DUPLICATE PROTECTION. docs/DATABASE.md §4.6 asks for
  /// `(workspaceId, checksumSha256)` "for dedupe"; it is a UNIQUE constraint
  /// here rather than a plain index so the second upload of the same bytes is
  /// refused by the database even if two requests race past the service's own
  /// check. Scoped to the live rows only would need a partial index, which
  /// Prisma cannot express — so the service checks `deletedAt` and the
  /// constraint is the backstop. See the migration for the partial unique index
  /// that makes re-uploading after a delete possible.
  /// The composite target versions, derivatives, sessions and jobs point at.
  /// D-281. Conversations about this file.
  noteThreads NoteThread[]
  coverOf     ContentVariant[] @relation("ContentVariantCover")

  @@unique([workspaceId, id], name: "asset_workspace_scope")
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, kind])
  @@index([workspaceId, checksumSha256])
  /// The library's own listing: newest first inside a folder, deterministically.
  @@index([workspaceId, brandId, folderId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("asset")
}

/// TENANT-OWNED. One historical version of an asset's bytes.
///
/// APPEND-ONLY, and enforced the way `brand_knowledge_version` is: the tenant
/// role is granted SELECT and INSERT and nothing else, FORCE RLS leaves the
/// owner without a policy, and a trigger refuses UPDATE and DELETE. A version
/// history a caller can rewrite is not a history.
model AssetVersion {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  brandId     String? @db.Uuid
  assetId     String  @db.Uuid

  versionNumber Int

  /// The bytes THIS version points at. A version is a complete object, not a
  /// delta: a customer restoring version 2 must get exactly the file they
  /// uploaded, not a reconstruction.
  storageKey     String
  checksumSha256 String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  durationMs     Int?

  scanStatus AssetScanStatus @default(PENDING)

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_version_brand_fkey")
  asset     Asset     @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "asset_version_asset_fkey")

  @@unique([assetId, versionNumber])
  @@index([workspaceId, assetId, versionNumber(sort: Desc)])
  @@map("asset_version")
}

/// TENANT-OWNED. A bounded, approved transformation of an asset's bytes.
///
/// A ROW PER DERIVATIVE RATHER THAN A JSON BLOB. docs/DATABASE.md §4.6 carries
/// `derivatives jsonb` on the asset, and that shape cannot answer the question
/// this phase must answer: how many derivative objects exist, so the ceiling
/// can be enforced and so every one of them can be deleted when the asset is.
/// A JSON column that the deletion path has to parse to find object keys is how
/// orphaned objects accumulate.
model AssetDerivative {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  assetId     String @db.Uuid

  kind AssetDerivativeKind

  storageKey String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "asset_derivative_asset_fkey")

  /// ONE DERIVATIVE PER KIND PER ASSET. The ceiling is then a schema fact as
  /// well as a configured number, so a retried processing run overwrites rather
  /// than accumulating.
  @@unique([assetId, kind])
  @@index([workspaceId, assetId])
  @@map("asset_derivative")
}

/// TENANT-OWNED, OPTIONALLY BRAND-SCOPED. One upload in flight —
/// docs/SECURITY.md §11.1.
///
/// THE SESSION IS THE AUTHORISATION DECISION, MADE BEFORE ANY BYTES EXIST.
/// Permission, brand scope, entitlement, storage quota, declared size and
/// declared type are all settled at initiate; the completion step re-checks
/// only what the bytes themselves decide. That ordering is the whole reason a
/// session exists rather than a single upload call: refusing a 2 GB file after
/// receiving it costs the platform the 2 GB.
model AssetUploadSession {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  brandId     String? @db.Uuid
  folderId    String? @db.Uuid

  /// Set once the session completes and an asset row exists. NULL while the
  /// upload is in flight, and for a session that never completed.
  assetId String? @db.Uuid

  /// What the CALLER said. Kept because it is what the customer will be shown
  /// if the bytes disagree, and never used to choose a parser or a store.
  declaredFileName  String
  declaredMimeType  String
  declaredSizeBytes Int

  /// Where the bytes will land. Reserved at initiate, so the completion step
  /// cannot be talked into writing somewhere else.
  storageKey String

  status        AssetUploadSessionStatus @default(PENDING)
  /// A stable reason key when the session was refused at completion.
  failureReason String?

  /// REQUEST idempotency: a retry of an initiate whose response was lost
  /// replays the same session rather than reserving a second key.
  idempotencyKey String

  createdByUserId String? @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  /// A session past this may no longer be completed. The sweep expires it and
  /// removes any bytes that arrived.
  expiresAt   DateTime  @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?       @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_upload_session_brand_fkey")
  asset     Asset?       @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "asset_upload_session_asset_fkey")
  folder    AssetFolder? @relation(fields: [workspaceId, folderId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "asset_upload_session_folder_fkey")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, brandId, status])
  /// The expiry sweep reads this and nothing else.
  @@index([status, expiresAt])
  @@map("asset_upload_session")
}

/// TENANT-OWNED. Scan, inspect and derive one asset — the same shape as
/// `BrandIngestionJob`, for the same reasons.
model AssetProcessingJob {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  brandId     String? @db.Uuid
  assetId     String  @db.Uuid

  stage       AssetProcessingStage @default(QUEUED)
  attempts    Int                  @default(0)
  maxAttempts Int                  @default(3)

  /// A stable reason key, safe to show a customer.
  failureReason String?
  /// The internal reason, for operators. Never rendered to a customer.
  failureCode   String?

  derivativesCreated Int @default(0)

  queuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  startedAt     DateTime? @db.Timestamptz(6)
  completedAt   DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_processing_job_brand_fkey")
  asset     Asset     @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "asset_processing_job_asset_fkey")

  @@index([workspaceId, assetId, queuedAt(sort: Desc)])
  /// The reconciliation sweep: unclaimed work, oldest first.
  @@index([stage, nextAttemptAt])
  @@map("asset_processing_job")
}

// ---------------------------------------------------------------------------
// Phase 5B-2 — AI Content Studio (docs/PRODUCT.md §5 module 7,
// docs/DATABASE.md §4.4 and §4.5, docs/ROADMAP.md Phase 5 scope item 3).
//
// TWO TENANT-OWNED TABLES, both additionally BRAND-SCOPED, and every foreign
// key between them composite with `workspaceId` — D-112, which F-80 and F-83
// established as the platform rule rather than an Asset Library one.
//
// THE CONTENT ITEM IS CHANNEL-AGNOSTIC AND THE VARIANT IS NOT. That split is
// docs/DATABASE.md §4.4/§4.5 and it is the whole point: one idea, written once,
// rendered per platform and per locale. A single table carrying a
// `platformKey` would make "the same post for Instagram and LinkedIn" two
// unrelated rows, and approving one would say nothing about the other.
// ---------------------------------------------------------------------------

/// docs/DATABASE.md §4.4. What kind of thing a content item is.
enum ContentType {
  POST
  CAROUSEL
  STORY
  REEL
  VIDEO
  ARTICLE
  THREAD
}

/// docs/DATABASE.md §4.4 lifecycle.
///
/// PHASE 5B-2 REACHES DRAFT, IN_REVIEW AND ARCHIVED ONLY. The later states are
/// declared because the lifecycle is a product fact and a partial enum would
/// have to be migrated by the phase that needs them — but nothing in this
/// phase writes SCHEDULED or beyond. Approvals (scope item 6) and the Social
/// Calendar (item 5) own those transitions, and this phase deliberately does
/// not pre-empt either.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  ARCHIVED
}

/// Whether a variant's body has been checked against its platform's limits.
///
/// `UNVALIDATED` is the honest starting state and is never rendered as "valid":
/// a caption nobody has measured is not a caption known to fit.
enum ContentValidationState {
  UNVALIDATED
  VALID
  WARNINGS
  INVALID
}

/// How a piece of content came to exist. Provenance the customer can see, and
/// the thing that makes "AI wrote this" answerable rather than assumed.
enum ContentOrigin {
  HUMAN
  AI_GENERATED
  AI_ASSISTED
}

/// Where a calendar slot is in its own short life — docs/DATABASE.md §4.7b.
///
/// DELIBERATELY SHORTER THAN §4.7's DESIGN. `LOCKED`, `PUBLISHING`, `PUBLISHED`
/// and `FAILED` are the publishing pipeline's, and the pipeline is Phase 6. A
/// state no code can ever enter is a state whose meaning nobody has settled, so
/// they are absent rather than declared and unreachable.
enum CalendarSlotStatus {
  /// On the calendar, and the content is not yet cleared to go.
  PLANNED
  /// On the calendar and cleared. The content item is `SCHEDULED` in step.
  SCHEDULED
  /// Phase 6. Jobs exist and are in flight. The item is `PUBLISHING` in step.
  PUBLISHING
  /// Phase 6. Every job for this slot succeeded.
  PUBLISHED
  /// Phase 6. Some jobs succeeded and some did not. The item is
  /// `PARTIALLY_PUBLISHED` in step, and the per-target detail is on the jobs.
  PARTIALLY_PUBLISHED
  /// Phase 6. No job for this slot succeeded.
  FAILED
  /// Taken off the calendar. Kept rather than deleted so the audit trail and
  /// the quota refund both have a row to point at.
  CANCELLED
}

/// TENANT-OWNED, BRAND-SCOPED. The canonical content object — docs/DATABASE.md §4.4.
model ContentItem {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  title       String
  contentType ContentType @default(POST)

  /// The locale the item was authored in. Variants carry their own, so an
  /// Arabic item with an English variant is a normal shape rather than a
  /// contradiction.
  primaryLocale Locale   @default(EN)
  /// The content pillar this belongs to, when the brand uses pillars.
  pillar        String?
  tags          String[] @default([])

  /// Phase 7 — the campaign this item belongs to. NULLABLE: content that
  /// belongs to no campaign is the ordinary case, not an omission.
  ///
  /// docs/DATABASE.md §4.4b recorded this column as deliberately NOT created in
  /// Phase 5B-2, on the grounds that "a column with no writer is a column whose
  /// meaning nobody has settled". Phase 7 settles it: `campaign` exists, the
  /// Campaign service writes it, and campaign analytics read through it.
  campaignId String? @db.Uuid

  status ContentStatus @default(DRAFT)

  /// D-65-style provenance, for the same reason Brand Brain carries it: a
  /// customer is entitled to know whether a human or a model wrote the words.
  origin          ContentOrigin @default(HUMAN)
  createdByUserId String?       @db.Uuid
  /// The gateway request that produced it. AC-11.5 — the draft is linked to the
  /// `AiRequest`, so a generation can be traced to its cost and its model.
  aiRequestId     String?       @db.Uuid

  /// AC-11.4. Which Brand Brain entries and versions grounded the generation:
  /// `[{ itemId, area, version, locator, sourceDocumentId, fileName }]`.
  /// Written from what RETRIEVAL returned, never parsed out of model text, so a
  /// fabricated citation is impossible.
  citations Json?

  /// True when the generation declined for lack of approved knowledge. Recorded
  /// so an honest refusal is measurable rather than asserted.
  insufficientKnowledge Boolean @default(false)

  /// The dialect the item was generated in (D-115), resolved at generation time
  /// from brand → workspace → the activated default. Recorded rather than
  /// re-derived, because the configured default can change afterwards and a
  /// draft must still say what it actually was.
  arabicDialect String?

  /// Client idempotency key for the generation, so a retried request never
  /// bills twice and never creates a second draft.
  idempotencyKey String?

  /// D-116 / D-117 retention. NULL means "retained while the subscription is
  /// active". A date is either the post-cancellation grace deadline or the
  /// workspace's own shorter window, whichever the service resolved.
  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete (docs/DATABASE.md §2).
  deletedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "content_item_brand_fkey")

  variants      ContentVariant[]
  calendarSlots CalendarSlot[]
  approvals     Approval[]
  /// Phase 6 — one job per (slot, connection, variant).
  publishJobs   PublishJob[]

  /// Phase 7 — the campaign this item belongs to, and the analytics it earned.
  campaign           Campaign?           @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "content_item_campaign_fkey")
  metricObservations MetricObservation[]
  insightEvidence    InsightEvidence[]
  noteThreads        NoteThread[]

  /// The composite target every variant points at (D-112).
  @@unique([workspaceId, id], name: "content_item_workspace_scope")
  /// A replayed generation returns the first draft rather than making a second.
  @@unique([workspaceId, brandId, createdByUserId, idempotencyKey])
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, brandId, updatedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("content_item")
}

/// TENANT-OWNED, BRAND-SCOPED. Per-platform, per-locale rendering of a content
/// item — docs/DATABASE.md §4.5.
model ContentVariant {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  contentItemId String @db.Uuid

  /// The platform key this variant is written for, from the activated `content`
  /// configuration domain — never an enum, because the set of platforms the
  /// product supports is an operator's fact (CLAUDE.md §2.2) and Phase 6 will
  /// add to it without a migration.
  platformKey String
  locale      Locale

  /// The caption. THIS IS CUSTOMER CONTENT: nulled by the retention purge while
  /// the row survives, exactly as `brand_brain_message.body` is, so the shape of
  /// the work and its accounting links outlive the words.
  body         String?
  bodyPurgedAt DateTime? @db.Timestamptz(6)

  hashtags     String[] @default([])
  mentions     String[] @default([])
  linkUrl      String?
  firstComment String?

  /// Assets selected from the Asset Library. A uuid array rather than a join
  /// table, matching docs/DATABASE.md §4.5 — a variant references assets, it
  /// does not own them.
  ///
  /// NOT a foreign key, and that is deliberate rather than an oversight: an
  /// array cannot carry a composite key, so the tenant boundary here is
  /// enforced in the SERVICE, which resolves every id through the tenant-scoped
  /// client before writing. The isolation suite proves a foreign asset id is
  /// refused on that path.
  assetIds String[] @default([]) @db.Uuid

  /// Phase 6 final (D-285) — a Reel's or video's cover image. The variant's own
  /// brand or the shared shelf (trigger `content_variant_cover_scope`); deleting
  /// the asset clears it.
  coverAssetId String? @db.Uuid

  platformOptions Json?

  validationState  ContentValidationState @default(UNVALIDATED)
  validationErrors Json?
  characterCount   Int                    @default(0)

  origin      ContentOrigin @default(HUMAN)
  aiRequestId String?       @db.Uuid

  /// The dialect this variant was written in (D-115), for the reason on the item.
  arabicDialect String?

  /// Retention travels with the item's, so a purge cannot clear a caption and
  /// leave its translation.
  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand       @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "content_variant_brand_fkey")
  /// COMPOSITE (D-112). A plain `contentItemId` would accept another
  /// workspace's item id — referential integrity runs with RLS bypassed — and
  /// the difference between accepted and refused would answer whether that id
  /// exists. F-80 and F-83 are what this line prevents recurring.
  item      ContentItem @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "content_variant_item_fkey")
  cover     Asset?      @relation("ContentVariantCover", fields: [workspaceId, coverAssetId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "content_variant_cover_fkey")

  publishJobs PublishJob[]

  /// Phase 6 (D-112). The composite target `publish_job.contentVariantId`
  /// points at. Added rather than assumed: a plain key to a tenant-owned parent
  /// is a cross-workspace existence oracle, and this is the parent side of the
  /// pair that makes the child's key provable.
  @@unique([workspaceId, id], name: "content_variant_workspace_scope")
  /// docs/DATABASE.md §4.5: one variant per platform per locale.
  @@unique([contentItemId, platformKey, locale])
  @@index([workspaceId, contentItemId])
  @@index([workspaceId, brandId])
  @@index([workspaceId, coverAssetId])
  @@index([expiresAt])
  @@map("content_variant")
}

/// TENANT-OWNED, BRAND-SCOPED. When a content item goes out — docs/DATABASE.md
/// §4.7 and §4.7b.
///
/// THE SLOT IS THE *WHEN*; THE CONTENT ITEM REMAINS THE SOURCE OF TRUTH FOR THE
/// WHAT AND THE STATE. A second copy of a caption, a status or a channel list
/// here would be a second answer to a question `content_item` already answers,
/// and the two would drift the first time one was updated without the other. So
/// this row holds a time, a timezone, a target and a link.
///
/// WHY THREE TIME COLUMNS AND NOT ONE (AC-14.2, AC-14.3). A timestamp alone
/// cannot answer "what time did the customer MEAN?" across a daylight-saving
/// boundary: 09:00 local converted to UTC in January and read back in July is
/// 08:00 or 10:00, and neither is what anyone asked for. So the INTENT
/// (`scheduledLocalTime`, `timezone`) is stored beside the INSTANT
/// (`scheduledAtUtc`), and the instant is recomputed from the intent whenever
/// the zone's offset changes. Storing only the instant loses the intent; storing
/// only the intent makes every query a conversion.
model CalendarSlot {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  contentItemId String @db.Uuid

  /// The instant, in UTC. What every range query and every sweep reads.
  scheduledAtUtc     DateTime @db.Timestamptz(6)
  /// The wall-clock the customer chose, as `YYYY-MM-DDTHH:mm`. A STRING rather
  /// than a timestamp on purpose: it is a local intent with no offset, and
  /// giving it one would be inventing the very fact it exists to preserve.
  scheduledLocalTime String
  /// The IANA zone that intent is expressed in, copied from the workspace when
  /// the slot was created. Copied rather than joined, because a workspace that
  /// relocates must not silently move every post it already scheduled.
  timezone           String

  status CalendarSlotStatus @default(PLANNED)

  /// AC-14.7 — the publishing target is a MOCK, and says so in the data rather
  /// than only in a comment. Phase 6 adds real connection targets beside it;
  /// until then nothing in this system can name one.
  targetKind String @default("MOCK")

  /// Which channels this slot is for. Derived from the item's variants when the
  /// slot is created, and kept so a slot still renders its channels after a
  /// variant is edited — the calendar is a plan, and a plan records what was
  /// planned.
  platformKeys String[] @default([])

  createdByUserId String?   @db.Uuid
  cancelledAt     DateTime? @db.Timestamptz(6)

  /// The usage-quota event this slot consumed (AC-14.5), so cancelling can
  /// refund exactly what scheduling took and a retry cannot double-count.
  usageIdempotencyKey String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand       @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "calendar_slot_brand_fkey")
  /// COMPOSITE (D-112). A plain `contentItemId` would accept another
  /// workspace's item — referential integrity runs with RLS bypassed — and the
  /// difference between accepted and refused answers whether that id exists.
  /// F-80 and F-83 are what this line prevents recurring.
  item      ContentItem @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_slot_item_fkey")

  publishJobs PublishJob[]

  /// Phase 6 (D-112) — the parent side of `publish_job.calendarSlotId`.
  @@unique([workspaceId, id], name: "calendar_slot_workspace_scope")
  /// ONE LIVE SLOT PER ITEM. A partial index, so a cancelled slot does not
  /// block rescheduling the same content — the same shape D-100 settled for the
  /// asset checksum, and it lives in the migration because Prisma cannot model
  /// a WHERE clause on a unique index.
  @@index([workspaceId, scheduledAtUtc])
  @@index([workspaceId, brandId, scheduledAtUtc])
  @@index([workspaceId, contentItemId])
  @@index([status, scheduledAtUtc])
  @@map("calendar_slot")
}

// ---------------------------------------------------------------------------
// Phase 5B-3 — Approvals, Activity Log, Notifications
// (docs/PRODUCT.md §5 modules 1, 14, 16, 17; docs/DATABASE.md §4.8 and §9.3)
// ---------------------------------------------------------------------------

/// Where a review request currently stands. `CANCELLED` is withdrawal by the
/// requester or by a later edit; `CHANGES_REQUESTED` is a reviewer's verdict
/// and is distinct from `REJECTED` because one invites a resubmission and the
/// other closes the question.
enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  CANCELLED
}

/// What an approval is attached to. Only `CONTENT_ITEM` is reachable in this
/// phase; the others are declared because docs/DATABASE.md §4.8 designs them
/// and a later phase should extend the enum rather than redesign the table.
enum ApprovalSubjectType {
  CONTENT_ITEM
  CAMPAIGN
  ASSET
}

/// TENANT-OWNED, BRAND-SCOPED. One review CYCLE over one subject — the record
/// of a request and the verdict that closed it (docs/DATABASE.md §4.8).
///
/// ONE CYCLE PER ROW, and the history is the rows. Resubmitting after changes
/// were requested opens a NEW row rather than reopening the old one, so
/// "who approved this, when, and against which policy" keeps a stable answer
/// after the next edit.
model Approval {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  subjectType   ApprovalSubjectType @default(CONTENT_ITEM)
  /// The content item under review. A COLUMN rather than a polymorphic id,
  /// because a composite foreign key (D-112) cannot be written against a
  /// column whose target table varies — and an uncheckable reference is how a
  /// cross-tenant id gets accepted.
  contentItemId String?             @db.Uuid

  requestedByUserId String  @db.Uuid
  /// Optional assignment. NULL means "anyone who may approve", which is the
  /// common case in a small team and is not the same as unassigned-and-stuck.
  assignedToUserId  String? @db.Uuid

  status ApprovalStatus @default(PENDING)

  /// The requester's context, and the reviewer's. Free text from a member of
  /// the workspace, bounded by the service and never interpolated into a
  /// prompt.
  requestNote  String?
  decisionNote String?

  decidedByUserId String?   @db.Uuid
  decidedAt       DateTime? @db.Timestamptz(6)

  /// The approval rules in force when the request was made — `{ selfApproval,
  /// clientApproval, requireApprovalBeforeScheduling }`. Snapshotted rather
  /// than joined, because a policy that changes afterwards must not rewrite
  /// what an earlier decision meant.
  policySnapshot Json?

  /// Which cycle this is for the subject, starting at 1. Makes the history
  /// orderable without depending on clock resolution.
  cycle Int @default(1)

  /// WHAT THE VERDICT WAS GRANTED OVER — `{ item, variants: { id: hash } }`,
  /// written when the decision is APPROVE (D-223).
  ///
  /// An approval used to record a verdict and nothing about the words. Editing
  /// a SCHEDULED item's caption was deliberately left alone by
  /// `editVariant` (the calendar owns that edge), and the publisher read
  /// `variant.body` live while checking only that an approval existed and said
  /// APPROVED — so submit → approve → schedule → edit → publish sent text
  /// nobody had reviewed, under a verdict granted to different text.
  ///
  /// Comparing this at publish time is what closes that, without either side
  /// having to know the other's edge cases. NULL means "granted before this
  /// existed", and the publisher treats it as not covering anything.
  approvedFingerprint Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand        @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "approval_brand_fkey")
  /// COMPOSITE (D-112), exactly as `calendar_slot_item_fkey`. A plain
  /// `contentItemId` would resolve another workspace's draft, and the
  /// difference between accepted and refused answers whether it exists.
  item      ContentItem? @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "approval_item_fkey")

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, contentItemId, cycle(sort: Desc)])
  @@index([workspaceId, assignedToUserId, status])
  @@index([workspaceId, brandId, status])
  @@map("approval")
}

/// TENANT-OWNED, BRAND-SCOPED. The per-brand approval policy — ROADMAP Phase 5
/// scope item 6, "policy per brand".
///
/// ABSENCE IS NOT A STATE. A brand with no row uses the activated
/// `content.approvals` configuration defaults; the row exists only once
/// somebody has deliberately departed from them, so a default that changes
/// still reaches every brand that never chose otherwise.
model ApprovalPolicy {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  /// AC-14.6. When true, only an APPROVED item may be placed on the calendar.
  /// This is the per-brand form of the gate D-120 shipped OFF; the workflow
  /// behind it now exists.
  requireApprovalBeforeScheduling Boolean?

  /// D-122. Whether a member holding `content.approve` may approve content
  /// they themselves authored. Default-deny, and an owner may relax it.
  allowSelfApproval Boolean?

  /// RESERVED AND INERT — D-62 supersedes D-121 for the MVP.
  ///
  /// D-121 made this the per-brand switch admitting Viewer (read-only) as a
  /// reviewer. D-62 requires Viewer to be strictly read-only, so the switch has
  /// no behaviour: nothing reads it to authorize anything, no API patches it,
  /// no screen renders it, and `approval_policy_client_approval_withdrawn`
  /// pins it to FALSE or NULL.
  ///
  /// Kept as structure for a future External Review / Guest Approval
  /// capability, which will be a distinct narrow actor rather than a
  /// repurposing of `client_viewer` — the same treatment as the unreachable
  /// `ApprovalSubjectType` members and the undeliverable `NotificationChannel`
  /// values.
  clientApprovalEnabled Boolean?

  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "approval_policy_brand_fkey")

  /// One policy per brand.
  @@unique([workspaceId, brandId])
  @@map("approval_policy")
}

/// How a notification reaches its recipient. Only `IN_APP` is deliverable in
/// this phase — no mail transport exists in the platform, and D-123 records
/// that external delivery is Phase 8 launch hardening. The enum is declared in
/// full because docs/DATABASE.md §9.3 designs it.
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

/// TENANT-OWNED. One in-app notification for one member — docs/DATABASE.md
/// §9.3.
///
/// WRITTEN FROM DOMAIN EVENTS, never from a UI handler. `packages/notifications`
/// is the only writer, and it is called by the service that changed the state,
/// so a notification cannot exist for something that did not happen.
model Notification {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  /// The recipient. NOT NULL: a workspace-wide notification would have no
  /// per-reader unread state, which is the one thing this table is for.
  /// Fan-out to several members is several rows, each independently readable.
  userId String @db.Uuid

  /// The event key — `approval.requested`, `approval.approved`,
  /// `approval.changes_requested`, `approval.rejected`. The rendered STRING is
  /// not stored: the reader's locale is known at read time, and storing one
  /// language would make the inbox monolingual for a bilingual workspace.
  templateKey String

  /// The values the template interpolates: `{ itemTitle, brandName, actorName }`.
  /// Bounded and free of secrets; the redaction layer applies as everywhere.
  payload Json?

  channel NotificationChannel @default(IN_APP)

  /// Where the notification points. A workspace-relative path, locale-prefixed
  /// at render time, so a deep link cannot leak another workspace's route.
  linkPath String?

  brandId      String? @db.Uuid
  resourceType String?
  resourceId   String? @db.Uuid

  /// NULL until the recipient reads it. The one mutable column, and the reason
  /// this is not derived from `audit_event`, which is append-only by design.
  readAt DateTime? @db.Timestamptz(6)

  /// One notification per logical event per recipient, however many times the
  /// producing action is retried.
  idempotencyKey String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, userId, readAt, createdAt(sort: Desc)])
  @@index([workspaceId, userId, createdAt(sort: Desc)])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Phase 6 — Social Publishing (docs/SOCIAL-INTEGRATIONS.md, docs/PRODUCT.md §5
// modules 8 and 9).
//
// FIVE TENANT-OWNED TABLES, AND THE SPLIT BETWEEN THE FIRST TWO IS THE POINT.
// `social_connection` is the row every screen, every list and every log line
// reads; `social_credential` holds the encrypted token material and is read by
// exactly one code path. Keeping them in one table would mean every
// `SELECT *` on a connection carried a customer's access token through the
// application — and `SELECT *` is what an ORM emits by default.
// ---------------------------------------------------------------------------

/// The platforms this phase connects to. LinkedIn and X are single-target;
/// Facebook and Instagram are reached through the same Meta login but publish
/// to different objects, so they are separate providers rather than one with a
/// mode flag — a mode flag is how two platforms end up sharing a bug.
enum SocialProvider {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  X
}

enum SocialConnectionStatus {
  /// OAuth started, callback not yet completed. Never publishable.
  PENDING
  /// Usable: token valid, required scopes present.
  ACTIVE
  /// The token or its scopes failed. The customer must reconnect; queued work
  /// is held rather than failed, until its deadline.
  NEEDS_REAUTH
  /// The customer disconnected, or the provider revoked us.
  REVOKED
  /// Disabled by the platform (support, abuse, plan change).
  DISABLED
}

/// The publish job's lifecycle. `VERIFICATION_PENDING` is the state that
/// prevents duplicate posts: an uncertain outcome — a timeout after the request
/// left — is never blindly retried, it is CHECKED
/// (docs/SOCIAL-INTEGRATIONS.md §7.2).
enum PublishJobStatus {
  PENDING
  QUEUED
  PUBLISHING
  VERIFICATION_PENDING
  PUBLISHED
  FAILED
  CANCELLED
}

/// The error taxonomy from docs/SOCIAL-INTEGRATIONS.md §2.1, plus the three
/// classes that come from our own pre-flight rather than from a provider.
/// Retry behaviour, customer messaging and re-auth prompts all derive from this
/// value, so it is stored rather than re-derived from a message string.
enum PublishFailureClass {
  AUTH_EXPIRED
  AUTH_REVOKED
  INSUFFICIENT_SCOPE
  RATE_LIMITED
  CONTENT_REJECTED
  MEDIA_INVALID
  DUPLICATE_CONTENT
  TARGET_UNAVAILABLE
  PLATFORM_UNAVAILABLE
  TIMEOUT
  /// Ours: approval was withdrawn between scheduling and dispatch.
  APPROVAL_REVOKED
  /// Ours: the connection is no longer usable.
  NOT_CONNECTED
  /// Ours: the provider does not support what was asked of it.
  UNSUPPORTED
  UNKNOWN
}

enum PublishAttemptOutcome {
  SUCCEEDED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  /// The request left and the answer did not come back. Resolved by asking the
  /// provider what happened, never by sending again.
  INDETERMINATE
}

/// A customer's authorization to publish to one external account.
///
/// BRAND-SCOPED AND NOT NULLABLE (D-138). Every other brand-scoped table in
/// this schema allows a NULL brand to mean "the workspace's own"; a social
/// connection does not, because BrandScope has to be expressible as a query
/// predicate (D-132/D-134) and "visible to everyone" is exactly the hole a
/// brand-restricted member would publish through.
model SocialConnection {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  provider SocialProvider

  /// The provider's own id for the page / channel / profile. Not a secret — it
  /// is public on every platform here — but still tenant data, so it is never
  /// matched across workspaces.
  externalAccountId String
  /// What the customer sees: the page or profile name, as the provider gave it.
  displayName       String
  /// Provider-supplied avatar URL, or null. Rendered through the same image
  /// policy as any other remote URL.
  avatarUrl         String?
  /// e.g. "page", "business_account", "organization", "profile". Declared by
  /// the adapter, so the UI can say what KIND of thing is connected.
  targetKind        String

  status SocialConnectionStatus @default(PENDING)

  /// Scopes the provider actually granted — not the ones we asked for. A
  /// missing scope disables the capabilities that need it rather than the
  /// whole connection (docs/SOCIAL-INTEGRATIONS.md §5).
  grantedScopes String[] @default([])

  connectedByUserId String?   @db.Uuid
  connectedAt       DateTime? @db.Timestamptz(6)

  /// When the access token stops working. Mirrored from the credential so the
  /// UI can warn without the token table being read at all.
  tokenExpiresAt  DateTime? @db.Timestamptz(6)
  lastRefreshedAt DateTime? @db.Timestamptz(6)

  /// Connection health. `lastSyncedAt` is the last time we successfully talked
  /// to the provider about this account for any reason.
  lastCheckedAt           DateTime?            @db.Timestamptz(6)
  lastSyncedAt            DateTime?            @db.Timestamptz(6)
  consecutiveFailureCount Int                  @default(0)
  lastFailureClass        PublishFailureClass?

  revokedAt      DateTime? @db.Timestamptz(6)
  disconnectedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "social_connection_brand_fkey")

  credentials SocialCredential[]
  publishJobs PublishJob[]

  /// Phase 7 — the analytics this account produces, and the durable state of
  /// the pulls that produced it.
  metricObservations MetricObservation[]
  analyticsCursors   AnalyticsIngestionCursor[]
  analyticsRuns      AnalyticsIngestionRun[]

  /// When the maintenance sweep last ensured this connection's INGESTION
  /// CURSOR SET (D-229). Null means never, and the sweep orders `ASC NULLS
  /// FIRST`, so a connection nobody has ensured is visited before one that was
  /// ensured an hour ago and the bounded batch rotates instead of returning the
  /// same head for ever (D-182).
  ///
  /// It is NOT ingestion state. Cursor progress, backoff and freshness live on
  /// `analytics_ingestion_cursor` and are written only by ingestion; the ensure
  /// statement is ON CONFLICT DO NOTHING and never resets an existing row.
  analyticsCursorsEnsuredAt DateTime? @db.Timestamptz(6)

  /// The composite target its children point at (D-112).
  @@unique([workspaceId, id], name: "social_connection_workspace_scope")
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, provider, status])
  @@index([status, tokenExpiresAt])
  @@index([status, analyticsCursorsEnsuredAt])
  @@map("social_connection")
}

/// The encrypted OAuth material for one connection.
///
/// A SEPARATE TABLE ON PURPOSE. Nothing that renders a connection ever selects
/// from here, so a token cannot reach a screen, a log or an error by being a
/// column on a row somebody already had. Exactly one code path reads it, and it
/// runs on the worker or the API — never in a React tree.
///
/// APPEND-ONLY BY CONVENTION AND VERSIONED: a refresh writes a NEW row and
/// retires the previous one, so a rotation that half-fails leaves the old token
/// usable rather than leaving the connection with nothing.
model SocialCredential {
  id                 String @id @default(uuid()) @db.Uuid
  workspaceId        String @db.Uuid
  socialConnectionId String @db.Uuid

  /// Monotonic per connection. The live credential is the highest version with
  /// `retiredAt IS NULL`.
  version Int

  /// Envelope encryption, identical in shape to `secret_version` but in the
  /// SOCIAL key domain (D-136) — a worker holding this KEK cannot unwrap a
  /// platform provider credential.
  ciphertext        String
  iv                String
  authTag           String
  wrappedDataKey    String
  keyProvider       String
  keyId             String
  algorithm         String @default("AES-256-GCM")
  encryptionContext String

  /// Audit-safe only. Never the token: at most its last four characters, and
  /// nothing at all for a short value.
  maskedHint  String
  /// Keyed, non-reversible. Lets "is this the same token?" be answered without
  /// decrypting either side.
  fingerprint String

  accessTokenExpiresAt DateTime? @db.Timestamptz(6)
  /// Whether a refresh token was issued at all. A BOOLEAN, never the token.
  hasRefreshToken      Boolean   @default(false)

  retiredAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [workspaceId, socialConnectionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "social_credential_connection_fkey")

  @@unique([workspaceId, socialConnectionId, version])
  @@index([workspaceId, socialConnectionId, retiredAt])
  @@map("social_credential")
}

/// One in-flight OAuth authorization.
///
/// THE STATE PARAMETER IS THE CSRF DEFENCE AND IT IS STORED HASHED. The value
/// that travels through the browser is never written down, so a database read
/// cannot be replayed as a callback. Single-use is enforced by a conditional
/// UPDATE on `consumedAt`, not by a read-then-write.
model SocialOAuthState {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  provider SocialProvider

  /// SHA-256 of the opaque state token. Unique platform-wide, so two workspaces
  /// cannot collide and a replay across tenants cannot match either.
  stateHash String @unique

  /// PKCE verifier, ENCRYPTED. It is a secret for the lifetime of the flow: an
  /// attacker holding the code and the verifier can complete the exchange.
  verifierCiphertext        String
  verifierIv                String
  verifierAuthTag           String
  verifierWrappedDataKey    String
  verifierKeyProvider       String
  verifierKeyId             String
  verifierEncryptionContext String

  /// Recorded so the callback can verify the redirect URI matched EXACTLY what
  /// was sent, rather than trusting the one in the request.
  redirectUri     String
  requestedScopes String[] @default([])

  startedByUserId String    @db.Uuid
  expiresAt       DateTime  @db.Timestamptz(6)
  consumedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  // --- The pending grant, when one authorization offered several targets ----
  //
  // D-142. A grant that exposes more than one page, channel or organization is
  // not finished at the callback: BrandSpace must not pick one on the customer
  // behalf. The exchanged token is sealed HERE rather than written to a
  // connection, because a connection row that exists before the target is known
  // is a connection bound to a target nobody chose.
  //
  // Every one of these is NULL for a single-target grant, which never pauses.

  /// The exchanged TokenBundle, sealed under its own encryption context. It is
  /// the same material a `social_credential` holds and is protected identically.
  pendingCiphertext        String?
  pendingIv                String?
  pendingAuthTag           String?
  pendingWrappedDataKey    String?
  pendingKeyProvider       String?
  pendingKeyId             String?
  pendingEncryptionContext String?

  /// What the provider said this grant can publish to. The customer own pages,
  /// under the customer own RLS. No token, and nothing from another workspace.
  offeredTargets Json?

  /// What the provider ACTUALLY granted, carried across the selection step so
  /// the connection records the same scopes it would have recorded directly.
  grantedScopes String[] @default([])

  /// SHA-256 of the single-use secret that authorises the CHOICE. Held by the
  /// browser that completed the callback; unique platform-wide for the same
  /// reason `stateHash` is.
  selectionTokenHash  String?   @unique
  selectionExpiresAt  DateTime? @db.Timestamptz(6)
  selectionConsumedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "social_oauth_state_brand_fkey")

  @@index([workspaceId, expiresAt])
  @@index([expiresAt])
  @@map("social_oauth_state")
}

/// One content variant, going to one connection, for one calendar slot.
///
/// THE UNIT OF PUBLISHING IS THE TRIPLE, not the slot. A slot planned for two
/// platforms is two jobs, so one platform rejecting a caption does not fail the
/// other, and a retry retries only what failed.
model PublishJob {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  calendarSlotId     String @db.Uuid
  contentItemId      String @db.Uuid
  contentVariantId   String @db.Uuid
  socialConnectionId String @db.Uuid

  provider SocialProvider

  status PublishJobStatus @default(PENDING)

  /// hash(workspace, slot, connection, variant). UNIQUE per workspace, so a
  /// re-dispatch — a sweeper racing a producer, a retry after a lost
  /// acknowledgement — finds the existing job rather than creating a second.
  idempotencyKey String

  /// When this was meant to go out, copied from the slot so a rescheduled slot
  /// does not silently re-time a job already in flight.
  scheduledAtUtc DateTime @db.Timestamptz(6)

  attemptCount  Int       @default(0)
  maxAttempts   Int
  nextAttemptAt DateTime? @db.Timestamptz(6)

  /// Set by the conditional claim. Two workers cannot both hold a job.
  claimedAt   DateTime? @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  failureClass PublishFailureClass?
  /// A stable machine code the UI maps to a localized sentence. NEVER a raw
  /// provider message, which can echo request content.
  failureCode  String?

  /// What the provider called the post, and where a human can see it.
  externalPostId  String?
  externalPostUrl String?
  publishedAt     DateTime? @db.Timestamptz(6)

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand      Brand            @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "publish_job_brand_fkey")
  slot       CalendarSlot     @relation(fields: [workspaceId, calendarSlotId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "publish_job_slot_fkey")
  item       ContentItem      @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "publish_job_item_fkey")
  variant    ContentVariant   @relation(fields: [workspaceId, contentVariantId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "publish_job_variant_fkey")
  connection SocialConnection @relation(fields: [workspaceId, socialConnectionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "publish_job_connection_fkey")

  attempts PublishAttempt[]

  /// Phase 7 — the metrics the published post went on to earn.
  metricObservations MetricObservation[]

  @@unique([workspaceId, id], name: "publish_job_workspace_scope")
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, calendarSlotId])
  @@index([workspaceId, contentItemId])
  @@index([status, nextAttemptAt])
  @@index([status, scheduledAtUtc])
  /// The stale-claim sweep (D-143). A job PUBLISHING with an expired claim is
  /// one whose worker died mid-flight; this makes finding it a lookup rather
  /// than a scan of every publishing job on the platform.
  @@index([status, claimedAt])
  @@map("publish_job")
}

/// The evidence trail for one attempt at one job.
///
/// APPEND-ONLY, enforced by a trigger. This is what support and a platform
/// dispute both read, and a record that can be edited afterwards is not
/// evidence. The stored summary is REDACTED — a status code, a provider error
/// code and a bounded safe message — never the raw body, which routinely echoes
/// the caption that was rejected.
model PublishAttempt {
  id           String @id @default(uuid()) @db.Uuid
  workspaceId  String @db.Uuid
  publishJobId String @db.Uuid

  attemptNumber Int

  startedAt  DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  durationMs Int?

  outcome      PublishAttemptOutcome
  failureClass PublishFailureClass?

  /// The provider's HTTP status, and its own error code where it gives one.
  providerStatusCode Int?
  providerErrorCode  String?
  /// A short, redacted description. Bounded by a CHECK so a raw body cannot be
  /// dropped in here by a future call site.
  safeSummary        String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       PublishJob @relation(fields: [workspaceId, publishJobId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "publish_attempt_job_fkey")

  @@unique([workspaceId, publishJobId, attemptNumber])
  @@index([workspaceId, publishJobId, attemptNumber])
  @@map("publish_attempt")
}

// ===========================================================================
// PHASE 7 — Analytics, Intelligence, Copilot and Automations
//
// docs/ROADMAP.md Phase 7, docs/DATABASE.md §4.3, §5.5 and §9.1–9.2.
//
// THE LOOP THIS PHASE CLOSES: published content produces real metrics, metrics
// become evidence, evidence grounds an explanation and a strategy, an accepted
// learning re-enters Brand Brain at its LOWEST authority, and the Copilot and
// the automation engine act on all of it — never silently, and never with
// authority the acting person does not hold at the moment of the act.
//
// EVERY MODEL BELOW IS TENANT-OWNED AND BRAND-SCOPED WITH A NON-NULL BRAND.
// D-138's reasoning applies to all of them and not only to a publishing
// credential: BrandScope has to be expressible as a query predicate
// (D-132/D-134), and a row whose brand is "all of them" is exactly the hole a
// brand-restricted member reads, explains, automates or publishes through.
// ===========================================================================

/// What a metric observation is ABOUT. A post is one published thing; an
/// account is the connected page, channel or profile as a whole.
///
/// There is deliberately no `BRAND` member. A brand figure is an AGGREGATE of
/// account and post figures, computed at query time from rows a provider
/// actually returned — storing one would be storing a number no provider ever
/// reported, which is the single thing this subsystem exists not to do.
enum MetricSubjectType {
  POST
  ACCOUNT
}

/// The width of the window a value covers. Part of the observation's identity:
/// "1,200 impressions" means nothing until you know whether that is an hour, a
/// day or the lifetime of the post.
enum MetricGranularity {
  HOUR
  DAY
  WEEK
  MONTH
  LIFETIME
}

/// What the stored integer MEANS.
///
/// INTEGERS ALL THE WAY DOWN, exactly as credits are. A rate is stored as parts
/// per mille rather than as a float, because a float that reaches a comparison
/// is how "engagement went up" becomes a rounding artefact.
enum MetricUnit {
  /// A plain tally: impressions, likes, comments.
  COUNT
  /// A rate in parts per mille. 47 means 4.7%.
  RATIO_MILLI
  /// A duration in whole seconds — watch time, average view duration.
  SECONDS
  /// A signed change in followers or audience size.
  DELTA
}

/// Where an observation came from. It is STORED, never inferred, so a chart
/// drawn from mock data can say so and a production surface can refuse it.
enum MetricSourceKind {
  /// A real provider API answered.
  PROVIDER
  /// A deterministic in-process mock. Never reachable in PRODUCTION.
  MOCK
}

/// How current this connection's analytics are.
///
/// Computed after each pull from the configured thresholds and STORED, so a
/// screen states a freshness the ingestion actually achieved rather than one it
/// recomputes from a timestamp with its own idea of "recent".
enum AnalyticsFreshness {
  /// Ingested within the configured freshness window.
  FRESH
  /// Past the freshness window but inside the stale window.
  AGING
  /// Past the stale window. Every figure drawn from it must say so.
  STALE
  /// Never successfully ingested, or the connection can no longer be asked.
  UNAVAILABLE
}

/// Why a pull happened. `BACKFILL` is bounded by configuration and walks
/// backwards; `SCHEDULED` walks the recent window forward.
enum AnalyticsRunKind {
  SCHEDULED
  BACKFILL
  MANUAL
}

/// How a pull ended.
///
/// `PARTIAL` is a first-class outcome rather than a failure: a provider that
/// answered for three accounts and rate-limited the fourth has given us three
/// accounts' worth of truth, and discarding it would make a partial outage look
/// like a total one.
enum AnalyticsRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  /// The shared provider budget was exhausted; nothing was asked for.
  SKIPPED_RATE_LIMITED
}

/// What an insight IS. Mirrors docs/DATABASE.md §5.5's `type` column.
enum InsightType {
  ANALYTICS_EXPLANATION
  RECOMMENDATION
  ANOMALY
  CONTENT_GAP
  OPPORTUNITY
  STRATEGY
  MONTHLY_PLAN
}

/// An insight's lifecycle. A generated strategy is a PROPOSAL until a permitted
/// human accepts it — `ACCEPTED` is the only state that lets anything else act
/// on it.
enum InsightStatus {
  NEW
  SEEN
  ACCEPTED
  DISMISSED
  /// Superseded by a newer generation over the same scope and period.
  SUPERSEDED
}

/// WHAT THE SUGGESTION IS ACTUALLY BASED ON, stated on the row.
///
/// BrandSpace has no approved external trend or competitor provider, so a
/// suggestion can only rest on things this workspace already owns. Recording
/// which one removes the product's ability to imply a live market feed it does
/// not have: a screen renders this, and there is no member meaning "the wider
/// internet".
enum InsightBasis {
  /// This brand's own stored metric observations.
  OWN_PERFORMANCE
  /// Approved Brand Brain knowledge the customer entered or supplied.
  BRAND_CONTEXT
  /// What this brand has actually published before.
  CONTENT_HISTORY
  /// Several of the above together.
  MIXED
}

/// What one piece of evidence IS.
///
/// `ABSENCE` is the member that makes an honest content-gap claim possible: "no
/// post on this pillar in this window" is a statement about rows that are NOT
/// there, and it needs to be expressible as evidence rather than asserted in
/// prose.
enum EvidenceKind {
  METRIC
  METRIC_COMPARISON
  BRAND_KNOWLEDGE
  CONTENT
  ABSENCE
}

/// Why a campaign exists. A closed set, because the objective decides which
/// metrics the campaign's own analytics lead with.
enum CampaignObjective {
  AWARENESS
  ENGAGEMENT
  TRAFFIC
  LEADS
  RETENTION
  LAUNCH
}

enum CampaignStatus {
  DRAFT
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// THE COPILOT'S THREE ACTION CLASSES — CLAUDE.md §2.5 and A-17.
///
/// The class is a property of the TOOL, stored on every plan step and every
/// tool call, so "may this run without a fresh human confirmation?" is answered
/// from a column rather than from a condition somebody has to remember to
/// write.
enum CopilotActionClass {
  /// Reads. No tenant state changes.
  READ_ONLY
  /// Changes tenant state and can be compensated: a draft, a calendar
  /// placement, a campaign proposal.
  INTERNAL_REVERSIBLE
  /// Leaves the platform, or destroys something. Publish, delete, disconnect,
  /// send. NEVER executed without a fresh, plan-bound human confirmation.
  EXTERNAL_OR_DESTRUCTIVE
}

enum CopilotPlanStatus {
  /// Being assembled. Not yet shown.
  DRAFT
  /// Shown to the customer with its preview and its estimated cost.
  AWAITING_CONFIRMATION
  /// A human confirmed THIS plan hash. The only state execution may start from.
  CONFIRMED
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
  /// The confirmation window closed before anyone acted.
  EXPIRED
}

enum CopilotToolCallStatus {
  PLANNED
  RUNNING
  SUCCEEDED
  FAILED
  /// Authorization, scope or entitlement refused it AT EXECUTION TIME.
  REFUSED
  /// An earlier step failed, so this one never ran.
  SKIPPED
  UNDONE
}

/// Whether the work a plan did can still be taken back.
///
/// `REFUSED` is the important member: an undo that would overwrite somebody
/// else's later edit is refused and says why, rather than silently winning.
enum CopilotUndoStatus {
  /// Nothing was changed, so there is nothing to undo.
  NOT_APPLICABLE
  AVAILABLE
  PARTIALLY_UNDONE
  UNDONE
  REFUSED
  EXPIRED
}

enum CopilotMessageRole {
  USER
  ASSISTANT
}

/// The events an automation rule may fire on. A CLOSED REGISTRY — there is no
/// "custom event", because a customer-defined trigger is customer-defined code
/// with extra steps.
enum AutomationTrigger {
  CONTENT_APPROVED
  CONTENT_SCHEDULED
  POST_PUBLISHED
  ANALYTICS_REFRESHED
  ANOMALY_DETECTED
  METRIC_THRESHOLD_CROSSED
  SCHEDULED_TIME
}

/// What a rule may DO. Also closed, and deliberately small.
///
/// NO WEBHOOK, NO SCRIPT, NO SQL AND NO ARBITRARY URL. Every member here is a
/// call into a domain service this platform already owns, with that service's
/// own authorization intact.
enum AutomationActionType {
  /// In-app notification to the members who can act on it.
  NOTIFY
  /// Move an eligible draft into the approval queue.
  SUBMIT_FOR_APPROVAL
  /// Place an eligible, approved item on the calendar.
  PLACE_ON_CALENDAR
  /// EXTERNAL. Always proposes; never executes without a human confirmation.
  PROPOSE_PUBLISH
}

enum AutomationRunStatus {
  RUNNING
  /// The action ran and finished.
  SUCCEEDED
  /// The condition did not hold. Not a failure.
  SKIPPED
  /// An EXTERNAL action reached a proposal and is waiting for a person.
  AWAITING_CONFIRMATION
  /// The action was refused by policy — an external action on a rule that may
  /// not auto-run, a daily ceiling reached.
  BLOCKED_BY_POLICY
  /// The rule's creator no longer holds the permission, brand scope or
  /// entitlement the action needs. Re-evaluated at RUN TIME, every time.
  BLOCKED_BY_AUTHORIZATION
  FAILED
  CANCELLED
  /// THE PROPOSAL'S WINDOW CLOSED WITH NOBODY CONFIRMING IT.
  ///
  /// Terminal, and distinct from CANCELLED on purpose: cancelled is a decision
  /// somebody made, expired is one nobody made. A run that sat here would
  /// otherwise keep a Confirm control alive on a screen for ever, pointing at a
  /// proposal whose content is now days stale.
  EXPIRED
}

/// TENANT-OWNED, BRAND-SCOPED. ONE NORMALIZED METRIC FACT, as one provider
/// reported it for one subject over one window — docs/DATABASE.md §5.5.
///
/// ONE ROW PER (metric, subject, window), NOT A BLOB OF EVERY METRIC AT ONCE.
/// §5.5's design carried a `metrics jsonb`; this is narrower on purpose, and the
/// reason is the rule the whole phase rests on: MISSING AND ZERO ARE DIFFERENT
/// STATES. In a blob, a provider that does not report `saves` and a provider
/// that reports `saves: 0` are told apart only by a key's absence — which every
/// `?? 0` in every consumer quietly erases. As rows, a metric a provider did not
/// return simply has NO ROW, and there is nothing for a default to fill in.
///
/// IT ALSO MAKES IDEMPOTENCY A DATABASE PROPERTY rather than a code habit.
/// `observationKey` is a deterministic hash of the logical observation, unique
/// per workspace, and ingestion writes through `INSERT … ON CONFLICT DO UPDATE`
/// — so two schedulers, a duplicate queue delivery and a backfill overlapping a
/// scheduled pull all converge on one row instead of racing a read-then-write.
///
/// OUT-OF-ORDER DELIVERY IS HANDLED BY THE CONFLICT CLAUSE, not by the caller:
/// the update applies only when the incoming observation is at least as recent
/// as the stored one, so a late redelivery of an older reading cannot roll a
/// figure backwards.
model MetricObservation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  socialConnectionId String         @db.Uuid
  provider           SocialProvider

  subjectType       MetricSubjectType
  /// The provider's own id for the thing measured — a post id, or the account
  /// id. Public on every platform here, but still tenant data.
  subjectExternalId String

  /// Which of OUR rows this measurement belongs to, when the subject is a post
  /// we published. Both are nullable because an account-level reading belongs
  /// to no single post, and because a post published before the customer joined
  /// has no publish job here.
  publishJobId  String? @db.Uuid
  contentItemId String? @db.Uuid

  /// The canonical metric key — `impressions`, `reach`, `engagements`, … The
  /// vocabulary is CODE (packages/analytics/src/metrics.ts) for the same reason
  /// the AI task keys are: application code asks for it by name. What each
  /// PROVIDER calls it is the adapter's business and appears nowhere here.
  metricKey String

  granularity MetricGranularity
  periodStart DateTime          @db.Timestamptz(6)
  periodEnd   DateTime          @db.Timestamptz(6)

  /// The value, as an integer in `unit`. BigInt because a lifetime impression
  /// count on a large account outgrows a 32-bit integer, and because every
  /// other number in this platform that must not be approximated is an integer.
  value BigInt
  unit  MetricUnit

  /// WHEN THE PROVIDER SAYS IT OBSERVED THIS, and when WE wrote it down. Two
  /// different facts: a provider can answer today with a reading it took
  /// yesterday, and a freshness indicator that conflated them would call stale
  /// data current.
  observedAt DateTime @db.Timestamptz(6)
  ingestedAt DateTime @default(now()) @db.Timestamptz(6)

  /// PROVENANCE. `sourceKind` says whether a real provider answered;
  /// `sourceVersion` is the adapter's own contract version, so a normalization
  /// change is detectable rather than silently rewriting history.
  sourceKind    MetricSourceKind
  sourceVersion String

  /// The run that wrote it. Null after the run is pruned; the observation
  /// outlives its run record.
  ingestionRunId String? @db.Uuid

  /// sha256 of the logical observation: workspace, connection, subject type,
  /// subject id, metric key, granularity and period start. THE IDEMPOTENCY KEY,
  /// and the conflict target.
  observationKey String

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand      Brand            @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "metric_observation_brand_fkey")
  /// COMPOSITE (D-112). A plain key would resolve another workspace's
  /// connection — PostgreSQL checks referential integrity as the table owner
  /// with RLS bypassed — and "inserted" versus "violates foreign key" would
  /// answer "does that connection exist?" across the tenant boundary.
  connection SocialConnection @relation(fields: [workspaceId, socialConnectionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "metric_observation_connection_fkey")
  job        PublishJob?      @relation(fields: [workspaceId, publishJobId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "metric_observation_job_fkey")
  item       ContentItem?     @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "metric_observation_item_fkey")

  evidence InsightEvidence[]

  /// The composite target evidence rows point at (D-112).
  @@unique([workspaceId, id], name: "metric_observation_workspace_scope")
  /// THE CONFLICT TARGET. One row per logical observation per workspace.
  @@unique([workspaceId, observationKey])
  @@index([workspaceId, brandId, metricKey, periodStart(sort: Desc)])
  @@index([workspaceId, brandId, subjectType, periodStart(sort: Desc)])
  @@index([workspaceId, socialConnectionId, periodStart(sort: Desc)])
  @@index([workspaceId, contentItemId])
  @@index([workspaceId, publishJobId])
  /// Retention pruning walks this.
  @@index([periodStart])
  @@map("metric_observation")
}

/// TENANT-OWNED, BRAND-SCOPED. THE DURABLE INGESTION STATE for one connection,
/// one subject type and one granularity.
///
/// WHY A ROW AND NOT A REDIS KEY. "Which window did we last fetch?" has to
/// survive a Redis flush, a deploy and a worker crash, or a restart silently
/// re-fetches from the beginning (or, worse, skips forward and leaves a hole
/// nobody ever fills). It is also the CLAIM: two schedulers running at once is
/// an ordinary deployment shape, and the conditional `UPDATE … WHERE
/// nextAttemptAt <= now AND claim is free` is what makes the second one a
/// no-op — a database primitive, not a check-then-act.
model AnalyticsIngestionCursor {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  socialConnectionId String            @db.Uuid
  provider           SocialProvider
  subjectType        MetricSubjectType
  granularity        MetricGranularity

  /// The newest period this cursor has successfully covered. Ingestion asks for
  /// what comes after it, so a gap is closed rather than skipped.
  lastCoveredPeriodEnd DateTime? @db.Timestamptz(6)
  lastSucceededAt      DateTime? @db.Timestamptz(6)
  lastAttemptedAt      DateTime? @db.Timestamptz(6)

  /// How far BACKWARDS the bounded backfill has reached. Null means backfill
  /// has not started; `backfillCompletedAt` means it reached the configured
  /// horizon and will not run again.
  backfillCursor      DateTime? @db.Timestamptz(6)
  backfillCompletedAt DateTime? @db.Timestamptz(6)

  /// Bounded exponential backoff, written down rather than recomputed, so a
  /// process restart honours the wait a provider asked for.
  nextAttemptAt           DateTime?            @db.Timestamptz(6)
  consecutiveFailureCount Int                  @default(0)
  lastFailureClass        PublishFailureClass?
  lastFailureCode         String?

  /// Computed from the configured windows after each pull, and STORED.
  freshness AnalyticsFreshness @default(UNAVAILABLE)

  /// The claim. A pass that finds a claim younger than the configured lease
  /// leaves the cursor alone; past the lease the claim is treated as abandoned.
  claimedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand      Brand            @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "analytics_cursor_brand_fkey")
  connection SocialConnection @relation(fields: [workspaceId, socialConnectionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "analytics_cursor_connection_fkey")

  runs AnalyticsIngestionRun[]

  @@unique([workspaceId, id], name: "analytics_ingestion_cursor_workspace_scope")
  @@unique([workspaceId, socialConnectionId, subjectType, granularity])
  @@index([workspaceId, brandId, freshness])
  /// The scheduler's claim query.
  @@index([nextAttemptAt, claimedAt])
  @@map("analytics_ingestion_cursor")
}

/// TENANT-OWNED. THE EVIDENCE TRAIL FOR ONE PULL — what was asked for, what came
/// back, how long it took and why it stopped.
///
/// APPEND-ONLY EXCEPT FOR ITS OWN COMPLETION, enforced by a trigger. An
/// operations record that can be rewritten afterwards is not a record; the
/// trigger permits exactly the transition from `RUNNING` to a terminal status
/// and refuses everything else.
model AnalyticsIngestionRun {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  cursorId           String         @db.Uuid
  socialConnectionId String         @db.Uuid
  provider           SocialProvider

  kind   AnalyticsRunKind
  status AnalyticsRunStatus @default(RUNNING)

  /// Deterministic: hash(cursor, kind, window). UNIQUE per workspace, so a
  /// duplicate queue delivery finds the existing run rather than starting a
  /// second one against the same window.
  idempotencyKey String

  windowStart DateTime @db.Timestamptz(6)
  windowEnd   DateTime @db.Timestamptz(6)

  startedAt  DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  durationMs Int?

  /// Counters the UI reports rather than guesses. `subjectsRequested` and
  /// `subjectsAnswered` differing is exactly what `PARTIAL` means.
  subjectsRequested     Int @default(0)
  subjectsAnswered      Int @default(0)
  observationsWritten   Int @default(0)
  observationsUnchanged Int @default(0)

  failureClass      PublishFailureClass?
  /// A stable machine code the UI maps to a localized sentence. NEVER a raw
  /// provider message, which routinely echoes request content.
  failureCode       String?
  /// Short, redacted and bounded by a CHECK, exactly as `publish_attempt` is.
  safeSummary       String?
  /// Honoured for `RATE_LIMITED`, where the provider says when to come back.
  retryAfterSeconds Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace  Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand      Brand                    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "analytics_run_brand_fkey")
  cursor     AnalyticsIngestionCursor @relation(fields: [workspaceId, cursorId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "analytics_run_cursor_fkey")
  connection SocialConnection         @relation(fields: [workspaceId, socialConnectionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "analytics_run_connection_fkey")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, brandId, startedAt(sort: Desc)])
  @@index([workspaceId, cursorId, startedAt(sort: Desc)])
  @@index([startedAt])
  @@map("analytics_ingestion_run")
}

/// TENANT-OWNED, BRAND-SCOPED. A campaign — docs/DATABASE.md §4.3.
///
/// NARROWER THAN §4.3 ON PURPOSE, and the narrowing is the honest half.
/// `budgetMinor`, `currency` and `kpis` are NOT created: this platform buys no
/// media, records no spend and receives no paid-media attribution, so a budget
/// column would be a number nobody can reconcile and a KPI column a target
/// nothing measures. §4.4b established the rule — a column with no writer is a
/// column whose meaning nobody has settled — and it applies here.
///
/// `version` IS THE UNDO PRIMITIVE. The Copilot's compensation contract restores
/// a previous value only when the version it acted on is still the current one,
/// so a person who edited the campaign afterwards is never silently overwritten.
model Campaign {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  name        String
  objective   CampaignObjective
  /// Localized `{ ar, en }`, validated at the boundary. Both locales are
  /// first-class (CLAUDE.md §4).
  brief       Json?
  description String?

  status CampaignStatus @default(DRAFT)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  /// Platform keys from the activated `content` configuration — never an enum,
  /// because the set of platforms is an operator's fact (CLAUDE.md §2.2).
  channels String[] @default([])

  /// The accepted strategy proposal this campaign came out of, when it came out
  /// of one. Null for a campaign a person simply created.
  strategyInsightId String? @db.Uuid

  ownerUserId     String? @db.Uuid
  createdByUserId String? @db.Uuid

  /// Optimistic concurrency. Incremented on every accepted edit.
  version Int @default(1)

  /// Client idempotency key, so a retried creation returns the first campaign
  /// rather than making a second.
  idempotencyKey String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete (docs/DATABASE.md §2).
  deletedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "campaign_brand_fkey")

  contentItems ContentItem[]
  insights     Insight[]
  evidence     InsightEvidence[]
  noteThreads  NoteThread[]

  @@unique([workspaceId, id], name: "campaign_workspace_scope")
  @@unique([workspaceId, brandId, createdByUserId, idempotencyKey])
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, brandId, startDate, endDate])
  @@map("campaign")
}

/// TENANT-OWNED, BRAND-SCOPED. ONE GENERATED PIECE OF INTELLIGENCE — an
/// explanation, an anomaly, a recommendation, a content gap, a strategy or a
/// monthly plan (docs/DATABASE.md §5.5).
///
/// THE PROSE IS HERE; THE NUMBERS ARE NOT. Every figure a customer reads is
/// rendered from an `InsightEvidence` row, and the model's own text may contain
/// only digits that appeared in the evidence package it was given. A fabricated
/// citation is therefore structurally impossible in the same way a Content
/// Studio citation is: the reference set is written from the QUERY RESULTS, and
/// a claim citing anything outside it is rejected before the row exists.
///
/// `basis` IS THE HONESTY COLUMN. This platform has no external trend or
/// competitor feed (D-18/D-19 approved no such provider), so every suggestion
/// rests on something this workspace already owns, and the row says which. The
/// enum has no member meaning "the wider market", which is what stops the
/// product from implying one.
model Insight {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  campaignId String? @db.Uuid

  /// THE INSIGHT THIS ONE WAS GENERATED FROM.
  ///
  /// Today that is exactly one relationship: a `MONTHLY_PLAN` and the ACCEPTED
  /// `STRATEGY` it plans against. It exists because "grounded in the accepted
  /// strategy" was a sentence in a prompt and nothing else — the generated plan
  /// recorded no link at all, so nobody reading a plan afterwards could tell
  /// WHICH strategy it followed from, or whether that strategy had since been
  /// superseded.
  ///
  /// `SET NULL` rather than cascade: a plan outlives the proposal it came from,
  /// and deleting the strategy must not delete the month's work. The column is
  /// named explicitly in the migration (D-114), because a bare composite SET
  /// NULL would try to null `workspaceId` too.
  sourceInsightId String? @db.Uuid

  type   InsightType
  status InsightStatus @default(NEW)
  basis  InsightBasis

  /// Localized `{ ar, en }`.
  title Json
  /// The structured, localized body: claims, notable changes, anomalies and
  /// recommendations, each carrying the evidence ordinals it rests on.
  body  Json

  /// The window the insight is ABOUT, which is not when it was generated.
  periodStart           DateTime  @db.Timestamptz(6)
  periodEnd             DateTime  @db.Timestamptz(6)
  /// The comparison window, when the insight compared two periods.
  comparisonPeriodStart DateTime? @db.Timestamptz(6)
  comparisonPeriodEnd   DateTime? @db.Timestamptz(6)

  /// The gateway request that produced it — provenance and cost, exactly as a
  /// content draft carries. Null for an insight computed without a model call.
  aiRequestId String? @db.Uuid

  /// 0–1000 per mille, kept integer so no float reaches a comparison. Null when
  /// the insight is arithmetic rather than inference.
  confidenceMilli Int?

  generatedByUserId String?   @db.Uuid
  reviewedByUserId  String?   @db.Uuid
  reviewedAt        DateTime? @db.Timestamptz(6)
  reviewReason      String?

  /// Client idempotency key. A retried generation returns the first insight and
  /// makes no second gateway call.
  idempotencyKey String?

  /// D-116 / D-117 retention.
  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand           Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "insight_brand_fkey")
  campaign        Campaign? @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "insight_campaign_fkey")
  /// COMPOSITE AND SELF-REFERENTIAL (D-112): a plain key would resolve another
  /// workspace's insight, and "violates foreign key" versus "inserted" would
  /// answer whether that id exists across the tenant boundary.
  sourceInsight   Insight?  @relation("InsightProvenance", fields: [workspaceId, sourceInsightId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "insight_source_fkey")
  derivedInsights Insight[] @relation("InsightProvenance")

  evidence           InsightEvidence[]
  /// Phase 7 — the Brand Brain learnings this insight was drawn from.
  learningCandidates BrandKnowledgeCandidate[]

  @@unique([workspaceId, id], name: "insight_workspace_scope")
  @@unique([workspaceId, brandId, type, generatedByUserId, idempotencyKey])
  @@index([workspaceId, brandId, type, createdAt(sort: Desc)])
  @@index([workspaceId, brandId, status, createdAt(sort: Desc)])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, sourceInsightId])
  @@index([expiresAt])
  @@map("insight")
}

/// TENANT-OWNED, BRAND-SCOPED. ONE PIECE OF EVIDENCE BEHIND ONE INSIGHT.
///
/// STORED INDEPENDENTLY OF THE MODEL'S PROSE, and that separation is the whole
/// mechanism. The evidence package is built from the analytics query BEFORE any
/// model call; the model is given ordinals and may only cite them; the UI
/// renders every number from THIS row rather than from the sentence. So the
/// model cannot invent a figure — not because it was told not to, but because
/// there is no path by which a number it wrote reaches a screen.
///
/// A row is either a METRIC (pointing at the observation it came from), a
/// COMPARISON between two windows, a piece of BRAND KNOWLEDGE, a CONTENT
/// reference, or an ABSENCE — "nothing was published on this pillar in this
/// window", which is a fact about rows that are not there and cannot point at
/// one.
model InsightEvidence {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  insightId String @db.Uuid
  /// 1-based. THE HANDLE THE MODEL CITES — `e1`, `e2` — and the sort order the
  /// UI renders in.
  ordinal   Int

  kind EvidenceKind

  /// What it points at. Exactly one is set for METRIC / BRAND_KNOWLEDGE /
  /// CONTENT; an ABSENCE points at nothing, which is what it is.
  metricObservationId String? @db.Uuid
  knowledgeItemId     String? @db.Uuid
  contentItemId       String? @db.Uuid
  campaignId          String? @db.Uuid

  /// The measurement, copied onto the evidence row so the insight remains
  /// readable after retention prunes the observation it came from. A citation
  /// that stops resolving is a citation that stops being evidence.
  metricKey             String?
  value                 BigInt?
  /// The other side of a comparison, and the change between them in parts per
  /// mille. Both null unless `kind` is METRIC_COMPARISON.
  comparisonValue       BigInt?
  changeRatioMilli      Int?
  unit                  MetricUnit?
  granularity           MetricGranularity?
  periodStart           DateTime?          @db.Timestamptz(6)
  periodEnd             DateTime?          @db.Timestamptz(6)
  comparisonPeriodStart DateTime?          @db.Timestamptz(6)
  comparisonPeriodEnd   DateTime?          @db.Timestamptz(6)

  subjectType       MetricSubjectType?
  subjectExternalId String?
  provider          SocialProvider?
  observedAt        DateTime?          @db.Timestamptz(6)
  sourceKind        MetricSourceKind?

  /// A STABLE MACHINE CODE, never customer copy: `metric.total`,
  /// `metric.period_change`, `content.none_in_window`. The dashboard translates
  /// it, so the evidence line is bilingual without the model writing either
  /// language.
  labelKey String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand               @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "insight_evidence_brand_fkey")
  insight     Insight             @relation(fields: [workspaceId, insightId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "insight_evidence_insight_fkey")
  observation MetricObservation?  @relation(fields: [workspaceId, metricObservationId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "insight_evidence_observation_fkey")
  knowledge   BrandKnowledgeItem? @relation(fields: [workspaceId, knowledgeItemId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "insight_evidence_knowledge_fkey")
  item        ContentItem?        @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "insight_evidence_item_fkey")
  campaign    Campaign?           @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "insight_evidence_campaign_fkey")

  @@unique([workspaceId, insightId, ordinal])
  @@index([workspaceId, insightId])
  @@index([workspaceId, metricObservationId])
  @@map("insight_evidence")
}

/// TENANT-OWNED. ONE COPILOT CONVERSATION.
///
/// BRAND-SCOPED WITH A NULLABLE BRAND, and this is the one place in the phase
/// where null is right: a conversation begins before the person has said which
/// brand they mean, and a session forced to name one up front would have to
/// guess. Every TOOL CALL resolves and enforces a brand; the session is only
/// where the conversation happens.
model CopilotSession {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  brandId     String? @db.Uuid

  /// Whose conversation it is. A Copilot session is personal: another member of
  /// the same workspace does not read it, because it carries what this person
  /// asked and what they were shown.
  userId String @db.Uuid

  /// Which screen opened it — the `CopilotSurface` vocabulary the design system
  /// already declares. A string rather than an enum for the same reason
  /// `platformKey` is: the surface list grows with the product.
  surface String  @default("general")
  locale  Locale  @default(EN)
  title   String?

  /// WHAT THE PERSON WAS LOOKING AT when they opened the Copilot (Phase 6
  /// final, D-277 §37, D-280): a campaign, a content item or an insight. Both
  /// or neither — a CHECK enforces it. NO FOREIGN KEY, because the subject is
  /// one of three tables; the orchestrator ADMITS it at open (same workspace by
  /// RLS, same brand as the session, by query) and re-reads it on every turn,
  /// so a subject deleted since is simply absent rather than dangling. Its
  /// title reaches the model only inside the fenced untrusted block.
  subjectType String?
  subjectId   String? @db.Uuid

  lastMessageAt DateTime? @db.Timestamptz(6)
  archivedAt    DateTime? @db.Timestamptz(6)

  /// D-116 / D-117 retention.
  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "copilot_session_brand_fkey")

  messages  CopilotMessage[]
  plans     CopilotActionPlan[]
  toolCalls CopilotToolCall[]

  @@unique([workspaceId, id], name: "copilot_session_workspace_scope")
  @@index([workspaceId, userId, lastMessageAt(sort: Desc)])
  @@index([expiresAt])
  @@map("copilot_session")
}

/// TENANT-OWNED. ONE TURN OF A COPILOT CONVERSATION.
///
/// WHAT IS PERSISTED AND WHAT IS DELIBERATELY NOT. The customer's request, the
/// final customer-facing answer, and the plan the turn produced. NOT hidden
/// chain-of-thought, NOT a raw provider response, and NOT a tool's full result
/// payload — a tool result can carry a caption, a token-bearing URL or another
/// system's error text, and a conversation log is the last place any of that
/// should come to rest.
///
/// `body` IS NULLED BY THE RETENTION PURGE while the row survives, exactly as
/// `brand_brain_message.body` and `content_variant.body` are, so the shape of
/// the conversation and its accounting links outlive the words.
model CopilotMessage {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  sessionId String             @db.Uuid
  role      CopilotMessageRole

  /// CUSTOMER CONTENT. Nulled by the purge; `bodyPurgedAt` records that it was,
  /// so a purged turn is visibly purged rather than silently blank.
  body         String?
  bodyPurgedAt DateTime? @db.Timestamptz(6)

  /// The gateway request behind an assistant turn. Provenance and cost.
  aiRequestId String? @db.Uuid
  /// The plan this turn produced, when it produced one.
  planId      String? @db.Uuid

  /// Per-session client key, so a retried send never writes the turn twice.
  idempotencyKey String?

  /// Joins this turn to its plan, its tool calls and its audit events.
  correlationId String @db.Uuid

  expiresAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   CopilotSession     @relation(fields: [workspaceId, sessionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "copilot_message_session_fkey")
  plan      CopilotActionPlan? @relation(fields: [workspaceId, planId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "copilot_message_plan_fkey")

  @@unique([workspaceId, sessionId, idempotencyKey])
  @@index([workspaceId, sessionId, createdAt])
  @@index([expiresAt])
  @@map("copilot_message")
}

/// TENANT-OWNED. AN ACTION PLAN — what the Copilot proposes to do, shown before
/// anything is done, and the ONLY thing a confirmation can be bound to.
///
/// `planHash` IS THE BINDING. It is a sha256 over the CANONICAL steps — tool
/// keys, arguments, action classes, in order — so changing the plan changes the
/// hash, and a confirmation issued against the old hash no longer matches.
/// "Changing the plan invalidates the confirmation" is therefore arithmetic
/// rather than a rule somebody has to enforce.
///
/// `confirmationTokenHash` IS SINGLE-USE AND STORED HASHED, exactly as the OAuth
/// state is (D-141): the value that travels through the browser is never written
/// down, so a database read cannot be replayed as a confirmation. Single use is
/// enforced by a conditional UPDATE on `confirmedAt`, not by a read-then-write.
///
/// A PREVIEW IS NOT AUTHORIZATION. Nothing about this row grants anything:
/// permissions, brand scope and entitlements are resolved again, from the live
/// membership, at the moment each tool call executes.
model CopilotActionPlan {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  brandId     String? @db.Uuid

  sessionId String @db.Uuid
  /// The person the plan was built FOR, and the only person who may confirm it.
  userId    String @db.Uuid

  status CopilotPlanStatus @default(DRAFT)

  /// Monotonic within a session. A revised plan is a NEW ROW at the next
  /// version rather than an edit, so the thing a customer confirmed stays
  /// readable after they revised it.
  planVersion Int    @default(1)
  /// sha256 over the canonical steps. The confirmation binds to THIS value.
  planHash    String

  /// Localized `{ ar, en }` summary, and the typed step list the UI previews.
  /// Steps carry tool keys, redacted arguments and per-step previews — never a
  /// secret, never a token, never a raw provider payload.
  summary Json
  steps   Json

  /// The strictest class any step carries. `EXTERNAL_OR_DESTRUCTIVE` here means
  /// confirmation is mandatory and can never be configured away.
  highestActionClass   CopilotActionClass @default(READ_ONLY)
  requiresConfirmation Boolean            @default(true)

  /// What the AI work in this plan is estimated to cost, quoted through the
  /// gateway's own route resolution so the price shown is the price reserved.
  estimatedCreditsMilli BigInt @default(0)

  /// sha256 of the single-use confirmation secret. Unique platform-wide for the
  /// same reason `social_oauth_state.stateHash` is: two workspaces cannot
  /// collide and a replay across tenants cannot match either.
  confirmationTokenHash String?   @unique
  confirmationExpiresAt DateTime? @db.Timestamptz(6)
  confirmedAt           DateTime? @db.Timestamptz(6)
  confirmedByUserId     String?   @db.Uuid

  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  /// A stable machine code. Never a raw error.
  failureCode String?

  undoStatus      CopilotUndoStatus @default(NOT_APPLICABLE)
  undoExpiresAt   DateTime?         @db.Timestamptz(6)
  undoneAt        DateTime?         @db.Timestamptz(6)
  undoneByUserId  String?           @db.Uuid
  /// Why an undo was refused, as a machine code the UI translates.
  undoRefusedCode String?

  /// Joins plan → tool call → domain mutation → audit event.
  correlationId String @db.Uuid

  /// Client idempotency key. A retried creation returns the first plan.
  idempotencyKey String?

  expiresAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?         @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "copilot_plan_brand_fkey")
  session   CopilotSession @relation(fields: [workspaceId, sessionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "copilot_plan_session_fkey")

  toolCalls CopilotToolCall[]
  messages  CopilotMessage[]

  @@unique([workspaceId, id], name: "copilot_action_plan_workspace_scope")
  @@unique([workspaceId, sessionId, idempotencyKey])
  @@unique([workspaceId, sessionId, planVersion])
  @@index([workspaceId, sessionId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([expiresAt])
  @@map("copilot_action_plan")
}

/// TENANT-OWNED. ONE TOOL INVOCATION INSIDE ONE PLAN.
///
/// THE COPILOT IS AN ORCHESTRATOR, NOT A DATABASE SHORTCUT. Every row here
/// records a call into a domain service that performed its own authorization;
/// the model never holds a database handle, and `toolKey` is drawn from a closed
/// registry, so a tool nobody declared cannot be invoked by a model that invents
/// its name.
///
/// `compensation` IS AN EXPLICIT CONTRACT, not "run the opposite command and
/// hope": it records what to restore and the resource VERSION it was restored
/// from, so an undo that would overwrite somebody's later edit is refused with a
/// reason rather than silently winning.
model CopilotToolCall {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  planId    String @db.Uuid
  sessionId String @db.Uuid
  /// Position within the plan. Steps run in order and stop at the first
  /// failure, so a later step cannot act on a state an earlier one failed to
  /// reach.
  ordinal   Int

  /// From the closed registry in packages/copilot/src/tools.ts.
  toolKey     String
  actionClass CopilotActionClass
  status      CopilotToolCallStatus @default(PLANNED)

  /// The arguments, REDACTED and bounded. Ids and enum values; never a caption,
  /// never a credential, never a free-text prompt the customer typed.
  argumentsJson Json?
  /// Result METADATA only — counts, ids, a status. Never a provider payload and
  /// never generated content, which lives in the row the tool created.
  resultJson    Json?

  /// What it touched, so an audit reader can follow plan → call → row.
  resourceType          String?
  resourceId            String? @db.Uuid
  /// Optimistic-concurrency anchors for the undo.
  resourceVersionBefore Int?
  resourceVersionAfter  Int?

  /// How to take this back, when it can be taken back at all.
  compensation Json?

  /// A stable machine code. `permission_denied`, `brand_out_of_scope`,
  /// `entitlement_denied`, `insufficient_credits`, `not_found`.
  failureCode String?

  /// The gateway request this step spent, when it spent one.
  aiRequestId String? @db.Uuid

  /// Deterministic: hash(plan, ordinal, tool, arguments). UNIQUE per workspace,
  /// so a retried execution finds the completed call rather than running the
  /// tool a second time.
  idempotencyKey String

  startedAt  DateTime? @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  durationMs Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      CopilotActionPlan @relation(fields: [workspaceId, planId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "copilot_tool_call_plan_fkey")
  session   CopilotSession    @relation(fields: [workspaceId, sessionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "copilot_tool_call_session_fkey")

  @@unique([workspaceId, planId, ordinal])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, planId, ordinal])
  @@index([workspaceId, status])
  @@map("copilot_tool_call")
}

/// TENANT-OWNED, BRAND-SCOPED. ONE AUTOMATION RULE — docs/DATABASE.md §9.1.
///
/// `brandId` IS NOT NULL, for D-138's reason rather than by imitation: a rule
/// that acts on "every brand" is precisely the hole a brand-restricted member
/// would act through, and BrandScope has to be a query predicate (D-132/D-134).
///
/// A RULE STORES NO AUTHORITY. It records who created it and which brand it
/// acts on; whether that person may still do what it asks is re-resolved from
/// the LIVE membership on every run. A rule created by a Marketing Manager who
/// has since become a Viewer does nothing, and says so.
///
/// TRIGGER, CONDITION AND ACTION ARE CLOSED REGISTRIES. There is no customer
/// code, no expression language, no SQL, no webhook and no arbitrary URL — the
/// JSON columns hold PARAMETERS for a declared type, validated by a schema at
/// the boundary, never a program.
model AutomationRule {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  name        String
  description String?

  enabled Boolean @default(false)

  triggerType   AutomationTrigger
  /// Parameters for the trigger type. A schema validates it on write.
  triggerConfig Json              @default("{}")

  /// An ordered list of typed conditions, ALL of which must hold. Each is a
  /// declared comparison over a declared field — never an expression.
  conditions Json @default("[]")

  actionType   AutomationActionType
  actionConfig Json                 @default("{}")

  /// A ceiling per rule per day, from configuration. A runaway rule costs one
  /// day's ceiling rather than a workspace's credits.
  maxRunsPerDay Int @default(0)

  /// Always TRUE for an external action — a CHECK constraint enforces it, so it
  /// cannot be configured away by a future screen or a crafted payload.
  requiresConfirmationForExternal Boolean @default(true)

  createdByUserId String  @db.Uuid
  updatedByUserId String? @db.Uuid

  lastRunAt     DateTime?            @db.Timestamptz(6)
  lastRunStatus AutomationRunStatus?
  runCount      Int                  @default(0)

  /// THE THRESHOLD RULE'S OWN MEMORY OF WHICH SIDE THE METRIC IS ON.
  ///
  /// WHY IT IS DURABLE (R3-2). A crossing is a TRANSITION, and a transition
  /// cannot be read off a single sweep. Comparing the current rolling window
  /// against the previous adjacent one looks like edge detection and is not: a
  /// metric that climbs past the line and STAYS there keeps both comparisons
  /// true for as long as it stays, so every sweep sees a "crossing". Dedupe on
  /// the latest observation's id hides it only until the next reading arrives,
  /// and then fires again — which is the same alert a second time about the same
  /// event.
  ///
  /// So the rule remembers. `null` means NEVER EVALUATED: the first evaluation
  /// records the side and fires nothing, because a rule created while the metric
  /// is already past the line has not seen anything cross since somebody asked.
  thresholdBreached    Boolean?
  /// Incremented each time the metric returns to the non-triggered side. It is
  /// the identity of the current ARMING, and it is what the event's dedupe key
  /// is built from — so any number of sweeps inside one arming produce one
  /// event, and the next genuine crossing produces exactly one more.
  thresholdCycle       Int       @default(0)
  thresholdEvaluatedAt DateTime? @db.Timestamptz(6)

  /// WHEN THIS RULE IS NEXT WORTH LOOKING AT — the fair-work cursor (R4-2).
  ///
  /// WHAT IT FIXES. The two rule-derived producers asked "which enabled rules
  /// have this trigger?" and took the first `batch` rows, with no ordering and
  /// no durable marker. Unlike an outbox row, an EVALUATED RULE STAYS ELIGIBLE
  /// FOR THE IDENTICAL QUERY on the next minute — so once a platform held more
  /// than `batch` of them, PostgreSQL was free to hand back the same subset for
  /// ever and the rules outside it were never evaluated at all. For
  /// `SCHEDULED_TIME` that is not a delay: the customer's hour passes, and the
  /// occurrence is missed by design.
  ///
  /// SO EVERY RULE CARRIES ITS OWN NEXT-EVALUATION INSTANT, the producer takes
  /// the OLDEST ones, and parks each one it visits. That makes the enumeration a
  /// queue rather than an arbitrary window: every enabled rule reaches the front
  /// within `ceil(rules / batch)` passes, and a rule cannot hold the front
  /// because visiting it is what moves it to the back.
  ///
  /// NOT NULL, DELIBERATELY. `ORDER BY … ASC` puts NULLs LAST in PostgreSQL, so
  /// a nullable cursor would have sent every never-evaluated rule — a brand new
  /// one — to the back of the very queue that exists to reach it.
  nextEvaluationAt DateTime  @default(now()) @db.Timestamptz(6)
  /// Advisory, for operators: when a sweep last actually looked at this rule.
  lastEvaluatedAt  DateTime? @db.Timestamptz(6)

  /// Optimistic concurrency, for the same reason `campaign` carries one.
  version Int @default(1)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete (docs/DATABASE.md §2).
  deletedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "automation_rule_brand_fkey")

  runs   AutomationRun[]
  events AutomationEvent[]

  @@unique([workspaceId, id], name: "automation_rule_workspace_scope")
  @@unique([workspaceId, brandId, name])
  @@index([workspaceId, brandId, enabled])
  @@index([workspaceId, triggerType, enabled])
  /// THE PRODUCERS' OWN INDEX, and the only cross-tenant one on this table.
  /// The sweep asks a platform-wide question — which rules of this trigger are
  /// enabled and due — so its index cannot lead with `workspaceId`.
  @@index([triggerType, enabled, nextEvaluationAt])
  @@map("automation_rule")
}

/// TENANT-OWNED, BRAND-SCOPED. ONE EVALUATION OF ONE RULE — docs/DATABASE.md
/// §9.2.
///
/// `idempotencyKey` IS DERIVED FROM THE TRIGGER, NOT MINTED PER DELIVERY:
/// hash(rule, trigger type, the thing that triggered it, the bucket). A
/// duplicate delivery of the same event therefore finds the existing run and
/// produces no second action — which is the only way "every run is idempotent"
/// survives a queue that promises at-least-once.
///
/// AN EXTERNAL ACTION STOPS HERE, at `AWAITING_CONFIRMATION`, with a single-use
/// confirmation bound to this run. An automation is not a way around the
/// Copilot's confirmation boundary; it is the same boundary reached by a
/// different door.
model AutomationRun {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  ruleId String @db.Uuid

  status AutomationRunStatus @default(RUNNING)

  triggerType    AutomationTrigger
  /// What fired it, as a type and an id: a content item, a publish job, an
  /// insight, or nothing for a scheduled rule.
  triggerRefType String?
  triggerRefId   String?           @db.Uuid

  /// Derived. UNIQUE per workspace.
  idempotencyKey String

  /// Whether the conditions held. FALSE with status `SKIPPED` is a complete,
  /// successful evaluation — not an error.
  conditionsHeld Boolean?

  actionType   AutomationActionType
  /// Action METADATA only: what was created, how many, which id. Never content.
  actionResult Json?
  resourceType String?
  resourceId   String?              @db.Uuid

  /// The same single-use, hashed, plan-bound confirmation discipline the
  /// Copilot uses. Unique platform-wide.
  confirmationTokenHash String?   @unique
  confirmationExpiresAt DateTime? @db.Timestamptz(6)
  confirmedAt           DateTime? @db.Timestamptz(6)
  confirmedByUserId     String?   @db.Uuid

  /// A stable machine code, and a short redacted summary bounded by a CHECK.
  failureCode String?
  safeSummary String?

  correlationId String @db.Uuid

  startedAt  DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  durationMs Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand          @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "automation_run_brand_fkey")
  rule      AutomationRule @relation(fields: [workspaceId, ruleId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "automation_run_rule_fkey")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, ruleId, startedAt(sort: Desc)])
  @@index([workspaceId, brandId, status])
  @@index([startedAt])
  @@map("automation_run")
}

/// TENANT-OWNED. THE AUTOMATION OUTBOX — one row per domain event worth
/// evaluating rules against.
///
/// WHY AN OUTBOX AND NOT A DIRECT ENQUEUE (A1). Before this existed, the worker
/// held a complete `automation.evaluate` consumer and NOTHING IN THE PLATFORM
/// EVER ENQUEUED ONE. A customer could author a rule on `CONTENT_APPROVED` and
/// it would never fire, with nothing anywhere saying so — a feature that exists
/// in the UI and not in the product.
///
/// The obvious repair is to call `enqueue` at each domain site, and it is the
/// wrong one twice over. It puts a Redis round trip on the request path of an
/// approval, and when that round trip fails the choice is between failing the
/// approval and losing the event silently. Neither is acceptable.
///
/// SO THE EVENT IS A ROW, WRITTEN IN THE DOMAIN'S OWN TRANSACTION. It commits
/// with the approval or not at all, which is the only way an event is neither
/// lost nor invented. Dispatch is the SWEEP's job (docs/ARCHITECTURE.md §9:
/// "delayed jobs are an optimization; a reconciliation sweeper every minute
/// finds work that is due and unclaimed, so a lost Redis state degrades
/// punctuality, not correctness"). No domain package imports the queue.
///
/// `dedupeKey` IS THE IDENTITY OF THE DOMAIN EVENT, not of the attempt: the
/// approval of item X is one event however many times the sweep looks at it, and
/// `@@unique([workspaceId, dedupeKey])` is what makes the timed producers — which
/// re-derive the same occurrence every minute — write exactly one row per
/// occurrence rather than sixty.
model AutomationEvent {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  /// NON-NULL, because `AutomationEngine.deliver` selects rules BY BRAND. An
  /// event with no brand could match no rule, so it would be a row that exists
  /// only to be swept for ever.
  brandId     String @db.Uuid

  triggerType AutomationTrigger

  /// What fired it, exactly as the trigger registry declares it. A producer that
  /// writes the wrong pair aims a content action at an id that is not a content
  /// item's, which is why `automation_event_ref_matches_trigger` is a CHECK and
  /// not a convention.
  refType String?
  refId   String? @db.Uuid

  /// WHICH RULE THIS EVENT IS ADDRESSED TO, for the two triggers whose identity
  /// lives on the rule rather than on a domain row.
  ///
  /// A domain event — an approval, a publish — belongs to the BRAND and every
  /// rule listening for it should see it, so `ruleId` is NULL there. A timed
  /// occurrence and a threshold crossing are different: both are computed FROM a
  /// rule's own configuration, so an event derived from rule A must not be
  /// delivered to rule B, whose schedule or threshold says something else
  /// entirely. `AutomationEngine.deliver` narrows to this rule when it is set.
  ruleId String? @db.Uuid

  /// The occurrence a timed rule fired FOR, in the workspace's own zone
  /// (`YYYY-MM-DDTHH`). It is the run's bucket (P7-R5): carried rather than
  /// recomputed, so a delivery that slips across the hour boundary still
  /// converges on the occurrence it was created for instead of becoming a second
  /// run of the same schedule.
  occurrence String?

  /// The identity of the EVENT. Derived by the producer, never client-supplied.
  dedupeKey String

  /// When a queue message was accepted for this row. Advisory: a dispatch that
  /// was accepted and then lost is re-dispatched by the sweep after
  /// `dispatchRetryAfter`, because only `deliveredAt` proves the work happened.
  dispatchedAt DateTime? @db.Timestamptz(6)
  /// When the worker finished delivering it to every listening rule. THE ONLY
  /// FIELD THAT RETIRES A ROW.
  deliveredAt  DateTime? @db.Timestamptz(6)
  /// How many times it has been dispatched, so a poison event is visible rather
  /// than merely quiet.
  attempts     Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand           @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "automation_event_brand_fkey")
  rule      AutomationRule? @relation(fields: [workspaceId, ruleId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "automation_event_rule_fkey")

  @@unique([workspaceId, id], name: "automation_event_workspace_scope")
  @@unique([workspaceId, dedupeKey])
  /// THE SWEEP'S INDEX. Undelivered rows, oldest first, across every tenant.
  @@index([deliveredAt, createdAt])
  @@index([workspaceId, brandId, triggerType])
  @@map("automation_event")
}

// ===========================================================================
// PHASE 9 — COMMERCE & ONBOARDING
//
// docs/BILLING-AND-CREDITS.md, docs/SECURITY.md §38.
//
// THE DOMAIN MODEL IS OURS. A payment provider moves money and holds the PCI
// scope; it does not own our commercial truth. Every model below is a
// BrandSpace record that happens to carry a provider REFERENCE, and no
// entitlement, invoice total or credit grant is ever resolved by asking a
// provider what it thinks. D-204 leaves the production vendor unchosen: nothing
// here names one.
//
// EXACT MONEY, EVERYWHERE. Amounts are integer minor units in `BigInt`, and
// every monetary row carries BOTH its ISO currency and that currency's
// `minorUnitDigits` at the moment the row was written. The scale is stored
// rather than looked up because a catalogue edit must not retroactively change
// what an issued invoice says: 1000 is 10.00 SAR and 1.000 KWD, and an invoice
// is a historical fact.
// ===========================================================================

/// Why a hosted checkout session was opened.
enum CheckoutPurpose {
  /// Starting or changing a paid subscription.
  SUBSCRIPTION
  /// A one-time prepaid credit pack (D-196 — never an overage settlement).
  CREDIT_PACK
}

enum CheckoutSessionStatus {
  /// Created with the provider; the customer has not finished.
  PENDING
  /// An authoritative provider event confirmed payment and it was reconciled.
  COMPLETED
  /// The customer abandoned it, or the provider reported a cancellation.
  CANCELLED
  /// Its window closed before anything authoritative arrived.
  EXPIRED
}

enum InvoiceStatus {
  /// Being assembled. Has no number yet and is not a commercial document.
  DRAFT
  /// Issued and awaiting payment. Numbered, immutable.
  OPEN
  PAID
  /// Cancelled before payment. Corrections after payment are credit notes.
  VOID
  UNCOLLECTIBLE
}

/// How tax was applied to an invoice, copied from the market's policy at issue.
enum InvoiceTaxMode {
  NONE
  EXCLUSIVE
  INCLUSIVE
}

enum InvoiceLineKind {
  SUBSCRIPTION
  CREDIT_PACK
  PRORATION
  SEAT
  ADDON
  DISCOUNT
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  /// The money actually moved back through the provider.
  REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CreditPackPurchaseStatus {
  /// Checkout opened; nothing has been granted and nothing has been charged.
  PENDING
  /// Paid AND reconciled AND granted. The only status that implies credits.
  COMPLETED
  FAILED
  REFUNDED
}

/// How far a received provider event has got.
enum BillingEventStatus {
  RECEIVED
  /// CLAIMED BY A DELIVERY THAT IS APPLYING IT RIGHT NOW. The settlement runs
  /// outside the inbox row's own transaction, so the claim — not a database
  /// lock — is what stops two deliveries of one event applying it twice
  /// (D-221). A claim carries a token and a lease; a holder that dies leaves a
  /// claim that expires rather than a row stuck here for ever.
  PROCESSING
  PROCESSED
  /// Applied earlier; this delivery changed nothing (§28 — replays are no-ops).
  DUPLICATE
  /// Older than the state it describes. Recorded, deliberately not applied.
  STALE
  /// Could not be tied to a workspace through a trusted stored relationship.
  UNRESOLVED
  /// TERMINAL, AND DETERMINISTIC. The amount or currency does not match our own
  /// row (§20), so every redelivery would reach the same answer. Not applied,
  /// audited CRITICAL, and never retried.
  FAILED
  /// TRANSIENT. The apply threw something that is not a decision about the
  /// money — a lost connection, a deadlock, a timeout. Nothing was applied,
  /// because the settlement is atomic, so a later delivery must re-apply it.
  RETRYABLE
  /// RETRIES EXHAUSTED. The dead-letter state: an operator has to look. Reached
  /// only after `maxAttempts` transient failures, and audited CRITICAL so the
  /// alert exists rather than being inferred from a row nobody reads.
  DEAD_LETTER
}

/// TENANT-OWNED. The workspace's commercial identity and its provider reference.
///
/// THE TRUSTED SIDE OF EVERY WEBHOOK. `providerKey` + `providerCustomerId` is
/// the ONLY mapping from a provider's world back to a workspace, and it is
/// written by us when we create the customer — never from event metadata. A
/// webhook that names a workspace is not believed; it is looked up here
/// (docs/SECURITY.md §38.3, §28 of the Phase 9 brief).
model BillingProfile {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid

  /// The billing contact. Separate from the owner's login: finance is not always
  /// the person who signed up.
  billingEmail String
  legalName    String?
  /// What the market's tax policy calls it; the policy decides whether it is
  /// required. Never validated against a jurisdiction rule in code (§32).
  taxId        String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  /// ISO 3166-1 alpha-2. Defaults to the workspace's own country at creation and
  /// may then differ — a company can be billed somewhere it does not operate.
  country      String  @db.Char(2)

  /// The adapter that serves this workspace, resolved from `commerce`
  /// providerRouting. NOT a credential and NOT a secret — see the schema note.
  providerKey        String?
  /// The provider's own id for this customer. Opaque to us.
  providerCustomerId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checkoutSessions CheckoutSession[]
  invoices         Invoice[]

  /// THE REVERSE LOOKUP A WEBHOOK USES. Unique so one provider customer can
  /// never map to two workspaces, which would make the resolution ambiguous at
  /// exactly the moment money is involved.
  @@unique([providerKey, providerCustomerId])
  @@unique([workspaceId, id], name: "billing_profile_workspace_scope")
  @@map("billing_profile")
}

/// TENANT-OWNED. One hosted checkout, with the amount WE calculated.
///
/// THE AMOUNT IS NOT ACCEPTED FROM THE BROWSER. A request names a plan or a
/// pack; the price is resolved server-side from activated configuration and
/// written here before the provider is called. Reconciliation then compares the
/// provider's amount against THIS row (§37), so a customer who edits a form
/// cannot buy anything at a price the owner did not set.
model CheckoutSession {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  purpose CheckoutPurpose
  status  CheckoutSessionStatus @default(PENDING)

  /// Exactly one of these is set, enforced by a CHECK.
  planKey         String?
  billingInterval BillingInterval?
  packKey         String?

  /// The agreed amount, in minor units of `currency` at `currencyScale`.
  currency      String @db.Char(3)
  currencyScale Int
  amountMinor   BigInt
  /// The tax the market's policy implies, computed at creation for display.
  taxMinor      BigInt @default(0)
  totalMinor    BigInt

  /// Which `plans` / `commerce` versions the amount came from, so the agreed
  /// terms can be proven later even after the catalogue moves on (§25).
  planVersionId     String? @db.Uuid
  commerceVersionId String? @db.Uuid

  providerKey       String
  /// The provider's session id. Opaque, and never an authorization boundary.
  providerSessionId String?
  /// Where the provider sends the browser back. Navigation only — never money.
  returnUrl         String?

  /// The caller's own key, so a double-submitted form opens ONE session.
  idempotencyKey String

  expiresAt   DateTime  @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  createdByUserId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingProfile BillingProfile      @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade, map: "checkout_session_profile_fkey")
  invoice        Invoice?
  purchase       CreditPackPurchase?
  attempts       PaymentAttempt[]

  @@unique([workspaceId, idempotencyKey])
  @@unique([providerKey, providerSessionId])
  @@unique([workspaceId, id], name: "checkout_session_workspace_scope")
  @@index([workspaceId, status])
  @@index([status, expiresAt])
  @@map("checkout_session")
}

/// TENANT-OWNED. A BrandSpace invoice — our record, not a mirror of a provider's.
///
/// IMMUTABLE ONCE ISSUED. A correction is a credit note, never an edit
/// (docs/BILLING-AND-CREDITS.md §4). The snapshots exist so an invoice from last
/// year still renders exactly as it was agreed, however much the catalogue or
/// the workspace's own details have changed since (§25).
model Invoice {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  /// Allocated from a platform-owned sequence at ISSUE, never at creation, so a
  /// draft that is discarded does not burn a number. Globally unique: it is the
  /// seller's own accounting series.
  number String? @unique

  status InvoiceStatus @default(DRAFT)

  currency      String @db.Char(3)
  currencyScale Int

  subtotalMinor   BigInt
  discountMinor   BigInt @default(0)
  taxMinor        BigInt @default(0)
  totalMinor      BigInt
  amountPaidMinor BigInt @default(0)
  /// Credited back by credit notes. `total - credited` is what stands.
  creditedMinor   BigInt @default(0)

  taxMode            InvoiceTaxMode @default(NONE)
  taxRateBasisPoints Int            @default(0)
  /// The market's policy key at issue, so the rule can be explained later.
  taxPolicyKey       String?

  periodStart DateTime? @db.Timestamptz(6)
  periodEnd   DateTime? @db.Timestamptz(6)

  issuedAt DateTime? @db.Timestamptz(6)
  dueAt    DateTime? @db.Timestamptz(6)
  paidAt   DateTime? @db.Timestamptz(6)
  voidedAt DateTime? @db.Timestamptz(6)

  /// WHAT THE CUSTOMER AGREED TO, frozen. Plan key, pinned price, interval and
  /// the configuration version it came from.
  commercialSnapshot Json
  /// Seller and buyer identity as printed. A later address change does not
  /// rewrite an issued document.
  partiesSnapshot    Json

  providerKey       String?
  providerInvoiceId String?
  providerPaymentId String?

  checkoutSessionId String? @unique @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingProfile BillingProfile      @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade, map: "invoice_profile_fkey")
  checkout       CheckoutSession?    @relation(fields: [workspaceId, checkoutSessionId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "invoice_checkout_fkey")
  lines          InvoiceLine[]
  creditNotes    CreditNote[]
  purchase       CreditPackPurchase?
  attempts       PaymentAttempt[]

  @@unique([workspaceId, id], name: "invoice_workspace_scope")
  /// Composite uniques for the workspace-scoped one-to-one relations. The plain
  /// `@unique` above each column already forbids reuse; these are what let the
  /// relation carry `workspaceId` so a foreign key can never cross a tenant
  /// (D-112).
  @@unique([workspaceId, checkoutSessionId])
  @@index([workspaceId, status, issuedAt])
  @@index([workspaceId, createdAt])
  @@map("invoice")
}

/// TENANT-OWNED. One explicit line. Never a total the reader has to trust.
model InvoiceLine {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  invoiceId   String @db.Uuid

  kind InvoiceLineKind

  /// Localized at WRITE time, in both languages, so the PDF can be produced in
  /// either without re-deriving a description from a catalogue that has moved on.
  description Json

  quantity        Int    @default(1)
  unitAmountMinor BigInt
  amountMinor     BigInt
  taxAmountMinor  BigInt @default(0)

  /// Free-form provenance — plan key, pack key, proration window. Never a price.
  metadata Json?

  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "invoice_line_invoice_fkey")

  @@unique([workspaceId, id], name: "invoice_line_workspace_scope")
  @@index([workspaceId, invoiceId, sortOrder])
  @@map("invoice_line")
}

/// TENANT-OWNED. A correction to an issued invoice. Never an edit of one.
model CreditNote {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  invoiceId   String @db.Uuid

  number String?          @unique
  status CreditNoteStatus @default(DRAFT)

  /// THE SAME CURRENCY AS ITS INVOICE, enforced by a CHECK against the parent.
  /// A credit note in another currency would be a conversion nobody agreed to.
  currency      String @db.Char(3)
  currencyScale Int

  subtotalMinor BigInt
  taxMinor      BigInt @default(0)
  totalMinor    BigInt

  /// Operator text. Required: a refund without a stated reason is not auditable.
  reason String

  issuedAt   DateTime? @db.Timestamptz(6)
  refundedAt DateTime? @db.Timestamptz(6)

  providerRefundId String?
  /// One refund per logical request, however many times it is retried.
  idempotencyKey   String

  createdByUserId         String? @db.Uuid
  createdByPlatformUserId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice          @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "credit_note_invoice_fkey")
  lines     CreditNoteLine[]

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, id], name: "credit_note_workspace_scope")
  @@index([workspaceId, invoiceId])
  @@map("credit_note")
}

/// TENANT-OWNED. One line of a credit note, mirroring the invoice line it reverses.
model CreditNoteLine {
  id           String @id @default(uuid()) @db.Uuid
  workspaceId  String @db.Uuid
  creditNoteId String @db.Uuid

  /// Which invoice line this reverses, when it reverses one specifically.
  invoiceLineId String? @db.Uuid

  description    Json
  quantity       Int    @default(1)
  amountMinor    BigInt
  taxAmountMinor BigInt @default(0)

  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creditNote CreditNote @relation(fields: [workspaceId, creditNoteId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "credit_note_line_note_fkey")

  @@unique([workspaceId, id], name: "credit_note_line_workspace_scope")
  @@index([workspaceId, creditNoteId, sortOrder])
  @@map("credit_note_line")
}

/// TENANT-OWNED. One attempt to collect money, successful or not.
///
/// THE DUNNING TRAIL. A failure here is what starts the retry schedule, and the
/// attempt count is what the grace period is measured against — so "we tried
/// four times" is a queryable fact rather than a worker's memory.
model PaymentAttempt {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  invoiceId         String? @db.Uuid
  checkoutSessionId String? @db.Uuid

  status PaymentAttemptStatus @default(PENDING)

  currency      String @db.Char(3)
  currencyScale Int
  amountMinor   BigInt

  /// A stable provider-independent reason — `card_declined`, `expired`. Never a
  /// raw provider message, which could carry PII into our logs.
  failureCode   String?
  attemptNumber Int     @default(1)

  providerPaymentId String?
  /// One attempt per logical retry, so a worker that runs twice charges once.
  idempotencyKey    String

  attemptedAt DateTime  @default(now()) @db.Timestamptz(6)
  settledAt   DateTime? @db.Timestamptz(6)
  /// When the dunning policy says to try again. Null once terminal.
  nextRetryAt DateTime? @db.Timestamptz(6)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice?         @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "payment_attempt_invoice_fkey")
  checkout  CheckoutSession? @relation(fields: [workspaceId, checkoutSessionId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "payment_attempt_checkout_fkey")

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, id], name: "payment_attempt_workspace_scope")
  @@index([workspaceId, invoiceId])
  @@index([status, nextRetryAt])
  @@map("payment_attempt")
}

/// TENANT-OWNED. One prepaid credit-pack purchase and the ONE grant it made.
///
/// `creditGrantId` IS THE IDEMPOTENCY PROOF. A pack grants credits exactly once
/// because this column is unique and is set in the same transaction as the
/// ledger grant: a replayed webhook finds it already set and does nothing
/// (§37). There is no path here that adds credits without a completed purchase,
/// which is what "prepaid, never postpaid" means in the schema (D-196).
model CreditPackPurchase {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  packKey String
  /// Whole credits, copied from the pack at purchase so a catalogue edit cannot
  /// change what was bought.
  credits Int

  currency      String @db.Char(3)
  currencyScale Int
  amountMinor   BigInt

  status CreditPackPurchaseStatus @default(PENDING)

  checkoutSessionId String? @unique @db.Uuid
  invoiceId         String? @unique @db.Uuid
  /// The single immutable ledger grant this purchase produced.
  creditGrantId     String? @unique @db.Uuid

  providerPaymentId String?

  completedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checkout  CheckoutSession? @relation(fields: [workspaceId, checkoutSessionId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "credit_pack_purchase_checkout_fkey")
  invoice   Invoice?         @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "credit_pack_purchase_invoice_fkey")

  @@unique([workspaceId, id], name: "credit_pack_purchase_workspace_scope")
  @@unique([workspaceId, checkoutSessionId])
  @@unique([workspaceId, invoiceId])
  @@index([workspaceId, status])
  @@map("credit_pack_purchase")
}

/// PLATFORM-OWNED. The webhook inbox — every provider event we have received.
///
/// WHY IT IS NOT TENANT-OWNED. An event arrives before we know whose it is. The
/// workspace is DERIVED here, by looking `providerCustomerId` up in
/// `billing_profile`; it is never read from the event body. A row that cannot
/// be resolved is kept as `UNRESOLVED` rather than guessed at or dropped, so a
/// misconfiguration is visible instead of silently losing money.
///
/// The tenant role has no access to this table at all: one workspace must not
/// be able to count another's payment events.
model BillingEvent {
  id String @id @default(uuid()) @db.Uuid

  providerKey     String
  /// The provider's own event id. THE IDEMPOTENCY KEY: a replay of a delivered
  /// event collides here and changes nothing (§28).
  externalEventId String

  eventType  String
  /// The provider's own timestamp. Ordering is compared against this, so an
  /// out-of-order delivery is recognised as stale rather than applied.
  occurredAt DateTime @db.Timestamptz(6)

  /// Verified BEFORE the body was parsed. A row can only exist if it was true.
  signatureVerified Boolean @default(false)

  /// The normalized event. Provider-shaped fields are not stored raw beyond
  /// what reconciliation needs, and no card data can appear: hosted checkout
  /// means we never receive any.
  payload Json

  status              BillingEventStatus @default(RECEIVED)
  /// Resolved from a TRUSTED stored relationship, or null.
  resolvedWorkspaceId String?            @db.Uuid
  failureReason       String?
  attempts            Int                @default(0)

  /// THE PROCESSING CLAIM (D-221). Set together with `status = PROCESSING` by a
  /// conditional UPDATE that exactly one concurrent delivery can win. The token
  /// is what makes the claim's OWNER identifiable: a delivery writes its final
  /// status only while its own token is still on the row, so a late writer
  /// whose lease expired and was taken over cannot overwrite the winner.
  claimToken String?   @db.Uuid
  /// When the current claim was taken. A claim older than the lease is assumed
  /// to belong to a process that died and may be taken over.
  claimedAt  DateTime? @db.Timestamptz(6)

  receivedAt  DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)

  @@unique([providerKey, externalEventId])
  @@index([status, receivedAt])
  @@index([resolvedWorkspaceId, occurredAt])
  /// Finding a stuck claim, and listing the dead-letter queue for an operator.
  @@index([status, claimedAt])
  @@map("billing_event")
}

/// PLATFORM-OWNED. The seller's invoice-number series.
///
/// ONE ROW PER PREFIX AND YEAR, advanced by `app.allocate_invoice_number()`,
/// which only the platform role may execute. The tenant role has no privilege on
/// this table and no EXECUTE on the function: issuing an invoice is a SYSTEM act
/// in response to an authoritative provider event, never a customer action. The
/// function takes a row lock inside the caller's transaction, so two simultaneous
/// issues get two different numbers (§30).
///
/// A DATABASE SEQUENCE WOULD NOT DO. Sequences are not transactional: a rolled
/// back issue would leave a permanent gap in an accounting series that is
/// legally expected to be gapless in several of the markets this platform sells
/// in.
model InvoiceNumberSequence {
  prefix String
  year   Int

  lastValue Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([prefix, year])
  @@map("invoice_number_sequence")
}

/// A single-use, expiring email verification token.
///
/// Modelled on `PasswordResetToken` and classified with it: it belongs to a
/// global identity, not to a workspace — a person verifies their email BEFORE
/// any workspace exists. Only the SHA-256 hash is stored; the raw token exists
/// solely in the emailed link and is never logged, traced or persisted.
model EmailVerificationToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique

  expiresAt DateTime  @db.Timestamptz(6)
  /// Set by a conditional UPDATE, so a replayed link verifies nothing twice.
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  ip String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_token")
}

/// Which version of which legal document a person accepted, and when.
///
/// VERSIONED, because "they agreed to the terms" is not a fact unless it says
/// WHICH terms. Kept per user rather than per workspace: the person accepts,
/// not the company.
model UserLegalAcceptance {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// `terms-of-service`, `privacy-policy`. A key, so documents are configuration.
  documentKey String
  /// The version string as published. Free text: a date, a semver, a hash.
  version     String

  acceptedAt DateTime @default(now()) @db.Timestamptz(6)
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentKey, version])
  @@index([userId])
  @@map("user_legal_acceptance")
}

/// A customer's MFA recovery code — the hash of one, used once.
///
/// The mirror of `PlatformMfaRecoveryCode` for the customer realm, and
/// deliberately a separate table: the two realms never share a session, a
/// credential or a recovery path (docs/SECURITY.md §3).
/// Abuse ceilings for the authentication surface — Phase 4, F-19.
///
/// NOT TENANT-OWNED AND NOT PLATFORM-OWNED. Sign-in, signup and password reset
/// all happen before any workspace exists, and the CUSTOMER application is what
/// performs them, so the tenant role must be able to count them. The policy is
/// the same one `customer_session` carries: reachable only with NO workspace
/// context, so inside a workspace this table is empty for the tenant role.
///
/// THE SUBJECT IS A HASH, never an address or an email. The limiter only ever
/// asks whether two attempts belong together, which equality of hashes answers
/// exactly as well — and a dump of this table then discloses neither who has an
/// account nor where they connect from.
model AuthRateLimit {
  id String @id @default(uuid()) @db.Uuid

  /// What is being limited: `signin:ip`, `signin:account`, `signup:ip`, …
  scope String

  /// SHA-256 of the source address or the lower-cased address being targeted.
  subjectHash String

  /// The start of the fixed window this row counts. Part of the unique key, so
  /// a new window is a new row rather than a read-modify-write of an old one.
  windowStart DateTime @db.Timestamptz(6)
  windowEnd   DateTime @db.Timestamptz(6)

  count Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([scope, subjectHash, windowStart])
  /// The sweep that discards expired windows reads this.
  @@index([windowEnd])
  @@map("auth_rate_limit")
}

model UserMfaRecoveryCode {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// SHA-256 of the code. The plaintext is shown once at enrolment and never
  /// stored, logged or recoverable — the same rule as the TOTP secret itself.
  codeHash String

  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("user_mfa_recovery_code")
}

// ============================================================================
// PHASE 10 — INTEGRATIONS
// ============================================================================

enum IntegrationCheckOutcome {
  /// The provider answered and the answer was good.
  OK
  /// The provider answered and refused, or answered wrongly.
  FAILED
  /// Nothing was attempted: configuration is incomplete.
  NOT_CONFIGURED
  /// The attempt was refused before it left BrandSpace — a development
  /// provider in production, an adapter that does not exist.
  REFUSED
}

/// PLATFORM-OWNED. What happened the last time we talked to a provider.
///
/// WHY THIS IS A TABLE AND NOT CONFIGURATION. Which provider is configured, with
/// which settings and which credential references, is CONFIGURATION — versioned,
/// validated, activatable and rollback-able, and it stays in the configuration
/// service where Phase 2A put it. What this table holds is the opposite kind of
/// fact: an OBSERVATION. "The credential worked at 14:02" is not a setting
/// somebody chose, it is something that happened, and versioning it alongside
/// the settings would make every health check a configuration change.
///
/// So: the Integrations Hub reads the settings from configuration and the status
/// from here, and neither is a second copy of the other (§2).
///
/// THE TENANT ROLE HAS NO ACCESS. A row names a platform credential reference
/// and whether it works, which is BrandSpace's own operational state. One
/// workspace being able to count our provider failures would be a disclosure in
/// itself, so the policy admits only `brandspace_platform`.
///
/// NO SECRET IS IN HERE. `message` is written by the adapter for an operator to
/// read and is required to be free of credentials and raw provider errors; the
/// redaction layer runs over it as well, because a rule enforced only by a
/// comment is enforced by nobody.
model IntegrationHealthCheck {
  id String @id @default(uuid()) @db.Uuid

  /// The registry category — `ai`, `payment`, `email`, `storage`, `social`,
  /// `observability`. A plain string rather than an enum because the registry
  /// in `@brandspace/integrations` owns that vocabulary and a migration should
  /// not be needed to add a category.
  category    String
  providerKey String
  environment DeploymentEnvironment

  outcome   IntegrationCheckOutcome
  latencyMs Int?
  /// Operator-facing, safe to display. Never a credential, never a raw error.
  message   String

  /// Which platform user asked, or null when a readiness probe did.
  requestedByPlatformUserId String? @db.Uuid

  checkedAt DateTime @default(now()) @db.Timestamptz(6)

  requestedBy PlatformUser? @relation(fields: [requestedByPlatformUserId], references: [id], onDelete: SetNull)

  /// The Hub asks one question constantly: "what is the latest result for this
  /// provider in this environment?" This index is that question.
  /// NAMED EXPLICITLY, because the generated name would be truncated to
  /// `integration_health_check_category_providerKey_environment_c_idx` and the
  /// migration writes a readable one. A name that differs between the schema
  /// and the migration is drift, and the drift check is how it was found.
  @@index([category, providerKey, environment, checkedAt(sort: Desc)], map: "integration_health_check_lookup_idx")
  @@index([checkedAt])
  @@map("integration_health_check")
}

// ---------------------------------------------------------------------------
// PHASE 6 — CONTEXTUAL COLLABORATION (P6-05)
//
// The one genuinely new tenant-owned capability in Phase 6. Everything else the
// phase touches already had a domain behind it.
//
// NOTES ARE NOT BRAND BRAIN KNOWLEDGE, AND THE SEPARATION IS STRUCTURAL RATHER
// THAN A CONVENTION SOMEBODY HAS TO REMEMBER. There is no foreign key from a
// note into `BrandKnowledgeItem`, no shared table, and no write path from one to
// the other anywhere in the product. A note is what a colleague said about a
// piece of work; brand knowledge is what the brand has decided is true, carries
// provenance and an authority level, and governs what every AI surface
// generates. Letting a passing remark become governed memory — silently, because
// it was typed into the same screen — is exactly the failure the four-layer
// model with its HUMAN > DOCUMENT > AI_INFERRED precedence exists to prevent.
// If a note SHOULD become knowledge, a person promotes it deliberately through
// Brand Brain's own review, where it arrives with provenance saying where it
// came from.
// ---------------------------------------------------------------------------

/// What a thread is attached to.
///
/// A DISCRIMINATOR BESIDE REAL FOREIGN KEYS, not instead of them. A single
/// polymorphic `subjectId` with no constraint would have been less schema and
/// would have left the database unable to tell a live subject from a deleted
/// one — orphan threads accumulating against content nobody can open, and no
/// cascade to clean them up. Each subject the product supports gets a nullable
/// FK and a CHECK that exactly the right one is set.
///
/// It is an enum so that adding a subject is a migration with a constraint
/// change, which is the point at which somebody has to decide what deleting
/// that subject does to its conversation.
enum NoteSubjectType {
  /// A draft, a variant, a piece of work in the Content Studio.
  CONTENT_ITEM
  /// A campaign, as a project room.
  CAMPAIGN
  /// The brand itself — for conversations that are not about one artefact.
  BRAND
  /// A file in the Asset Library (Phase 6 final, D-277 §28, D-281).
  ASSET
}

enum NoteThreadStatus {
  OPEN
  RESOLVED
}

/// How much a conversation matters (D-277 §28, D-281): Normal or Important and
/// nothing more — not a priority scale, not a task status. A scale nobody
/// applies consistently orders nothing.
enum NoteImportance {
  NORMAL
  IMPORTANT
}

/// TENANT-OWNED, BRAND-SCOPED. One conversation about one thing.
///
/// THE THREAD CARRIES THE STATE AND THE NOTES CARRY THE WORDS. Resolve/reopen,
/// assignment and the subject belong to the conversation, not to whichever
/// message happened to be first — a design where the first note owns the thread
/// makes deleting it either impossible or destructive.
model NoteThread {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  /// The brand this conversation belongs to.
  ///
  /// ALWAYS SET, including when the subject is a content item or a campaign,
  /// because brand scope is how a member's visibility is filtered everywhere
  /// else in the product (`brandIdScopeFilter`). Deriving it by joining to the
  /// subject on every read would make the most common query a join and would
  /// put the scoping rule in the query rather than in the row.
  brandId String @db.Uuid

  subjectType NoteSubjectType

  /// Exactly one of these is set, matching `subjectType` — enforced by a CHECK
  /// constraint in the migration, not by hope. When the subject is the BRAND
  /// itself both are null and `brandId` is the subject.
  contentItemId String? @db.Uuid
  campaignId    String? @db.Uuid
  /// D-281. The asset this conversation is about. A workspace-shared asset
  /// (`brandId` NULL) is discussed within ONE brand — the thread's — and a
  /// brand's own asset only within that brand; the `note_thread_asset_scope`
  /// trigger refuses anything else.
  assetId       String? @db.Uuid

  status NoteThreadStatus @default(OPEN)

  /// D-281. When the conversation needs an answer by — optional, and a date
  /// rather than a workflow: there is no overdue state machine behind it.
  dueAt      DateTime?      @db.Timestamptz(6)
  importance NoteImportance @default(NORMAL)

  createdByUserId  String  @db.Uuid
  /// Who this is waiting on, when it is waiting on somebody in particular.
  ///
  /// OPTIONAL BECAUSE MOST COMMENTS ARE NOT TASKS. A thread that must always
  /// name an assignee turns every passing remark into somebody's to-do list.
  assignedToUserId String? @db.Uuid

  resolvedAt       DateTime? @db.Timestamptz(6)
  resolvedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand        @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "note_thread_brand_fkey")
  contentItem ContentItem? @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "note_thread_content_item_fkey")
  campaign    Campaign?    @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "note_thread_campaign_fkey")
  asset       Asset?       @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "note_thread_asset_fkey")
  notes       Note[]

  @@unique([workspaceId, id], name: "note_thread_workspace_scope")
  /// The subject's own conversation list, which is the most common read.
  @@index([workspaceId, brandId, subjectType, status])
  @@index([workspaceId, contentItemId])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, assetId])
  /// "What is waiting on me", for the Command Center.
  @@index([workspaceId, assignedToUserId, status])
  @@map("note_thread")
}

/// TENANT-OWNED. One message in a thread.
model Note {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  threadId    String @db.Uuid

  authorUserId String @db.Uuid

  /// The message, as plain text.
  ///
  /// NOT MARKUP, AND NOT HTML. Everything a note needs to say fits in a
  /// sentence, and accepting markup from one member and rendering it to another
  /// is a stored-XSS surface bought for formatting nobody asked for. Mentions
  /// are a separate table rather than a syntax parsed out of this at render
  /// time, so what a note MEANS does not depend on re-parsing it identically
  /// everywhere.
  body String

  /// Set when the author changes the text, so a reader can tell.
  editedAt  DateTime? @db.Timestamptz(6)
  /// Soft delete: the thread keeps its shape and the audit trail keeps its row.
  deletedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    NoteThread    @relation(fields: [workspaceId, threadId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "note_thread_fkey")
  mentions  NoteMention[]

  @@unique([workspaceId, id], name: "note_workspace_scope")
  @@index([workspaceId, threadId, createdAt])
  @@map("note")
}

/// TENANT-OWNED. One person named in one note.
///
/// A ROW RATHER THAN A SYNTAX. Storing mentions as `@name` inside the body would
/// mean every reader re-parses the text to know who was addressed, every rename
/// silently breaks an old mention, and "is this waiting on me" becomes a LIKE
/// query. The row is the fact; the body is the sentence.
///
/// THE MENTIONED PERSON IS A MEMBER OF THIS WORKSPACE, and the service checks
/// that before the row is written. Without it, mentioning an arbitrary user id
/// would tell the mentioner whether that account exists — and would put a
/// notification in a stranger's list.
model NoteMention {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  noteId      String @db.Uuid

  mentionedUserId String @db.Uuid

  /// When the mentioned person saw it. Null is unread, which is what the
  /// Command Center counts.
  readAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  note      Note      @relation(fields: [workspaceId, noteId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "note_mention_note_fkey")

  /// One mention of one person per note: saying somebody's name twice in a
  /// sentence is not two notifications.
  @@unique([workspaceId, noteId, mentionedUserId])
  @@unique([workspaceId, id], name: "note_mention_workspace_scope")
  /// "What is unread for me", for the Command Center and the bell.
  @@index([workspaceId, mentionedUserId, readAt])
  @@map("note_mention")
}

/// PHASE 6 FINAL (D-277 §9-§10, D-295) — A PERSON'S DECISION ON SOMETHING
/// BRANDSPACE NOTICED ABOUT THEIR OWN WORK.
///
/// THE OBSERVATIONS ARE NOT STORED HERE. They are derived, every time, from
/// the immutable audit trail (`content.variant.shorten`, `content.variant.tone`,
/// …) with the thresholds in the tenant's content configuration — so there is
/// no second record of behaviour to drift from the first. What IS stored is the
/// only thing that cannot be derived: what the person decided.
///
///   - a PREFERENCE accepted ("make this my default") influences that person's
///     future generations for that brand, and nothing else;
///   - DISMISSED means "don't suggest this again";
///   - SNOOZED means "not now", until `snoozedUntil`.
///
/// A WORKFLOW suggestion is never "accepted" here: accepting one means handing
/// it to the Copilot, whose automation rule starts DISABLED (D-296).
///
/// Per MEMBER and per BRAND: one person's habit is not the brand's truth, and
/// nothing here ever writes to Brand Brain.
model MemberSuggestion {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid
  userId      String @db.Uuid

  kind   MemberSuggestionKind
  /// A closed-form key the detector produces, e.g. `shorter:linkedin`.
  key    String
  status MemberSuggestionStatus

  /// How many observations the suggestion rested on when it was decided.
  evidenceCount Int
  /// Which recorded behaviour it came from, e.g. `content.inline_actions`.
  source        String

  decidedAt    DateTime  @db.Timestamptz(6)
  snoozedUntil DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "member_suggestion_brand_fkey")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "member_suggestion_user_fkey")

  @@unique([workspaceId, brandId, userId, kind, key])
  @@index([workspaceId, userId, status])
  @@map("member_suggestion")
}

enum MemberSuggestionKind {
  PREFERENCE
  WORKFLOW
}

enum MemberSuggestionStatus {
  ACCEPTED
  DISMISSED
  SNOOZED
}
