// BrandSpace — identity and tenancy core (Phase 1).
//
// Conventions (docs/DATABASE.md §1):
//   - Every tenant-owned model carries `workspaceId` and is protected by RLS.
//   - Ledger and audit tables are immutable: the application role has no UPDATE/DELETE.
//   - Timestamps are timestamptz (UTC). Money and credits arrive in later phases.
//
// TENANCY MARKER: a model is "tenant-owned" if and only if it has a `workspaceId`
// field. scripts/isolation-gate.ts parses this file and fails CI when a tenant-owned
// model lacks an RLS policy or isolation-test coverage (D-29).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum WorkspaceStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  /// Phase 2B. Retained, read-only, excluded from the working directory. There is
  /// no hard-delete path through any interface (CLAUDE.md §2.5).
  ARCHIVED
  DELETED
}

enum WorkspaceType {
  INDIVIDUAL
  STARTUP
  COMPANY
  CREATOR
  AGENCY
  ENTERPRISE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum RoleRealm {
  WORKSPACE
  PLATFORM
}

enum Locale {
  AR
  EN
}

enum ActorType {
  USER
  PLATFORM_USER
  SYSTEM
  AUTOMATION
  COPILOT
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

enum AuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

// ---------------------------------------------------------------------------
// Phase 2A enums — configuration, secrets, platform sessions
// ---------------------------------------------------------------------------

enum ConfigurationStatus {
  DRAFT
  VALIDATED
  ACTIVE
  SUPERSEDED
  DISCARDED
}

enum DeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum SecretStatus {
  PENDING
  ACTIVE
  ROTATING
  DISABLED
  REVOKED
}

enum SecretVersionStatus {
  PENDING
  ACTIVE
  RETIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// Phase 2B enums — customers, invitations, entitlements, credits
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  /// Set by a sweep; expiry is also enforced by comparing `expiresAt` on read,
  /// so an unswept row is never accepted.
  EXPIRED
  /// A resend supersedes the previous token rather than reusing it.
  SUPERSEDED
}

enum OverrideStatus {
  ACTIVE
  REVOKED
}

enum CreditTransactionType {
  PLAN_GRANT
  PROMOTIONAL_GRANT
  ADMIN_ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  USAGE_CHARGE
  REFUND
  EXPIRY
  RESET
  /// Phase 3. A prepaid credit pack (D-11: top-ups are the only way to add
  /// credits mid-cycle, because there is no postpaid overage).
  ADDON_PURCHASE
  /// Phase 3. The one-off grant that comes with a trial (D-09).
  TRIAL_GRANT
}

// ---------------------------------------------------------------------------
// Phase 3 enums — subscriptions, credit buckets, reservations
// ---------------------------------------------------------------------------

/// The commercial state of a workspace. No payment provider is involved: money
/// movement arrives in Phase 7, and this enum describes only what the platform
/// itself knows.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

/// Where a bucket of credits came from. It decides the default expiry (D-12)
/// and is what the customer's allocation breakdown is grouped by.
enum CreditGrantSource {
  PLAN_GRANT
  TRIAL_GRANT
  PROMOTIONAL_GRANT
  PACK_PURCHASE
  ADMIN_ADJUSTMENT
  ROLLOVER
}

enum CreditReservationStatus {
  OPEN
  SETTLED
  RELEASED
  /// Released by the sweeper because the caller never came back.
  EXPIRED
}

/// Phase 4. The AI request lifecycle — docs/AI-GATEWAY.md §6.1.
///
/// `PENDING → RESERVED → RUNNING → (SUCCEEDED | FAILED | TIMEOUT | CANCELLED |
/// MODERATION_BLOCKED)`. Every terminal status except SUCCEEDED releases the
/// reservation in full: docs/AI-GATEWAY.md §7.4 guarantee 1 is that a failed
/// request costs the customer nothing.
enum AiRequestStatus {
  PENDING
  RESERVED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMEOUT
  MODERATION_BLOCKED
}

/// Phase 4. The uniform provider error taxonomy — docs/AI-GATEWAY.md §3.
///
/// Retryability and fallback eligibility are derived from THIS, never from a
/// provider-specific message string. A provider that renames its errors must
/// not change how the gateway behaves.
enum AiFailureClass {
  AUTH_ERROR
  RATE_LIMITED
  QUOTA_EXCEEDED
  INVALID_REQUEST
  CONTENT_FILTERED
  CONTEXT_TOO_LONG
  MODEL_UNAVAILABLE
  PROVIDER_UNAVAILABLE
  TIMEOUT
  NETWORK_ERROR
  UNKNOWN
}

enum EmailMessageStatus {
  QUEUED
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Identity — NOT tenant-owned. A User is a global identity that may hold
// memberships in several workspaces. Access is constrained by Membership.
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  passwordHash    String?
  name            String?
  locale          Locale     @default(EN)
  timezone        String     @default("Asia/Riyadh")
  status          UserStatus @default(PENDING)

  // MFA. The secret itself lives in the vault; only its reference is stored here.
  mfaEnabled   Boolean @default(false)
  mfaSecretRef String?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)
  lastLoginAt      DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships     Membership[]
  ownedWorkspaces Workspace[]  @relation("WorkspaceOwner")
  invitesSent     Membership[] @relation("MembershipInviter")

  sessions            CustomerSession[]
  passwordResets      PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  invitationsAccepted Invitation[]         @relation("InvitationAcceptor")

  @@index([status])
  @@map("user")
}

// A platform staff account. Separate table, separate session realm, separate
// permission set — docs/SECURITY.md §3. A person may hold both a User and a
// PlatformUser account; the two never share a session.
model PlatformUser {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  passwordHash    String?
  name            String?
  status          UserStatus @default(PENDING)

  // D-27: 2FA is mandatory for platform roles. Enforced at login, not optional.
  mfaEnabled    Boolean   @default(false)
  /// Reference into the Secret Service — the TOTP secret is never a column.
  mfaSecretRef  String?
  mfaEnrolledAt DateTime? @db.Timestamptz(6)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)
  lastLoginAt      DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  supportSessions         SupportModeSession[]
  invitationsSent         Invitation[]              @relation("InvitationPlatformInviter")
  overridesGranted        WorkspaceOverride[]
  sessions                PlatformSession[]
  recoveryCodes           PlatformMfaRecoveryCode[]
  configVersionsAuthored  ConfigurationVersion[]    @relation("ConfigAuthor")
  configVersionsActivated ConfigurationVersion[]    @relation("ConfigActivator")
  secretsCreated          SecretRecord[]            @relation("SecretAuthor")

  @@index([status])
  @@map("platform_user")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// TENANT-OWNED. The isolation boundary itself: RLS restricts a Workspace row to
/// the workspace in the current request context.
model Workspace {
  id            String          @id @default(uuid()) @db.Uuid
  /// Self-referential tenant key so every tenant-owned table — including this one —
  /// is filtered by the same predicate. Always equal to `id`; enforced by a CHECK.
  workspaceId   String          @unique @db.Uuid
  slug          String          @unique
  name          String
  legalName     String?
  type          WorkspaceType   @default(STARTUP)
  status        WorkspaceStatus @default(TRIALING)
  country       String          @default("SA")
  defaultLocale Locale          @default(AR)
  timezone      String          @default("Asia/Riyadh")
  currency      String          @default("SAR") @db.Char(3)

  ownerUserId String @db.Uuid
  owner       User   @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  trialEndsAt     DateTime? @db.Timestamptz(6)
  suspendedAt     DateTime? @db.Timestamptz(6)
  suspendedReason String?

  // --- Phase 2B: lifecycle provenance -------------------------------------
  // Who changed the status, when, and why. Shown in the Control Center so a
  // suspension is never an unexplained state (docs/ADMIN-CONTROL-CENTER.md §3.3).
  statusReason                  String?
  statusChangedAt               DateTime? @db.Timestamptz(6)
  statusChangedByPlatformUserId String?   @db.Uuid
  archivedAt                    DateTime? @db.Timestamptz(6)

  // --- Phase 2B: plan assignment ------------------------------------------
  // The plan KEY, resolved against the active `plans` configuration version.
  // Prices and allowances are configuration, never columns (CLAUDE.md §2.2).
  // Superseded by `Subscription` when billing arrives (Phase 3/8) — see D-40.
  planKey                      String?
  planAssignedAt               DateTime? @db.Timestamptz(6)
  planAssignedByPlatformUserId String?   @db.Uuid

  /// Optimistic concurrency for platform edits. Travels in the WHERE of a
  /// conditional UPDATE, so a lost update is refused rather than silent.
  lockVersion Int @default(0)

  /// Advanced by customer sessions. Null means "never signed in" — displayed as
  /// such rather than invented (docs/ADMIN-CONTROL-CENTER.md §3.2).
  lastActivityAt DateTime? @db.Timestamptz(6)

  // --- Phase 5B-2: AI generation policy the CUSTOMER controls ---------------

  /// D-115. The Arabic dialect this workspace writes in, as a configured KEY
  /// rather than an enum: the supported list and the default both live in the
  /// activated `content` configuration domain, so adding a dialect is an
  /// operator change and not a migration (CLAUDE.md §2.2).
  ///
  /// NULL means "not configured", which resolves to the activated default —
  /// shipped as `msa`. It does NOT mean Saudi, and nothing here may make it so.
  arabicDialect String?

  /// D-117 / F-73. How long persisted AI output is kept, in days.
  ///
  /// NULL is the D-116 default: retained while the subscription is active, then
  /// a grace window after cancellation. A positive value is the CUSTOMER asking
  /// for something shorter, and the service — never the screen — applies it.
  ///
  /// It reaches content only. Audit events, the credit ledger and billing
  /// records have their own retention and are out of this column's reach.
  aiContentRetentionDays Int?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships              Membership[]
  roles                    Role[]
  auditEvents              AuditEvent[]
  supportSessions          SupportModeSession[]
  invitations              Invitation[]
  overrides                WorkspaceOverride[]
  creditWallet             CreditWallet?
  creditLedger             CreditTransaction[]
  // --- Phase 3 -------------------------------------------------------------
  subscription             WorkspaceSubscription?
  creditGrants             CreditGrant[]
  creditReservations       CreditReservation[]
  usageCounters            UsageCounter[]
  usageEvents              UsageEvent[]
  betaCohorts              BetaCohortMembership[]
  emailMessages            EmailMessage[]
  // --- Phase 4 -------------------------------------------------------------
  aiRequests               AiRequest[]
  aiUsageLedger            AiUsageLedger[]
  // --- Phase 5 -------------------------------------------------------------
  brands                   Brand[]
  brandKnowledgeItems      BrandKnowledgeItem[]
  brandKnowledgeVersions   BrandKnowledgeVersion[]
  brandSourceDocuments     BrandSourceDocument[]
  brandSourceChunks        BrandSourceChunk[]
  brandKnowledgeCandidates BrandKnowledgeCandidate[]
  brandIngestionJobs       BrandIngestionJob[]
  brandBrainConversations  BrandBrainConversation[]
  brandBrainMessages       BrandBrainMessage[]

  /// Phase 5B-1 — Asset Library.
  assetFolders        AssetFolder[]
  assets              Asset[]
  assetVersions       AssetVersion[]
  assetDerivatives    AssetDerivative[]
  assetUploadSessions AssetUploadSession[]
  assetProcessingJobs AssetProcessingJob[]

  /// Phase 5B-2 — AI Content Studio.
  contentItems    ContentItem[]
  contentVariants ContentVariant[]
  calendarSlots   CalendarSlot[]

  /// Phase 5B-3 — Approvals.
  approvals        Approval[]
  approvalPolicies ApprovalPolicy[]

  /// Phase 5B-3 — Notifications. Workspace-owned only: a notification is
  /// addressed to a member OF this workspace, never to a user globally.
  notifications Notification[]

  @@index([status])
  @@index([ownerUserId])
  @@index([planKey])
  @@map("workspace")
}

/// TENANT-OWNED. Links a User to a Workspace with a role and optional brand scope.
model Membership {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  /// null = all brands in the workspace; a non-empty array restricts the member.
  brandScope String[] @db.Uuid

  status MembershipStatus @default(INVITED)

  invitedByUserId     String?   @db.Uuid
  /// Only the hash is stored — the raw invitation token exists solely in the emailed link.
  invitationTokenHash String?   @unique
  invitationExpiresAt DateTime? @db.Timestamptz(6)
  acceptedAt          DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy User?     @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@index([roleId])
  @@map("membership")
}

/// TENANT-OWNED (nullable tenant key).
/// `workspaceId = null` denotes a system role that every workspace may resolve.
/// A non-null value denotes a workspace-defined custom role.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String?   @db.Uuid
  key         String
  realm       RoleRealm @default(WORKSPACE)
  nameEn      String
  nameAr      String
  description String?
  isSystem    Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace     Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  memberships   Membership[]
  platformUsers PlatformUser[]
  invitations   Invitation[]

  @@unique([workspaceId, key])
  @@index([realm])
  @@map("role")
}

// Global permission catalogue. Not tenant-owned — the same permission keys exist
// for every tenant, and the catalogue leaks no customer data.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  resource    String
  action      String
  minScope    String
  description String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@index([resource])
  @@map("permission")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ---------------------------------------------------------------------------
// Audit — immutable
// ---------------------------------------------------------------------------

/// TENANT-OWNED (nullable tenant key).
/// `workspaceId = null` denotes a platform-only event. Because RLS compares with
/// `=`, a NULL never matches a workspace context, so platform events are invisible
/// to tenants without needing a special-case policy.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @db.Uuid
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)

  actorType      ActorType
  actorId        String?   @db.Uuid
  actorEmailHash String?

  action       String
  resourceType String?
  resourceId   String? @db.Uuid
  brandId      String? @db.Uuid

  severity AuditSeverity @default(INFO)
  outcome  AuditOutcome  @default(SUCCESS)
  reason   String?

  /// Redacted before write — never contains secrets or tokens.
  before Json?
  after  Json?

  ip        String?
  userAgent String?
  requestId String?
  traceId   String?

  /// Set when the action occurred inside a support-mode session (D-28).
  supportModeSessionId String? @db.Uuid

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_event")
}

/// TENANT-OWNED. A time-boxed, reason-tagged, read-only-by-default platform access
/// grant over one workspace — D-28. True impersonation is prohibited.
model SupportModeSession {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  platformUserId String  @db.Uuid
  reason         String
  ticketRef      String?

  /// Read-only unless a separate elevated grant was issued and justified.
  writeEnabled Boolean @default(false)

  grantedAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  endedAt   DateTime? @db.Timestamptz(6)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, grantedAt(sort: Desc)])
  @@index([platformUserId, grantedAt(sort: Desc)])
  @@index([expiresAt])
  /// A-10. At most ONE live session per (workspace, operator), enforced by a
  /// PARTIAL unique index created in migration
  /// 20260908100000_support_mode_single_active. Prisma cannot express a
  /// `WHERE "endedAt" IS NULL` index, so it lives in the migration and is
  /// recorded here so nobody concludes the guarantee is only in code.
  @@map("support_mode_session")
}

// ===========================================================================
// PLATFORM-OWNED MODELS (Phase 2A)
//
// These carry NO workspaceId and are NOT tenant-owned. They are reachable only
// through the platform database identity: RLS grants them to brandspace_platform
// alone, and all privileges are REVOKED from brandspace_app, so the tenant role
// cannot read them even if a policy were mistakenly added later.
//
// scripts/isolation-gate.ts verifies both properties for every model listed in
// PLATFORM_OWNED_MODELS (packages/database/src/tenant-models.ts).
// ===========================================================================

/// PLATFORM-OWNED. One immutable version of one configuration domain.
model ConfigurationVersion {
  id            String                @id @default(uuid()) @db.Uuid
  domain        String
  environment   DeploymentEnvironment
  versionNumber Int
  schemaVersion Int                   @default(1)

  /// The configuration document. Never contains a secret value — secret-bearing
  /// fields hold a `secretRef` resolved server-side by the Secret Service.
  payload         Json
  payloadChecksum String

  status ConfigurationStatus @default(DRAFT)

  previousVersionId   String? @db.Uuid
  rollbackOfVersionId String? @db.Uuid

  validationReport Json?
  impactPreview    Json?

  createdByPlatformUserId   String  @db.Uuid
  activatedByPlatformUserId String? @db.Uuid
  changeReason              String

  /// Optimistic concurrency: an update must present the lockVersion it read, so
  /// two administrators editing the same draft cannot silently overwrite one
  /// another. The loser gets a conflict, not a lost edit.
  lockVersion Int @default(0)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  activatedAt   DateTime? @db.Timestamptz(6)
  deactivatedAt DateTime? @db.Timestamptz(6)

  createdBy   PlatformUser  @relation("ConfigAuthor", fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)
  activatedBy PlatformUser? @relation("ConfigActivator", fields: [activatedByPlatformUserId], references: [id], onDelete: SetNull)

  @@unique([domain, environment, versionNumber])
  @@index([domain, environment, status])
  @@index([activatedAt(sort: Desc)])
  @@map("configuration_version")
}

/// PLATFORM-OWNED. The logical secret. Holds NO ciphertext — material lives in
/// SecretVersion so rotation can keep two versions valid at once.
model SecretRecord {
  id          String                @id @default(uuid()) @db.Uuid
  /// Stable reference used by configuration, e.g. "ai/openai/production/api-key".
  ref         String
  environment DeploymentEnvironment
  category    String
  name        String
  description String?

  status SecretStatus @default(PENDING)

  createdByPlatformUserId String    @db.Uuid
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  lastRotatedAt           DateTime? @db.Timestamptz(6)
  lastUsedAt              DateTime? @db.Timestamptz(6)
  disabledAt              DateTime? @db.Timestamptz(6)
  revokedAt               DateTime? @db.Timestamptz(6)
  expiresAt               DateTime? @db.Timestamptz(6)

  createdBy PlatformUser    @relation("SecretAuthor", fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)
  versions  SecretVersion[]

  @@unique([ref, environment])
  @@index([environment, status])
  @@index([category])
  /// F-53. The Control Center's paginated listing orders by
  /// `[category, name, id]` inside one environment. Without this the database
  /// sorts the whole matching set to return one page, which is the cost
  /// pagination exists to avoid. `id` is included so the index covers the total
  /// order the query actually asks for.
  @@index([environment, category, name, id])
  @@map("secret_record")
}

/// PLATFORM-OWNED. One encrypted version of a secret.
///
/// Envelope encryption: `wrappedDataKey` is a data key encrypted by the KEK
/// (KMS or the local development provider); `ciphertext` is the secret value
/// encrypted by that data key with AES-256-GCM. The plaintext value is never
/// stored, never logged, and never returned by any API.
model SecretVersion {
  id             String @id @default(uuid()) @db.Uuid
  secretRecordId String @db.Uuid
  version        Int

  /// AEAD ciphertext, IV and auth tag. Base64, so a dump is never a usable key.
  ciphertext        String
  iv                String
  authTag           String
  /// The data key, itself encrypted by the key-encryption key.
  wrappedDataKey    String
  /// Which KEK wrapped the data key, so rotation of the KEK is traceable.
  keyProvider       String
  keyId             String
  algorithm         String @default("AES-256-GCM")
  /// Bound into the AEAD additional data, so ciphertext cannot be replayed into
  /// another ref, environment or version.
  encryptionContext String

  /// Audit-safe metadata. The ONLY things ever shown in the UI or an API.
  maskedHint  String
  fingerprint String

  status SecretVersionStatus @default(PENDING)

  createdByPlatformUserId String    @db.Uuid
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  activatedAt             DateTime? @db.Timestamptz(6)
  retiredAt               DateTime? @db.Timestamptz(6)

  secretRecord SecretRecord @relation(fields: [secretRecordId], references: [id], onDelete: Cascade)

  @@unique([secretRecordId, version])
  @@index([secretRecordId, status])
  @@map("secret_version")
}

/// PLATFORM-OWNED. A Platform Admin session. Separate table from any customer
/// session by design — the two realms never share storage (docs/SECURITY.md §3).
model PlatformSession {
  id             String @id @default(uuid()) @db.Uuid
  platformUserId String @db.Uuid

  /// Only the hash is stored; the raw token exists solely in the cookie.
  tokenHash String @unique

  /// D-27: platform roles require MFA. A session is unusable until this is set.
  mfaVerifiedAt    DateTime? @db.Timestamptz(6)
  /// Step-up re-authentication for high-impact operations.
  stepUpVerifiedAt DateTime? @db.Timestamptz(6)

  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  revokedReason     String?

  ip        String?
  userAgent String?

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, revokedAt])
  @@index([expiresAt])
  @@map("platform_session")
}

/// PLATFORM-OWNED. Single-use MFA recovery codes. Hashed, never recoverable.
model PlatformMfaRecoveryCode {
  id             String @id @default(uuid()) @db.Uuid
  platformUserId String @db.Uuid
  codeHash       String @unique

  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, usedAt])
  @@map("platform_mfa_recovery_code")
}

// ===========================================================================
// PHASE 2B — customers, workspaces, customer authentication, invitations,
// entitlement overrides and the credit ledger.
//
// Classification rules (packages/database/src/tenant-models.ts):
//   - carries `workspaceId`            -> tenant-owned, RLS + isolation test
//   - identity, no `workspaceId`       -> RLS policy still required, because a
//                                         session row names a person
// ===========================================================================

/// IDENTITY. A customer session. Deliberately NOT tenant-owned: a User is a
/// global identity who may hold memberships in several workspaces, and the
/// workspace is chosen AFTER authentication. The realm separation from
/// `PlatformSession` is physical — a different table, cookie, audience and
/// signing key (docs/SECURITY.md §3).
model CustomerSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// Only the SHA-256 hash is stored; the raw token exists solely in the cookie.
  tokenHash String @unique

  /// The workspace this session is currently scoped to. Null until the member
  /// picks one. Switching writes a NEW value here after re-verifying membership
  /// server-side — a client claim never selects a workspace.
  activeWorkspaceId String? @db.Uuid

  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  revokedReason     String?

  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([activeWorkspaceId])
  @@map("customer_session")
}

/// IDENTITY. Single-use, expiring password-reset tokens, stored hashed.
/// Not tenant-owned: a reset happens before any workspace is chosen.
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique

  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  ip String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/// TENANT-OWNED. A workspace invitation.
///
/// Modelled separately from `Membership` (docs/DATABASE.md §10) because an
/// invitee may have no `User` row at all, and `Membership.userId` is required.
/// The token is stored ONLY as a SHA-256 hash; the raw value exists solely in
/// the emailed link. Acceptance is a single conditional UPDATE, so two
/// concurrent acceptances cannot both win.
model Invitation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  /// Lower-cased at write time so a case variant cannot accept someone else's
  /// invitation. Compared against the authenticated user's email.
  email  String
  roleId String @db.Uuid

  /// null = all brands; a non-empty array restricts the future member.
  brandScope String[] @db.Uuid

  tokenHash String           @unique
  status    InvitationStatus @default(PENDING)

  expiresAt     DateTime  @db.Timestamptz(6)
  acceptedAt    DateTime? @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  revokedReason String?

  /// Exactly one inviter is set: a workspace member, or a platform actor acting
  /// through the Control Center. Never both.
  invitedByUserId         String? @db.Uuid
  invitedByPlatformUserId String? @db.Uuid

  acceptedByUserId String? @db.Uuid

  /// A resend creates a new row and points the old one here, so the audit trail
  /// shows the chain rather than a mutated token.
  supersededByInvitationId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role              Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedByUser     User?         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedByPlatform PlatformUser? @relation("InvitationPlatformInviter", fields: [invitedByPlatformUserId], references: [id], onDelete: SetNull)
  acceptedByUser    User?         @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, email])
  @@index([expiresAt])
  @@map("invitation")
}

/// TENANT-OWNED. An owner-granted, per-customer deviation from the plan.
/// docs/DATABASE.md §8.4. Precedence level 2 — it beats plan entitlement but
/// NEVER beats the kill switch (docs/ADMIN-CONTROL-CENTER.md §5.3).
model WorkspaceOverride {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  /// Feature key from the active `entitlements` configuration version.
  featureKey String

  enabled    Boolean
  /// null = unlimited for a quota feature; ignored for a boolean feature.
  limitValue Int?
  /// A-4. The chosen option for an `enum` feature; null for every other type.
  /// Separate from `limitValue` because a quota answers "how many" and an enum
  /// answers "which one" — collapsing them left enum features unresolvable.
  enumValue  String?

  reason String

  grantedByPlatformUserId String @db.Uuid

  effectiveFrom  DateTime       @default(now()) @db.Timestamptz(6)
  effectiveUntil DateTime?      @db.Timestamptz(6)
  status         OverrideStatus @default(ACTIVE)

  revokedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedBy PlatformUser @relation(fields: [grantedByPlatformUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, featureKey])
  @@index([effectiveUntil])
  @@map("workspace_override")
}

/// TENANT-OWNED. One wallet per workspace.
///
/// `balanceMilliCredits` is a materialised projection of the ledger, updated
/// only inside the same transaction as its `CreditTransaction` row and
/// reconcilable by replay. Milli-credits internally, whole credits displayed
/// (D-14). A CHECK constraint refuses a negative balance.
model CreditWallet {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid

  balanceMilliCredits          BigInt @default(0)
  reservedMilliCredits         BigInt @default(0)
  lifetimeGrantedMilliCredits  BigInt @default(0)
  lifetimeConsumedMilliCredits BigInt @default(0)

  /// Phase 3 (docs/DATABASE.md §7.1). The cycle boundary that drives the
  /// monthly grant and the rollover sweep, and the low-balance notice state.
  /// `nextResetAt` is the subscription's period end, not a calendar month: a
  /// customer who starts on the 20th resets on the 20th.
  lastResetAt               DateTime? @db.Timestamptz(6)
  nextResetAt               DateTime? @db.Timestamptz(6)
  lowBalanceNotifiedAt      DateTime? @db.Timestamptz(6)
  /// The threshold percentage most recently notified, so a wallet that crosses
  /// 20% and later 5% produces two notices rather than one or a stream.
  lowBalanceNotifiedPercent Int?

  /// Optimistic-lock counter, in addition to the row lock taken on every write.
  version Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  grants       CreditGrant[]
  reservations CreditReservation[]

  @@map("credit_wallet")
}

/// TENANT-OWNED and IMMUTABLE. The credit ledger.
/// `idempotencyKey` is unique, so a retry can never double-adjust a balance.
model CreditTransaction {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  walletId    String @db.Uuid

  type                     CreditTransactionType
  /// Signed. Negative for charges and expiries.
  amountMilliCredits       BigInt
  /// The wallet balance immediately after this row committed.
  balanceAfterMilliCredits BigInt

  reason String

  /// Unique. A retry with the same key returns the original row.
  idempotencyKey String @unique

  actorType ActorType
  actorId   String?   @db.Uuid

  /// Phase 3 (docs/DATABASE.md §7.2). On a GRANT row this is when the bucket
  /// expires; on a CHARGE row `sourceGrantId` names the bucket it drew from, so
  /// FIFO-by-expiry consumption is reconstructible from the ledger alone.
  expiresAt     DateTime? @db.Timestamptz(6)
  sourceGrantId String?   @db.Uuid
  reservationId String?   @db.Uuid

  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([walletId, type])
  @@index([workspaceId, expiresAt])
  @@index([reservationId])
  @@map("credit_transaction")
}

/// TENANT-OWNED (nullable tenant key). The email outbox.
///
/// There is no external email vendor: sending is an interface, and the default
/// implementation writes here (D-41). `workspaceId` is null for messages that
/// precede any workspace, such as a password reset.
///
/// The body carries no token: a reset or invitation link is composed from the
/// raw token, which is never persisted. Only the destination and the template
/// key are stored.
model EmailMessage {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String? @db.Uuid

  toEmail     String
  templateKey String
  locale      Locale @default(AR)

  /// Template variables, redacted before write. Never contains a raw token.
  variables Json?

  status     EmailMessageStatus @default(QUEUED)
  sentAt     DateTime?          @db.Timestamptz(6)
  failedAt   DateTime?          @db.Timestamptz(6)
  failReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([toEmail, createdAt(sort: Desc)])
  @@index([status])
  @@map("email_message")
}

/// GLOBAL CATALOGUE. A tenant-readable projection of the three configuration
/// domains a customer's own entitlements depend on.
///
/// WHY THIS EXISTS. Effective features resolve from the ACTIVE `entitlements`,
/// `plans` and `feature-flags` configuration versions — but
/// `configuration_version` is PLATFORM-owned, with every privilege revoked from
/// the tenant role, and it also holds `integrations.*` and `operations` payloads
/// that are none of a customer's business. Rather than weaken that table's
/// protection, the Configuration Service PROJECTS the three customer-relevant
/// payloads here when it activates one, and the customer application reads only
/// this.
///
/// It carries no `workspaceId` and no secrets: feature keys, plan keys, limits
/// and flag rules, identical for every tenant — the same shape as `permission`.
model EntitlementCatalogueSnapshot {
  /// One of: entitlements, plans, feature-flags, credits, brand-brain.
  ///
  /// Constrained by a CHECK in the migration, not by convention: a future
  /// caller cannot project an operational or integration payload where a
  /// customer can read it.
  domain      String
  environment DeploymentEnvironment

  /// The ACTIVE payload, copied verbatim at activation.
  payload Json

  /// Which configuration version this came from, for traceability.
  sourceVersionId String   @db.Uuid
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@id([domain, environment])
  @@map("entitlement_catalogue_snapshot")
}

// ---------------------------------------------------------------------------
// Phase 3 — subscriptions, credit buckets, reservations, usage, beta cohorts
// ---------------------------------------------------------------------------

/// TENANT-OWNED. The commercial state of one workspace.
///
/// WHAT THIS IS NOT. It is not the billing `Subscription` of docs/DATABASE.md
/// §8.5: there are no provider references, no invoice linkage and no payment
/// state, because payment collection is Phase 7 and this phase must not pretend
/// otherwise. Phase 7 extends this record rather than replacing it.
///
/// WHY IT EXISTS NOW. Three Phase 3 requirements need it and cannot be met from
/// `Workspace.planKey` alone:
///
///   * AC-04.7 — changing a plan's price must NOT reprice existing customers.
///     The agreed price is therefore COPIED here at assignment time, together
///     with the configuration version it came from. Later plan edits change the
///     catalogue, never this row.
///   * AC-04.11 — a workspace cannot start a second trial. `trialStartedAt`
///     survives the trial ending, the plan changing and the subscription being
///     cancelled, so "has this workspace ever had a trial?" stays answerable.
///   * Credit cycles — the monthly grant and the rollover sweep run on the
///     subscription's own period boundary, not the calendar month.
///
/// One row per workspace, evolving in place, so the trial history cannot be
/// erased by starting again.
model WorkspaceSubscription {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid

  planKey String
  status  SubscriptionStatus @default(TRIALING)

  billingInterval BillingInterval @default(MONTH)

  /// THE PINNED PRICE (AC-04.7). Copied from the plan configuration when the
  /// plan was assigned, in minor units of `currency`. Never recomputed.
  currency             String  @db.Char(3)
  pinnedMonthlyMinor   Int
  pinnedAnnualMinor    Int
  /// Which `plans` configuration version the price above was copied from.
  pinnedFromVersionId  String? @db.Uuid
  /// The allowance in force for this subscription, likewise pinned.
  pinnedMonthlyCredits Int     @default(0)

  currentPeriodStart DateTime @db.Timestamptz(6)
  currentPeriodEnd   DateTime @db.Timestamptz(6)

  /// Set once, ever. A second trial is refused by checking this is null.
  trialStartedAt DateTime? @db.Timestamptz(6)
  trialEndsAt    DateTime? @db.Timestamptz(6)

  /// A downgrade takes effect at period end (D-12), so the chosen plan waits
  /// here rather than being applied and reverted.
  pendingPlanKey         String?
  pendingPlanEffectiveAt DateTime? @db.Timestamptz(6)

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@index([planKey])
  @@map("workspace_subscription")
}

/// TENANT-OWNED. One bucket of credits, consumed FIFO by nearest expiry (D-12).
///
/// A PROJECTION, exactly like `credit_wallet.balanceMilliCredits`. The ledger
/// remains the source of truth: the GRANT row that created this bucket carries
/// `expiresAt`, and every CHARGE row carries `sourceGrantId`, so
/// `remainingMilliCredits` is reconstructible by replay — which is what
/// `CreditService.reconcile()` actually does. The column exists so choosing the
/// next bucket is a short indexed read rather than an aggregate over the whole
/// ledger.
///
/// Updated only inside the same transaction as its ledger row, under the same
/// wallet row lock.
model CreditGrant {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  walletId    String @db.Uuid

  source CreditGrantSource

  /// Granted, spent and held. The three are kept apart deliberately:
  ///
  ///   remaining = amount - (charges settled against this bucket)   <- replay
  ///   reserved  = estimates currently held against this bucket
  ///   spendable = remaining - reserved
  ///
  /// `remaining` therefore still equals what a ledger replay computes, which is
  /// what `reconcile()` asserts. Holding a reservation moves `reserved` only,
  /// so an open reservation cannot make the bucket disagree with the ledger —
  /// and two concurrent reservations cannot both allocate the same credits,
  /// which they could if a reservation left no per-bucket trace at all.
  amountMilliCredits    BigInt
  remainingMilliCredits BigInt
  reservedMilliCredits  BigInt @default(0)

  /// null = never expires. D-12 sets 12 months for packs, 3 for promotional.
  expiresAt DateTime? @db.Timestamptz(6)

  /// The ledger row that created this bucket. Unique, so a retried grant cannot
  /// produce a second bucket from the same transaction.
  sourceTransactionId String @unique @db.Uuid

  reason    String
  grantedAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  /// The consumption order: soonest expiry first, then oldest grant. NULLS LAST
  /// is applied in the query so never-expiring buckets are spent last.
  @@index([workspaceId, expiresAt, grantedAt])
  @@index([walletId, remainingMilliCredits])
  @@map("credit_grant")
}

/// TENANT-OWNED. One `reserve → confirm → settle` in flight.
///
/// The ledger records every movement; this row holds the STATE that makes the
/// protocol safe:
///
///   * `idempotencyKey` is unique, so a retried reserve returns the existing
///     reservation instead of holding the estimate twice (CLAUDE.md §2.4).
///   * `status` makes settle-twice and release-after-settle impossible.
///   * `allocations` records which buckets the estimate was taken from, so
///     settlement charges and releases the SAME buckets FIFO chose at reserve
///     time rather than re-deciding against a wallet that has since moved.
///   * `expiresAt` is what the sweeper uses. An abandoned reservation must be
///     released, and the leak count must stay at zero.
model CreditReservation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  walletId    String @db.Uuid

  /// Unique. A retry with the same key returns the original reservation.
  idempotencyKey String @unique

  /// What the caller asked to hold. Settlement may be less, never more.
  estimateMilliCredits BigInt
  /// Set at settlement. Null while open.
  settledMilliCredits  BigInt?

  status CreditReservationStatus @default(OPEN)

  /// `[{ grantId, milliCredits }]` — the FIFO decision, frozen at reserve time.
  allocations Json

  /// What the reservation is for. A task key, never request content.
  purpose String

  expiresAt     DateTime  @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  settledAt     DateTime? @db.Timestamptz(6)
  releasedAt    DateTime? @db.Timestamptz(6)
  /// Why it was released: caller cancelled, request failed, or swept.
  releaseReason String?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  /// The sweeper's query: everything still OPEN past its deadline.
  @@index([status, expiresAt])
  @@map("credit_reservation")
}

/// TENANT-OWNED. Consumption of one quota feature in one window.
///
/// `usedValue` is incremented by a single `INSERT … ON CONFLICT DO UPDATE`
/// carrying the limit in its WHERE clause, so the check and the increment are
/// one atomic statement. Two concurrent requests at the limit cannot both
/// succeed, and no row lock is held across application code.
model UsageCounter {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  featureKey  String
  /// Window bounds. `total` limits use a fixed epoch start so there is one row.
  periodStart DateTime @db.Timestamptz(6)
  periodEnd   DateTime @db.Timestamptz(6)

  usedValue Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureKey, periodStart])
  @@index([workspaceId, featureKey, periodEnd])
  @@map("usage_counter")
}

/// TENANT-OWNED. The idempotency record for one usage recording.
///
/// Inserted in the SAME transaction as the counter increment. A retry violates
/// the unique key, the transaction rolls back, and the counter is untouched —
/// so recording usage twice for one logical action is impossible rather than
/// unlikely.
///
/// It carries a feature key and an amount. It never carries request content.
model UsageEvent {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  featureKey     String
  idempotencyKey String @unique
  amount         Int

  counterId  String   @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, featureKey, occurredAt(sort: Desc)])
  @@map("usage_event")
}

/// TENANT-OWNED. One workspace's membership of one named beta cohort.
///
/// The cohort DEFINITIONS are configuration (`beta-cohorts`); membership is a
/// database row because it is per-customer state with an author, a reason and a
/// date — the same reasoning as `WorkspaceOverride`. Until this model existed
/// the precedence engine's beta-group dimension read a hard-coded empty set.
model BetaCohortMembership {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  cohortKey String

  addedByPlatformUserId String   @db.Uuid
  reason                String
  addedAt               DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, cohortKey])
  @@index([cohortKey])
  @@map("beta_cohort_membership")
}

/// TENANT-OWNED. One logical AI action — docs/DATABASE.md §6.5.
///
/// NO RAW PROMPT OR RESPONSE IS STORED HERE. `inputSummary` holds audit-safe
/// metadata only: token and asset counts, language, the prompt template
/// version, Brand Brain citation ids. docs/AI-GATEWAY.md §11 makes that the
/// default, and the column comment is not the enforcement — a unit test asserts
/// that the gateway never writes prompt text into it.
model AiRequest {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  /// Null for a platform- or system-initiated request.
  userId      String? @db.Uuid

  taskKey        String
  /// Unique. A retry with the same key returns the ORIGINAL result and never
  /// touches the wallet (docs/AI-GATEWAY.md §7.4 guarantee 2).
  idempotencyKey String @unique

  /// Which routing rule resolved, and to what. Model keys, not database ids:
  /// the registry is CONFIGURATION, so there is no model table to point at.
  routingTaskKey     String?
  resolvedModelKey   String?
  /// Every model tried, in order, including the ones that failed. Fallback is
  /// invisible in reporting without it.
  ///
  /// `@default([])` is declared so the datamodel matches the column's database
  /// default. The default is load-bearing, not cosmetic: an insert that omits a
  /// scalar list does not send an empty array, so a row created without naming
  /// this column would violate NOT NULL.
  attemptedModelKeys String[] @default([])

  status         AiRequestStatus @default(PENDING)
  failureClass   AiFailureClass?
  /// Safe to show a customer. Never a raw provider error or a credential.
  failureMessage String?

  /// Audit-safe metadata. NEVER raw customer content.
  inputSummary Json?

  /// The model's output, stored ONLY when the routing rule opts in.
  ///
  /// docs/AI-GATEWAY.md §11 does not persist prompts or responses by default,
  /// and this column honours that: it stays null unless an operator turns
  /// `parameters.persistOutput` on for a rule. It exists because §7.4's second
  /// guarantee — "a duplicate request with the same idempotency key returns the
  /// original result" — cannot be met for a client that lost the response
  /// unless the result was kept somewhere. A caller that persists its own
  /// artifact does not need this and should leave it off.
  outputPayload Json?

  /// Usage units, as reported by the adapter and normalised by `extractUsage`.
  promptTokens     Int?
  completionTokens Int?
  imageCount       Int?
  durationSeconds  Int?

  /// What the PROVIDER charged us, in MICRO-MINOR units (a millionth of a
  /// minor unit). Minor units cannot hold a real token price: $0.15 per
  /// million input tokens is 0.015 of a cent per thousand tokens, which as an
  /// integer count of cents is zero. Accrues across attempts — including
  /// failed ones, which the customer is never billed for.
  providerCostMicroMinor BigInt @default(0)
  currency               String @default("USD") @db.Char(3)

  /// Milli-credits (D-14). Reserved generously up front, charged on the actual.
  creditsReservedMilli BigInt @default(0)
  creditsChargedMilli  BigInt @default(0)

  /// The reservation this request holds. One request, one reservation.
  creditReservationId String? @unique @db.Uuid

  latencyMs  Int?
  retryCount Int  @default(0)

  /// BYOK: the customer supplied the provider credential. Provider cost to
  /// BrandSpace is zero and the ledger says so, keeping margin honest.
  byok Boolean @default(false)

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  /// The deadline. The sweeper reconciles anything still RUNNING past it, so no
  /// reservation outlives its request (docs/AI-GATEWAY.md §6.1).
  deadlineAt  DateTime  @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ledger    AiUsageLedger[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, taskKey, status])
  /// The stuck-request sweep, ordered so the oldest is reconciled first — the
  /// A-7 lesson applied before the defect rather than after it.
  @@index([status, deadlineAt])
  @@map("ai_request")
}

/// TENANT-OWNED and IMMUTABLE. The financial truth for AI usage —
/// docs/DATABASE.md §6.6, docs/AI-GATEWAY.md §12.
///
/// Append-only: no updates, no deletes. A correction is a NEW row pointing at
/// the one it corrects, so replaying the table always reproduces the same
/// totals. The database enforces this with a trigger, not a convention.
model AiUsageLedger {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  aiRequestId String  @db.Uuid
  userId      String? @db.Uuid

  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  taskKey     String
  providerKey String
  modelKey    String

  /// `{ promptTokens, completionTokens, imageCount, durationSeconds }` — the
  /// units the cost was computed from, frozen at settlement.
  usageUnits Json

  providerCostMicroMinor BigInt @default(0)
  currency               String @default("USD") @db.Char(3)
  creditsChargedMilli    BigInt @default(0)

  /// The wallet movement this row accounts for, when there was one. A failed
  /// request writes a ledger row with zero credits and no transaction.
  creditTransactionId String? @db.Uuid

  byok        Boolean               @default(false)
  environment DeploymentEnvironment

  /// Set only on a correction row. Never edited; never deleted.
  correctsLedgerId String? @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request   AiRequest @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)

  /// The row this one corrects, and the corrections against this one.
  ///
  /// Declared here as well as in the migration so the datamodel and the
  /// database agree: a foreign key that exists only in SQL is one a future
  /// `prisma migrate dev` would offer to drop. `Restrict` because a ledger row
  /// with a correction against it must not disappear out from under it.
  corrects    AiUsageLedger?  @relation("AiLedgerCorrection", fields: [correctsLedgerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  correctedBy AiUsageLedger[] @relation("AiLedgerCorrection")

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([workspaceId, taskKey, occurredAt])
  @@index([modelKey, occurredAt])
  @@map("ai_usage_ledger")
}

// ===========================================================================
// Phase 5 — Brand and Brand Brain
//
// docs/PRODUCT.md §6A, docs/DATABASE.md §4.1–4.2, D-63/D-64/D-65.
//
// Brand Brain is the intelligence and memory layer. The schema is shaped by
// D-65's seven write-back requirements — provenance, evidence, confidence,
// approval state, versioning, reproducibility, human precedence — because each
// of them is a column somewhere or it is nothing.
//
// EVERY model below is TENANT-OWNED and additionally BRAND-SCOPED. The brand
// boundary is not a second opinion about the workspace boundary: a composite
// foreign key `(workspaceId, brandId)` references `brand(workspaceId, id)`, so
// the database itself refuses a row that points at another workspace's brand
// (docs/DATABASE.md §12, "Brand belongs to workspace").
// ===========================================================================

enum BrandStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The ten knowledge areas the product exposes. An area is a PRODUCT concept —
/// the customer sees it as a card and a node on the orb — so it is an enum
/// rather than configuration: adding one changes screens, copy and completion
/// rules together, which is a release rather than a setting.
enum BrandKnowledgeArea {
  IDENTITY
  AUDIENCE
  TONE_OF_VOICE
  OFFERS
  PROOF_POINTS
  DO_DONT
  COMPETITORS
  GLOSSARY
  STRATEGY
  LEARNINGS
}

/// D-64's four memories. They differ in truth condition, lifetime and
/// AUTHORITY, and `memoryPrecedence()` in packages/brand-brain reads this to
/// order retrieval. Canonical outranks Strategy outranks Content outranks
/// Learning — always, and not as a tie-break.
enum BrandMemoryLayer {
  CANONICAL
  STRATEGY
  CONTENT
  LEARNING
}

/// Where a knowledge item came from. The distinction that makes D-65's human
/// precedence enforceable: HUMAN beats DOCUMENT beats AI_INFERRED, and no
/// AI-inferred item may ever overwrite a human one.
enum BrandKnowledgeOrigin {
  HUMAN
  DOCUMENT
  AI_INFERRED
}

/// D-65's approval state, plus the two terminal states a real corpus needs.
/// Only ACTIVE items are eligible for production AI context.
enum BrandKnowledgeStatus {
  DRAFT
  PROPOSED
  ACTIVE
  STALE
  ARCHIVED
}

enum BrandSourceStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  QUARANTINED
}

enum BrandIngestionStage {
  QUEUED
  EXTRACTING
  CHUNKING
  EXTRACTING_FACTS
  COMPLETED
  FAILED
}

enum BrandCandidateStatus {
  PENDING
  ACCEPTED
  EDITED_ACCEPTED
  REJECTED
  SUPERSEDED
}

/// TENANT-OWNED. One brand inside a workspace — docs/DATABASE.md §4.1.
model Brand {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  slug String
  name String

  industry         String?
  description      String?
  websiteUrl       String?
  defaultLocale    Locale   @default(EN)
  supportedLocales Locale[] @default([])

  /// Brand kit. Structured, and validated at the boundary rather than trusted.
  colorPalette Json?
  typography   Json?
  voiceProfile Json?

  status BrandStatus @default(DRAFT)

  /// D-115. This brand's Arabic dialect, overriding the workspace's. NULL means
  /// "inherit", and the chain is brand → workspace → the activated default.
  /// A configured key, validated against the activated `content` domain.
  arabicDialect String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete (docs/DATABASE.md §2). Never applied to ledgers or audit.
  deletedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  knowledgeItems    BrandKnowledgeItem[]
  knowledgeVersions BrandKnowledgeVersion[]
  sourceDocuments   BrandSourceDocument[]
  sourceChunks      BrandSourceChunk[]
  candidates        BrandKnowledgeCandidate[]
  ingestionJobs     BrandIngestionJob[]
  conversations     BrandBrainConversation[]
  messages          BrandBrainMessage[]

  /// Phase 5B-1 — Asset Library. Every one is OPTIONALLY brand-scoped: a NULL
  /// brandId means the row belongs to the workspace rather than to a brand.
  assetFolders        AssetFolder[]
  assets              Asset[]
  assetVersions       AssetVersion[]
  assetUploadSessions AssetUploadSession[]
  assetProcessingJobs AssetProcessingJob[]

  /// Phase 5B-2 — AI Content Studio.
  contentItems    ContentItem[]
  contentVariants ContentVariant[]
  calendarSlots   CalendarSlot[]

  /// Phase 5B-3 — Approvals.
  approvals        Approval[]
  approvalPolicies ApprovalPolicy[]

  /// The composite target a brand-scoped child points at. It is what makes
  /// `(workspaceId, brandId)` provable rather than merely conventional.
  @@unique([workspaceId, id], name: "brand_workspace_scope")
  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@map("brand")
}

/// TENANT-OWNED, BRAND-SCOPED. One unit of brand knowledge — docs/DATABASE.md
/// §4.2, and the carrier of every D-65 requirement.
model BrandKnowledgeItem {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  area   BrandKnowledgeArea
  memory BrandMemoryLayer     @default(CANONICAL)
  origin BrandKnowledgeOrigin @default(HUMAN)
  status BrandKnowledgeStatus @default(DRAFT)

  /// A stable key within (brand, area) — `audience.segment.founders`. Editing
  /// an item keeps its key; that is what makes a conflict detectable rather
  /// than appearing as two unrelated rows.
  itemKey String

  /// Localized `{ ar, en }`. Both locales are first-class (CLAUDE.md §4), and
  /// the boundary schema refuses a body with neither.
  title Json
  body  Json

  /// D-65 CONFIDENCE. Null for human-entered knowledge: a human statement is
  /// not a probability. 0–1000 (per mille) for anything inferred, kept integer
  /// so no float ever reaches money-adjacent comparisons.
  confidenceMilli Int?

  /// D-65 PROVENANCE. Which human, which document, which AI request.
  createdByUserId  String? @db.Uuid
  sourceDocumentId String? @db.Uuid
  aiRequestId      String? @db.Uuid

  /// D-65 EVIDENCE. Citations an inferred item must carry and a customer can
  /// inspect: `[{ chunkId, sourceDocumentId, locator, quote }]`. Never a raw
  /// provider response — only text the customer already owns.
  evidence Json?

  /// D-65 VERSIONING. Incremented on every accepted edit; retrieval cites it,
  /// and `brand_knowledge_version` keeps every prior value readable.
  version Int @default(1)

  /// Deterministic retrieval vector. NOT a vendor embedding: no embedding
  /// provider is approved (D-13), so this holds the local, reproducible
  /// index described in packages/brand-brain/src/retrieval.ts. The model key
  /// is recorded so re-indexing on a change is detectable.
  indexVector   Float[]   @default([])
  indexModelKey String?
  indexedAt     DateTime? @db.Timestamptz(6)

  /// Staleness. `reviewDueAt` is derived from validated configuration, never
  /// from a hard-coded interval.
  lastReviewedAt DateTime? @db.Timestamptz(6)
  reviewDueAt    DateTime? @db.Timestamptz(6)

  /// Set when this item conflicts with another and a human has not resolved
  /// it. D-65: a conflict is SURFACED, never silently resolved.
  conflictsWithItemId String? @db.Uuid

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand                @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_knowledge_item_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-83). Same oracle as the rest of the module, and
  /// the same collapse to "is this a document in my OWN workspace".
  ///
  /// `onDelete: SetNull` here is `ON DELETE SET NULL ("sourceDocumentId")` in
  /// the migration — the column list is NOT decoration. A bare SET NULL on a
  /// composite key nulls EVERY referencing column, `workspaceId` included, and
  /// `workspaceId` is NOT NULL, so deleting a source document would have begun
  /// failing outright. Prisma has no syntax for the column list; the migration
  /// carries it and D-114 records why.
  source    BrandSourceDocument? @relation(fields: [workspaceId, sourceDocumentId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_knowledge_item_source_fkey")

  versions   BrandKnowledgeVersion[]
  candidates BrandKnowledgeCandidate[]

  /// COMPOSITE (D-99, D-112, F-83), and a SELF-reference, so the oracle it
  /// closed was the sharpest kind: "is this id a knowledge item somewhere on
  /// the platform" asked of the very table that holds every tenant's approved
  /// brand knowledge. Column-scoped SET NULL, for the reason on `source`.
  conflictsWith BrandKnowledgeItem?  @relation("BrandKnowledgeConflict", fields: [workspaceId, conflictsWithItemId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_knowledge_item_conflict_fkey")
  conflicting   BrandKnowledgeItem[] @relation("BrandKnowledgeConflict")

  /// One live item per key per area. A second row with the same key is an
  /// EDIT (a new version), not a duplicate — enforced here rather than hoped
  /// for in a service.
  /// The composite target every child of an item points at (D-99, D-112, F-83)
  /// — its versions, the candidates that would edit it, and the items that
  /// conflict with it.
  @@unique([workspaceId, id], name: "brand_knowledge_item_workspace_scope")
  @@unique([workspaceId, brandId, area, itemKey])
  @@index([workspaceId, brandId, area, status])
  @@index([workspaceId, brandId, status, memory])
  @@index([workspaceId, brandId, reviewDueAt])
  @@map("brand_knowledge_item")
}

/// TENANT-OWNED, BRAND-SCOPED and APPEND-ONLY. D-65 VERSIONING and
/// REPRODUCIBILITY: the previous value stays readable, so a generation can be
/// replayed against the exact state it used, and a rollback is a restore of a
/// row that was never destroyed.
///
/// Append-only is enforced by a database trigger, not a convention — the same
/// decision `ai_usage_ledger` made in Phase 4.
model BrandKnowledgeVersion {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  knowledgeItemId String @db.Uuid
  version         Int

  area   BrandKnowledgeArea
  memory BrandMemoryLayer
  origin BrandKnowledgeOrigin
  status BrandKnowledgeStatus

  title Json
  body  Json

  confidenceMilli Int?
  evidence        Json?

  /// Who made this version and why. `changeReason` is reviewer-supplied text,
  /// not customer content, and is shown back in the history.
  changedByUserId String? @db.Uuid
  changeReason    String?
  /// `created`, `edited`, `approved`, `rejected`, `archived`, `rolled_back`.
  changeKind      String

  recordedAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand              @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_knowledge_version_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-83). The append-only history is the last place
  /// a row should be attachable to another tenant's item: a version names the
  /// title and body it recorded, so a misattached row is that tenant's approved
  /// knowledge filed under someone else's identity.
  item      BrandKnowledgeItem @relation(fields: [workspaceId, knowledgeItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_knowledge_version_item_fkey")

  @@unique([knowledgeItemId, version])
  @@index([workspaceId, brandId, recordedAt(sort: Desc)])
  @@map("brand_knowledge_version")
}

/// TENANT-OWNED, BRAND-SCOPED. An uploaded source document.
///
/// The BYTES ARE NOT HERE. PostgreSQL holds a storage reference; the object
/// lives behind the storage abstraction (packages/brand-brain/src/storage.ts).
/// A row carries only what the product must query or display.
model BrandSourceDocument {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  fileName   String
  mimeType   String
  byteSize   Int
  /// SHA-256 of the content. Duplicate protection is a UNIQUE constraint on
  /// it per brand, so re-uploading the same file is idempotent by identity
  /// rather than by filename.
  checksum   String
  /// Opaque object-storage key. Never a URL, never a signed one: a signature
  /// in a database column is a credential with a long life.
  storageKey String

  status         BrandSourceStatus @default(UPLOADED)
  /// Safe to show a customer. Never a raw extractor error or a path.
  failureMessage String?

  /// Populated by extraction. `pageCount` is null for formats without pages.
  pageCount  Int?
  chunkCount Int  @default(0)
  /// Extracted characters — a size signal for the UI that is not the text.
  textLength Int  @default(0)

  /// Which area the uploader targeted, when they dropped the file on one.
  targetArea BrandKnowledgeArea?

  uploadedByUserId String? @db.Uuid
  /// The client's idempotency key for the upload itself.
  idempotencyKey   String

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_source_document_brand_fkey")

  chunks         BrandSourceChunk[]
  candidates     BrandKnowledgeCandidate[]
  ingestionJobs  BrandIngestionJob[]
  knowledgeItems BrandKnowledgeItem[]

  /// The composite target every child of a document points at (D-99, D-112,
  /// F-80). `id` is already the primary key, so this constrains nothing new —
  /// it exists because PostgreSQL requires a unique index behind a foreign key,
  /// and a workspace-scoped key is what stops another tenant's document id from
  /// being referenceable at all.
  @@unique([workspaceId, id], name: "brand_source_document_workspace_scope")
  @@unique([workspaceId, brandId, checksum])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, brandId, createdAt(sort: Desc)])
  @@map("brand_source_document")
}

/// TENANT-OWNED, BRAND-SCOPED. One retrievable chunk of a source document,
/// with the location reference that makes a citation checkable.
model BrandSourceChunk {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  sourceDocumentId String @db.Uuid
  chunkIndex       Int

  /// The chunk text. This IS customer content, which is why the chunk table is
  /// never read by any operator surface and never enters a log.
  text    String
  /// Human-readable location — "page 4", "section 2.1" — so a citation points
  /// somewhere a person can check.
  locator String?

  indexVector   Float[] @default([])
  indexModelKey String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand               @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_source_chunk_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-80). A plain `sourceDocumentId` does NOT keep
  /// the parent inside the tenant: PostgreSQL runs referential integrity with
  /// RLS BYPASSED, so a chunk carrying its own workspaceId was accepted against
  /// ANOTHER workspace's document — and the difference between "inserted" and
  /// "constraint violated" answered *does this document id exist?*. Pairing the
  /// reference with `workspaceId` collapses that to "is this a document in my
  /// OWN workspace", which discloses nothing.
  document  BrandSourceDocument @relation(fields: [workspaceId, sourceDocumentId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_source_chunk_document_fkey")

  @@unique([sourceDocumentId, chunkIndex])
  @@index([workspaceId, brandId])
  @@map("brand_source_chunk")
}

/// TENANT-OWNED, BRAND-SCOPED. A candidate fact extracted from a document,
/// waiting for a human.
///
/// THE GOVERNANCE BOUNDARY. Extraction writes here and NEVER to
/// `brand_knowledge_item`, so no upload can change approved knowledge on its
/// own. D-65's approval state is this table's existence.
model BrandKnowledgeCandidate {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  sourceDocumentId String  @db.Uuid
  /// The item this candidate would change, when one already exists. Null means
  /// it proposes something new. This is what the review screen diffs.
  targetItemId     String? @db.Uuid

  area    BrandKnowledgeArea
  itemKey String

  /// What extraction produced, kept EXACTLY as extracted even when a reviewer
  /// edits before accepting — the original stays inspectable.
  extractedTitle Json
  extractedBody  Json
  /// A reviewer's edit, when they changed it before accepting.
  reviewedTitle  Json?
  reviewedBody   Json?

  confidenceMilli Int
  evidence        Json

  status BrandCandidateStatus @default(PENDING)

  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime? @db.Timestamptz(6)
  reviewReason     String?
  /// The version this candidate produced once accepted — the audit link from
  /// a decision to its effect.
  resultingVersion Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand               @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_knowledge_candidate_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-83), for the reason on
  /// `BrandSourceChunk.document`.
  document  BrandSourceDocument @relation(fields: [workspaceId, sourceDocumentId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_knowledge_candidate_document_fkey")
  /// COMPOSITE (D-99, D-112, F-83). This one crosses the GOVERNANCE boundary:
  /// `targetItemId` is the item a candidate would edit once accepted, so a
  /// foreign id here pointed the review screen's diff at another tenant's
  /// approved knowledge. NULL is legal and means "proposes something new",
  /// which MATCH SIMPLE exempts by construction. Column-scoped SET NULL, for
  /// the reason on `BrandKnowledgeItem.source`.
  target    BrandKnowledgeItem? @relation(fields: [workspaceId, targetItemId], references: [workspaceId, id], onDelete: SetNull, onUpdate: NoAction, map: "brand_knowledge_candidate_target_fkey")

  @@index([workspaceId, brandId, status])
  @@index([workspaceId, brandId, area, status])
  @@index([sourceDocumentId, status])
  @@map("brand_knowledge_candidate")
}

/// TENANT-OWNED, BRAND-SCOPED. The ingestion lifecycle for one document.
///
/// Idempotent and retryable (CLAUDE.md §5). One live job per document is a
/// partial unique index in the migration, so two uploads racing the same file
/// cannot both process it.
model BrandIngestionJob {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  sourceDocumentId String @db.Uuid

  stage       BrandIngestionStage @default(QUEUED)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(3)

  /// Safe to show a customer.
  failureMessage String?
  /// The internal reason, for operators. Never rendered to a customer and
  /// never a provider string.
  failureCode    String?

  /// Counters the UI reports honestly rather than guessing.
  chunksCreated     Int @default(0)
  candidatesCreated Int @default(0)

  /// The AI request that performed extraction, when one did. Reproducibility:
  /// an extraction can be traced to its gateway request and its cost.
  aiRequestId String? @db.Uuid

  queuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  startedAt     DateTime? @db.Timestamptz(6)
  completedAt   DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime? @db.Timestamptz(6)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand               @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_ingestion_job_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-80), for the reason on
  /// `BrandSourceChunk.document`. A job is the strongest form of the oracle: a
  /// queued job is observable in the UI, so a reference that merely fails later
  /// still answers the question at insert time.
  document  BrandSourceDocument @relation(fields: [workspaceId, sourceDocumentId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_ingestion_job_document_fkey")

  @@index([workspaceId, brandId, stage])
  @@index([stage, nextAttemptAt])
  @@map("brand_ingestion_job")
}

/// TENANT-OWNED, BRAND-SCOPED. A Brand Brain chat conversation.
model BrandBrainConversation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  /// The area the conversation was opened against, when it was opened from a
  /// node or a card. Null is the whole brain.
  area BrandKnowledgeArea?

  title String?

  startedByUserId String? @db.Uuid

  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  lastMessageAt DateTime @default(now()) @db.Timestamptz(6)

  /// D-78 RETENTION. Set from validated configuration when the conversation is
  /// created, because this feature DOES persist customer-visible AI output and
  /// therefore owns the artifact. Null is not allowed by the service.
  expiresAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_brain_conversation_brand_fkey")

  messages BrandBrainMessage[]

  /// The composite target every message points at (D-99, D-112, F-80). See the
  /// note on `BrandSourceDocument`.
  @@unique([workspaceId, id], name: "brand_brain_conversation_workspace_scope")
  @@index([workspaceId, brandId, lastMessageAt(sort: Desc)])
  @@index([expiresAt])
  @@map("brand_brain_conversation")
}

/// TENANT-OWNED, BRAND-SCOPED. One chat message.
///
/// D-78: this is persisted customer content, so it declares an owner (this
/// feature), a retention window, and a purge that clears the BODY while leaving
/// the accounting — `aiRequestId`, credits, the ledger — untouched.
model BrandBrainMessage {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  conversationId String @db.Uuid

  /// `user` or `assistant`. A system prompt is never persisted.
  role         String
  /// The message text. Nulled by the retention purge; the row survives so the
  /// conversation's shape and its accounting links remain.
  body         String?
  /// True once the body has been purged, so the UI says "expired" rather than
  /// rendering an empty bubble.
  bodyPurgedAt DateTime? @db.Timestamptz(6)

  /// Citations for a grounded answer: `[{ itemId, area, version, locator,
  /// sourceDocumentId, fileName }]`. A fabricated source is impossible because
  /// the service writes only ids it actually retrieved.
  citations Json?

  /// True when the assistant declined for lack of approved knowledge. Recorded
  /// so "honest refusal" is measurable rather than asserted.
  insufficientKnowledge Boolean @default(false)

  aiRequestId    String? @db.Uuid
  /// Client idempotency key, so a retried send never bills twice.
  idempotencyKey String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime? @db.Timestamptz(6)

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand        Brand                  @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "brand_brain_message_brand_fkey")
  /// COMPOSITE (D-99, D-112, F-80). The chat oracle was the sharpest of the
  /// three: posting into another workspace's conversation id SUCCEEDED, so a
  /// leaked id was not merely probeable but writable — the message landed in a
  /// conversation its author could not read.
  conversation BrandBrainConversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "brand_brain_message_conversation_fkey")

  @@unique([workspaceId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@map("brand_brain_message")
}

// ---------------------------------------------------------------------------
// Phase 5B-1 — Asset Library (docs/PRODUCT.md §5 module 13, docs/DATABASE.md
// §4.6 and §12, docs/SECURITY.md §11).
//
// SIX TENANT-OWNED TABLES. Every one carries `workspaceId` and is protected by
// RLS. Five of them are BRAND-SCOPED, and their brand scope is NULLABLE on
// purpose: docs/DATABASE.md §4.6 says "brandId (null = workspace-level)", and a
// multi-brand company's logo pack, font files and legal boilerplate genuinely
// belong to the workspace rather than to one of its brands.
//
// THE COMPOSITE FOREIGN KEY STILL APPLIES, and a nullable column does not
// weaken it. PostgreSQL's default MATCH SIMPLE satisfies a composite key when
// ANY referencing column is NULL, so a workspace-level row (brandId IS NULL) is
// exempt by construction while every brand-scoped row is checked against
// `brand(workspaceId, id)`. A row pointing at another workspace's brand is
// refused by the database rather than by a service that remembered to look.
// ---------------------------------------------------------------------------

/// What kind of thing an asset is. docs/DATABASE.md §4.6.
enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  FONT
}

/// docs/DATABASE.md §4.6. `ai_generated` exists so an image the AI Creative
/// Studio produces lands in the same library under the same quota (U-09)
/// without a second table; nothing in this phase writes it.
enum AssetSource {
  UPLOAD
  AI_GENERATED
  IMPORTED
}

/// The malware verdict. docs/SECURITY.md §11.3.
///
/// PENDING IS THE ONLY LEGAL STARTING STATE and it means QUARANTINED, not
/// "probably fine". `isSelectable` and every download path require CLEAN.
enum AssetScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

/// docs/DATABASE.md §4.6. An asset is usable only at READY + CLEAN.
enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  PROCESSING_FAILED
  QUARANTINED
  ARCHIVED
}

/// A bounded, approved transformation of an asset's bytes.
///
/// AN ENUM RATHER THAN A STRING, so the set of derivatives the platform will
/// ever produce is a schema fact. An open string would let a caller ask for
/// anything and let the worker produce work nobody bounded.
enum AssetDerivativeKind {
  THUMBNAIL
  PREVIEW
}

/// The lifecycle of one upload session. docs/SECURITY.md §11.1.
enum AssetUploadSessionStatus {
  PENDING
  COMPLETED
  ABORTED
  EXPIRED
}

/// The stages one asset's processing passes through, mirroring
/// `BrandIngestionStage` so both pipelines read the same way in an operator's
/// dashboard.
enum AssetProcessingStage {
  QUEUED
  SCANNING
  INSPECTING
  DERIVING
  COMPLETED
  FAILED
}

/// TENANT-OWNED, OPTIONALLY BRAND-SCOPED. A folder in the Asset Library —
/// docs/DATABASE.md §12 (`AssetFolder`, "asset library hierarchy").
model AssetFolder {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  /// NULL = a workspace-level folder, visible to every brand in the workspace.
  brandId     String? @db.Uuid

  /// NULL = a root folder. A tree rather than a path string, because a rename
  /// of a folder halfway up must not require rewriting every descendant's row.
  parentFolderId String? @db.Uuid

  name String

  createdByUserId String? @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete (docs/DATABASE.md §2).
  deletedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_folder_brand_fkey")

  /// COMPOSITE, and not merely tidy. A plain foreign key on `parentFolderId`
  /// does NOT keep the parent inside the tenant: PostgreSQL runs referential
  /// integrity checks with RLS BYPASSED, so a tenant can reference a row it
  /// cannot read. That is an existence oracle — an insert that succeeds only
  /// when the id names a real folder somewhere on the platform tells the
  /// caller it exists, which is exactly the inference CLAUDE.md §2.1 forbids.
  /// Pairing the parent with `workspaceId` collapses the oracle to "is this a
  /// folder in my OWN workspace", which discloses nothing. Found by the
  /// isolation suite, which asserted the refusal and got a created row.
  parent         AssetFolder?         @relation("AssetFolderTree", fields: [workspaceId, parentFolderId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "asset_folder_parent_fkey")
  children       AssetFolder[]        @relation("AssetFolderTree")
  assets         Asset[]
  uploadSessions AssetUploadSession[]

  /// The composite target every child of a folder points at.
  @@unique([workspaceId, id], name: "asset_folder_workspace_scope")
  /// The listing query: one brand's folders under one parent, by name.
  @@index([workspaceId, brandId, parentFolderId, name])
  @@index([workspaceId, parentFolderId])
  @@map("asset_folder")
}

/// TENANT-OWNED, OPTIONALLY BRAND-SCOPED. docs/DATABASE.md §4.6.
///
/// THE ROW IS THE CURRENT VERSION. `AssetVersion` carries the history, and the
/// denormalised bytes fields here always describe the version `currentVersion`
/// names. Reading a library page therefore touches one table, which is what a
/// grid of two hundred thumbnails needs.
model Asset {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  /// NULL = a workspace-level asset (docs/DATABASE.md §4.6).
  brandId     String? @db.Uuid
  folderId    String? @db.Uuid

  name String
  kind AssetKind

  /// The type decided from the file's OWN SIGNATURE at upload, never the
  /// browser's claim (docs/SECURITY.md §11.2).
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  durationMs Int?

  /// Opaque object-storage key. Never a URL and never a signed one: a
  /// signature in a database column is a credential with a long life.
  storageKey     String
  checksumSha256 String

  source      AssetSource @default(UPLOAD)
  aiRequestId String?     @db.Uuid

  license        String?
  rightsExpiryAt DateTime? @db.Timestamptz(6)

  /// docs/DATABASE.md §4.6 stores tags as an array with a GIN index rather than
  /// as a join table. Kept exactly as specified: a tag here is a label, not an
  /// entity with its own identity, and a catalogue table would be a second
  /// source of truth for the same string.
  tags String[] @default([])

  scanStatus AssetScanStatus @default(PENDING)
  /// A stable reason key, never a scanner's own message. Both translations live
  /// in the message catalogue.
  scanReason String?
  scannedAt  DateTime?       @db.Timestamptz(6)

  status        AssetStatus @default(UPLOADING)
  /// Safe to show a customer. A stable reason key, never a parser error or a path.
  failureReason String?

  /// Which version the columns above describe. Starts at 1.
  currentVersion  Int     @default(1)
  /// docs/DATABASE.md §4.6. Set when this asset supersedes another.
  replacesAssetId String? @db.Uuid

  uploadedByUserId String? @db.Uuid

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)
  /// Soft delete. The object and its derivatives are removed by the retention
  /// sweep, not by the request that pressed the button.
  deletedAt  DateTime? @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?       @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_brand_fkey")
  /// COMPOSITE, for the reason spelled out on AssetFolder.parent: a plain key
  /// would let a tenant file its own asset under another tenant folder, and
  /// would answer "does this folder id exist anywhere" for free.
  folder    AssetFolder? @relation(fields: [workspaceId, folderId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "asset_folder_fkey")

  versions       AssetVersion[]
  derivatives    AssetDerivative[]
  uploadSessions AssetUploadSession[]
  processingJobs AssetProcessingJob[]

  /// DUPLICATE PROTECTION. docs/DATABASE.md §4.6 asks for
  /// `(workspaceId, checksumSha256)` "for dedupe"; it is a UNIQUE constraint
  /// here rather than a plain index so the second upload of the same bytes is
  /// refused by the database even if two requests race past the service's own
  /// check. Scoped to the live rows only would need a partial index, which
  /// Prisma cannot express — so the service checks `deletedAt` and the
  /// constraint is the backstop. See the migration for the partial unique index
  /// that makes re-uploading after a delete possible.
  /// The composite target versions, derivatives, sessions and jobs point at.
  @@unique([workspaceId, id], name: "asset_workspace_scope")
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, kind])
  @@index([workspaceId, checksumSha256])
  /// The library's own listing: newest first inside a folder, deterministically.
  @@index([workspaceId, brandId, folderId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("asset")
}

/// TENANT-OWNED. One historical version of an asset's bytes.
///
/// APPEND-ONLY, and enforced the way `brand_knowledge_version` is: the tenant
/// role is granted SELECT and INSERT and nothing else, FORCE RLS leaves the
/// owner without a policy, and a trigger refuses UPDATE and DELETE. A version
/// history a caller can rewrite is not a history.
model AssetVersion {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  brandId     String? @db.Uuid
  assetId     String  @db.Uuid

  versionNumber Int

  /// The bytes THIS version points at. A version is a complete object, not a
  /// delta: a customer restoring version 2 must get exactly the file they
  /// uploaded, not a reconstruction.
  storageKey     String
  checksumSha256 String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  durationMs     Int?

  scanStatus AssetScanStatus @default(PENDING)

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_version_brand_fkey")
  asset     Asset     @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "asset_version_asset_fkey")

  @@unique([assetId, versionNumber])
  @@index([workspaceId, assetId, versionNumber(sort: Desc)])
  @@map("asset_version")
}

/// TENANT-OWNED. A bounded, approved transformation of an asset's bytes.
///
/// A ROW PER DERIVATIVE RATHER THAN A JSON BLOB. docs/DATABASE.md §4.6 carries
/// `derivatives jsonb` on the asset, and that shape cannot answer the question
/// this phase must answer: how many derivative objects exist, so the ceiling
/// can be enforced and so every one of them can be deleted when the asset is.
/// A JSON column that the deletion path has to parse to find object keys is how
/// orphaned objects accumulate.
model AssetDerivative {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  assetId     String @db.Uuid

  kind AssetDerivativeKind

  storageKey String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "asset_derivative_asset_fkey")

  /// ONE DERIVATIVE PER KIND PER ASSET. The ceiling is then a schema fact as
  /// well as a configured number, so a retried processing run overwrites rather
  /// than accumulating.
  @@unique([assetId, kind])
  @@index([workspaceId, assetId])
  @@map("asset_derivative")
}

/// TENANT-OWNED, OPTIONALLY BRAND-SCOPED. One upload in flight —
/// docs/SECURITY.md §11.1.
///
/// THE SESSION IS THE AUTHORISATION DECISION, MADE BEFORE ANY BYTES EXIST.
/// Permission, brand scope, entitlement, storage quota, declared size and
/// declared type are all settled at initiate; the completion step re-checks
/// only what the bytes themselves decide. That ordering is the whole reason a
/// session exists rather than a single upload call: refusing a 2 GB file after
/// receiving it costs the platform the 2 GB.
model AssetUploadSession {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  brandId     String? @db.Uuid
  folderId    String? @db.Uuid

  /// Set once the session completes and an asset row exists. NULL while the
  /// upload is in flight, and for a session that never completed.
  assetId String? @db.Uuid

  /// What the CALLER said. Kept because it is what the customer will be shown
  /// if the bytes disagree, and never used to choose a parser or a store.
  declaredFileName  String
  declaredMimeType  String
  declaredSizeBytes Int

  /// Where the bytes will land. Reserved at initiate, so the completion step
  /// cannot be talked into writing somewhere else.
  storageKey String

  status        AssetUploadSessionStatus @default(PENDING)
  /// A stable reason key when the session was refused at completion.
  failureReason String?

  /// REQUEST idempotency: a retry of an initiate whose response was lost
  /// replays the same session rather than reserving a second key.
  idempotencyKey String

  createdByUserId String? @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  /// A session past this may no longer be completed. The sweep expires it and
  /// removes any bytes that arrived.
  expiresAt   DateTime  @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?       @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_upload_session_brand_fkey")
  asset     Asset?       @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "asset_upload_session_asset_fkey")
  folder    AssetFolder? @relation(fields: [workspaceId, folderId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "asset_upload_session_folder_fkey")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, brandId, status])
  /// The expiry sweep reads this and nothing else.
  @@index([status, expiresAt])
  @@map("asset_upload_session")
}

/// TENANT-OWNED. Scan, inspect and derive one asset — the same shape as
/// `BrandIngestionJob`, for the same reasons.
model AssetProcessingJob {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  brandId     String? @db.Uuid
  assetId     String  @db.Uuid

  stage       AssetProcessingStage @default(QUEUED)
  attempts    Int                  @default(0)
  maxAttempts Int                  @default(3)

  /// A stable reason key, safe to show a customer.
  failureReason String?
  /// The internal reason, for operators. Never rendered to a customer.
  failureCode   String?

  derivativesCreated Int @default(0)

  queuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  startedAt     DateTime? @db.Timestamptz(6)
  completedAt   DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "asset_processing_job_brand_fkey")
  asset     Asset     @relation(fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "asset_processing_job_asset_fkey")

  @@index([workspaceId, assetId, queuedAt(sort: Desc)])
  /// The reconciliation sweep: unclaimed work, oldest first.
  @@index([stage, nextAttemptAt])
  @@map("asset_processing_job")
}

// ---------------------------------------------------------------------------
// Phase 5B-2 — AI Content Studio (docs/PRODUCT.md §5 module 7,
// docs/DATABASE.md §4.4 and §4.5, docs/ROADMAP.md Phase 5 scope item 3).
//
// TWO TENANT-OWNED TABLES, both additionally BRAND-SCOPED, and every foreign
// key between them composite with `workspaceId` — D-112, which F-80 and F-83
// established as the platform rule rather than an Asset Library one.
//
// THE CONTENT ITEM IS CHANNEL-AGNOSTIC AND THE VARIANT IS NOT. That split is
// docs/DATABASE.md §4.4/§4.5 and it is the whole point: one idea, written once,
// rendered per platform and per locale. A single table carrying a
// `platformKey` would make "the same post for Instagram and LinkedIn" two
// unrelated rows, and approving one would say nothing about the other.
// ---------------------------------------------------------------------------

/// docs/DATABASE.md §4.4. What kind of thing a content item is.
enum ContentType {
  POST
  CAROUSEL
  STORY
  REEL
  VIDEO
  ARTICLE
  THREAD
}

/// docs/DATABASE.md §4.4 lifecycle.
///
/// PHASE 5B-2 REACHES DRAFT, IN_REVIEW AND ARCHIVED ONLY. The later states are
/// declared because the lifecycle is a product fact and a partial enum would
/// have to be migrated by the phase that needs them — but nothing in this
/// phase writes SCHEDULED or beyond. Approvals (scope item 6) and the Social
/// Calendar (item 5) own those transitions, and this phase deliberately does
/// not pre-empt either.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  ARCHIVED
}

/// Whether a variant's body has been checked against its platform's limits.
///
/// `UNVALIDATED` is the honest starting state and is never rendered as "valid":
/// a caption nobody has measured is not a caption known to fit.
enum ContentValidationState {
  UNVALIDATED
  VALID
  WARNINGS
  INVALID
}

/// How a piece of content came to exist. Provenance the customer can see, and
/// the thing that makes "AI wrote this" answerable rather than assumed.
enum ContentOrigin {
  HUMAN
  AI_GENERATED
  AI_ASSISTED
}

/// Where a calendar slot is in its own short life — docs/DATABASE.md §4.7b.
///
/// DELIBERATELY SHORTER THAN §4.7's DESIGN. `LOCKED`, `PUBLISHING`, `PUBLISHED`
/// and `FAILED` are the publishing pipeline's, and the pipeline is Phase 6. A
/// state no code can ever enter is a state whose meaning nobody has settled, so
/// they are absent rather than declared and unreachable.
enum CalendarSlotStatus {
  /// On the calendar, and the content is not yet cleared to go.
  PLANNED
  /// On the calendar and cleared. The content item is `SCHEDULED` in step.
  SCHEDULED
  /// Taken off the calendar. Kept rather than deleted so the audit trail and
  /// the quota refund both have a row to point at.
  CANCELLED
}

/// TENANT-OWNED, BRAND-SCOPED. The canonical content object — docs/DATABASE.md §4.4.
model ContentItem {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  title       String
  contentType ContentType @default(POST)

  /// The locale the item was authored in. Variants carry their own, so an
  /// Arabic item with an English variant is a normal shape rather than a
  /// contradiction.
  primaryLocale Locale   @default(AR)
  /// The content pillar this belongs to, when the brand uses pillars.
  pillar        String?
  tags          String[] @default([])

  status ContentStatus @default(DRAFT)

  /// D-65-style provenance, for the same reason Brand Brain carries it: a
  /// customer is entitled to know whether a human or a model wrote the words.
  origin          ContentOrigin @default(HUMAN)
  createdByUserId String?       @db.Uuid
  /// The gateway request that produced it. AC-11.5 — the draft is linked to the
  /// `AiRequest`, so a generation can be traced to its cost and its model.
  aiRequestId     String?       @db.Uuid

  /// AC-11.4. Which Brand Brain entries and versions grounded the generation:
  /// `[{ itemId, area, version, locator, sourceDocumentId, fileName }]`.
  /// Written from what RETRIEVAL returned, never parsed out of model text, so a
  /// fabricated citation is impossible.
  citations Json?

  /// True when the generation declined for lack of approved knowledge. Recorded
  /// so an honest refusal is measurable rather than asserted.
  insufficientKnowledge Boolean @default(false)

  /// The dialect the item was generated in (D-115), resolved at generation time
  /// from brand → workspace → the activated default. Recorded rather than
  /// re-derived, because the configured default can change afterwards and a
  /// draft must still say what it actually was.
  arabicDialect String?

  /// Client idempotency key for the generation, so a retried request never
  /// bills twice and never creates a second draft.
  idempotencyKey String?

  /// D-116 / D-117 retention. NULL means "retained while the subscription is
  /// active". A date is either the post-cancellation grace deadline or the
  /// workspace's own shorter window, whichever the service resolved.
  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete (docs/DATABASE.md §2).
  deletedAt DateTime? @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "content_item_brand_fkey")

  variants      ContentVariant[]
  calendarSlots CalendarSlot[]
  approvals     Approval[]

  /// The composite target every variant points at (D-112).
  @@unique([workspaceId, id], name: "content_item_workspace_scope")
  /// A replayed generation returns the first draft rather than making a second.
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, brandId, status])
  @@index([workspaceId, brandId, updatedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("content_item")
}

/// TENANT-OWNED, BRAND-SCOPED. Per-platform, per-locale rendering of a content
/// item — docs/DATABASE.md §4.5.
model ContentVariant {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  contentItemId String @db.Uuid

  /// The platform key this variant is written for, from the activated `content`
  /// configuration domain — never an enum, because the set of platforms the
  /// product supports is an operator's fact (CLAUDE.md §2.2) and Phase 6 will
  /// add to it without a migration.
  platformKey String
  locale      Locale

  /// The caption. THIS IS CUSTOMER CONTENT: nulled by the retention purge while
  /// the row survives, exactly as `brand_brain_message.body` is, so the shape of
  /// the work and its accounting links outlive the words.
  body         String?
  bodyPurgedAt DateTime? @db.Timestamptz(6)

  hashtags     String[] @default([])
  mentions     String[] @default([])
  linkUrl      String?
  firstComment String?

  /// Assets selected from the Asset Library. A uuid array rather than a join
  /// table, matching docs/DATABASE.md §4.5 — a variant references assets, it
  /// does not own them.
  ///
  /// NOT a foreign key, and that is deliberate rather than an oversight: an
  /// array cannot carry a composite key, so the tenant boundary here is
  /// enforced in the SERVICE, which resolves every id through the tenant-scoped
  /// client before writing. The isolation suite proves a foreign asset id is
  /// refused on that path.
  assetIds String[] @default([]) @db.Uuid

  platformOptions Json?

  validationState  ContentValidationState @default(UNVALIDATED)
  validationErrors Json?
  characterCount   Int                    @default(0)

  origin      ContentOrigin @default(HUMAN)
  aiRequestId String?       @db.Uuid

  /// The dialect this variant was written in (D-115), for the reason on the item.
  arabicDialect String?

  /// Retention travels with the item's, so a purge cannot clear a caption and
  /// leave its translation.
  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand       @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "content_variant_brand_fkey")
  /// COMPOSITE (D-112). A plain `contentItemId` would accept another
  /// workspace's item id — referential integrity runs with RLS bypassed — and
  /// the difference between accepted and refused would answer whether that id
  /// exists. F-80 and F-83 are what this line prevents recurring.
  item      ContentItem @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "content_variant_item_fkey")

  /// docs/DATABASE.md §4.5: one variant per platform per locale.
  @@unique([contentItemId, platformKey, locale])
  @@index([workspaceId, contentItemId])
  @@index([workspaceId, brandId])
  @@index([expiresAt])
  @@map("content_variant")
}

/// TENANT-OWNED, BRAND-SCOPED. When a content item goes out — docs/DATABASE.md
/// §4.7 and §4.7b.
///
/// THE SLOT IS THE *WHEN*; THE CONTENT ITEM REMAINS THE SOURCE OF TRUTH FOR THE
/// WHAT AND THE STATE. A second copy of a caption, a status or a channel list
/// here would be a second answer to a question `content_item` already answers,
/// and the two would drift the first time one was updated without the other. So
/// this row holds a time, a timezone, a target and a link.
///
/// WHY THREE TIME COLUMNS AND NOT ONE (AC-14.2, AC-14.3). A timestamp alone
/// cannot answer "what time did the customer MEAN?" across a daylight-saving
/// boundary: 09:00 local converted to UTC in January and read back in July is
/// 08:00 or 10:00, and neither is what anyone asked for. So the INTENT
/// (`scheduledLocalTime`, `timezone`) is stored beside the INSTANT
/// (`scheduledAtUtc`), and the instant is recomputed from the intent whenever
/// the zone's offset changes. Storing only the instant loses the intent; storing
/// only the intent makes every query a conversion.
model CalendarSlot {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  contentItemId String @db.Uuid

  /// The instant, in UTC. What every range query and every sweep reads.
  scheduledAtUtc     DateTime @db.Timestamptz(6)
  /// The wall-clock the customer chose, as `YYYY-MM-DDTHH:mm`. A STRING rather
  /// than a timestamp on purpose: it is a local intent with no offset, and
  /// giving it one would be inventing the very fact it exists to preserve.
  scheduledLocalTime String
  /// The IANA zone that intent is expressed in, copied from the workspace when
  /// the slot was created. Copied rather than joined, because a workspace that
  /// relocates must not silently move every post it already scheduled.
  timezone           String

  status CalendarSlotStatus @default(PLANNED)

  /// AC-14.7 — the publishing target is a MOCK, and says so in the data rather
  /// than only in a comment. Phase 6 adds real connection targets beside it;
  /// until then nothing in this system can name one.
  targetKind String @default("MOCK")

  /// Which channels this slot is for. Derived from the item's variants when the
  /// slot is created, and kept so a slot still renders its channels after a
  /// variant is edited — the calendar is a plan, and a plan records what was
  /// planned.
  platformKeys String[] @default([])

  createdByUserId String?   @db.Uuid
  cancelledAt     DateTime? @db.Timestamptz(6)

  /// The usage-quota event this slot consumed (AC-14.5), so cancelling can
  /// refund exactly what scheduling took and a retry cannot double-count.
  usageIdempotencyKey String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand       @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "calendar_slot_brand_fkey")
  /// COMPOSITE (D-112). A plain `contentItemId` would accept another
  /// workspace's item — referential integrity runs with RLS bypassed — and the
  /// difference between accepted and refused answers whether that id exists.
  /// F-80 and F-83 are what this line prevents recurring.
  item      ContentItem @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_slot_item_fkey")

  /// ONE LIVE SLOT PER ITEM. A partial index, so a cancelled slot does not
  /// block rescheduling the same content — the same shape D-100 settled for the
  /// asset checksum, and it lives in the migration because Prisma cannot model
  /// a WHERE clause on a unique index.
  @@index([workspaceId, scheduledAtUtc])
  @@index([workspaceId, brandId, scheduledAtUtc])
  @@index([workspaceId, contentItemId])
  @@index([status, scheduledAtUtc])
  @@map("calendar_slot")
}

// ---------------------------------------------------------------------------
// Phase 5B-3 — Approvals, Activity Log, Notifications
// (docs/PRODUCT.md §5 modules 1, 14, 16, 17; docs/DATABASE.md §4.8 and §9.3)
// ---------------------------------------------------------------------------

/// Where a review request currently stands. `CANCELLED` is withdrawal by the
/// requester or by a later edit; `CHANGES_REQUESTED` is a reviewer's verdict
/// and is distinct from `REJECTED` because one invites a resubmission and the
/// other closes the question.
enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  CANCELLED
}

/// What an approval is attached to. Only `CONTENT_ITEM` is reachable in this
/// phase; the others are declared because docs/DATABASE.md §4.8 designs them
/// and a later phase should extend the enum rather than redesign the table.
enum ApprovalSubjectType {
  CONTENT_ITEM
  CAMPAIGN
  ASSET
}

/// TENANT-OWNED, BRAND-SCOPED. One review CYCLE over one subject — the record
/// of a request and the verdict that closed it (docs/DATABASE.md §4.8).
///
/// ONE CYCLE PER ROW, and the history is the rows. Resubmitting after changes
/// were requested opens a NEW row rather than reopening the old one, so
/// "who approved this, when, and against which policy" keeps a stable answer
/// after the next edit.
model Approval {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  subjectType   ApprovalSubjectType @default(CONTENT_ITEM)
  /// The content item under review. A COLUMN rather than a polymorphic id,
  /// because a composite foreign key (D-112) cannot be written against a
  /// column whose target table varies — and an uncheckable reference is how a
  /// cross-tenant id gets accepted.
  contentItemId String?             @db.Uuid

  requestedByUserId String  @db.Uuid
  /// Optional assignment. NULL means "anyone who may approve", which is the
  /// common case in a small team and is not the same as unassigned-and-stuck.
  assignedToUserId  String? @db.Uuid

  status ApprovalStatus @default(PENDING)

  /// The requester's context, and the reviewer's. Free text from a member of
  /// the workspace, bounded by the service and never interpolated into a
  /// prompt.
  requestNote  String?
  decisionNote String?

  decidedByUserId String?   @db.Uuid
  decidedAt       DateTime? @db.Timestamptz(6)

  /// The approval rules in force when the request was made — `{ selfApproval,
  /// clientApproval, requireApprovalBeforeScheduling }`. Snapshotted rather
  /// than joined, because a policy that changes afterwards must not rewrite
  /// what an earlier decision meant.
  policySnapshot Json?

  /// Which cycle this is for the subject, starting at 1. Makes the history
  /// orderable without depending on clock resolution.
  cycle Int @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand        @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "approval_brand_fkey")
  /// COMPOSITE (D-112), exactly as `calendar_slot_item_fkey`. A plain
  /// `contentItemId` would resolve another workspace's draft, and the
  /// difference between accepted and refused answers whether it exists.
  item      ContentItem? @relation(fields: [workspaceId, contentItemId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction, map: "approval_item_fkey")

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, contentItemId, cycle(sort: Desc)])
  @@index([workspaceId, assignedToUserId, status])
  @@index([workspaceId, brandId, status])
  @@map("approval")
}

/// TENANT-OWNED, BRAND-SCOPED. The per-brand approval policy — ROADMAP Phase 5
/// scope item 6, "policy per brand".
///
/// ABSENCE IS NOT A STATE. A brand with no row uses the activated
/// `content.approvals` configuration defaults; the row exists only once
/// somebody has deliberately departed from them, so a default that changes
/// still reaches every brand that never chose otherwise.
model ApprovalPolicy {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  brandId     String @db.Uuid

  /// AC-14.6. When true, only an APPROVED item may be placed on the calendar.
  /// This is the per-brand form of the gate D-120 shipped OFF; the workflow
  /// behind it now exists.
  requireApprovalBeforeScheduling Boolean?

  /// D-122. Whether a member holding `content.approve` may approve content
  /// they themselves authored. Default-deny, and an owner may relax it.
  allowSelfApproval Boolean?

  /// RESERVED AND INERT — D-62 supersedes D-121 for the MVP.
  ///
  /// D-121 made this the per-brand switch admitting Viewer (read-only) as a
  /// reviewer. D-62 requires Viewer to be strictly read-only, so the switch has
  /// no behaviour: nothing reads it to authorize anything, no API patches it,
  /// no screen renders it, and `approval_policy_client_approval_withdrawn`
  /// pins it to FALSE or NULL.
  ///
  /// Kept as structure for a future External Review / Guest Approval
  /// capability, which will be a distinct narrow actor rather than a
  /// repurposing of `client_viewer` — the same treatment as the unreachable
  /// `ApprovalSubjectType` members and the undeliverable `NotificationChannel`
  /// values.
  clientApprovalEnabled Boolean?

  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "approval_policy_brand_fkey")

  /// One policy per brand.
  @@unique([workspaceId, brandId])
  @@map("approval_policy")
}

/// How a notification reaches its recipient. Only `IN_APP` is deliverable in
/// this phase — no mail transport exists in the platform, and D-123 records
/// that external delivery is Phase 8 launch hardening. The enum is declared in
/// full because docs/DATABASE.md §9.3 designs it.
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

/// TENANT-OWNED. One in-app notification for one member — docs/DATABASE.md
/// §9.3.
///
/// WRITTEN FROM DOMAIN EVENTS, never from a UI handler. `packages/notifications`
/// is the only writer, and it is called by the service that changed the state,
/// so a notification cannot exist for something that did not happen.
model Notification {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid

  /// The recipient. NOT NULL: a workspace-wide notification would have no
  /// per-reader unread state, which is the one thing this table is for.
  /// Fan-out to several members is several rows, each independently readable.
  userId String @db.Uuid

  /// The event key — `approval.requested`, `approval.approved`,
  /// `approval.changes_requested`, `approval.rejected`. The rendered STRING is
  /// not stored: the reader's locale is known at read time, and storing one
  /// language would make the inbox monolingual for a bilingual workspace.
  templateKey String

  /// The values the template interpolates: `{ itemTitle, brandName, actorName }`.
  /// Bounded and free of secrets; the redaction layer applies as everywhere.
  payload Json?

  channel NotificationChannel @default(IN_APP)

  /// Where the notification points. A workspace-relative path, locale-prefixed
  /// at render time, so a deep link cannot leak another workspace's route.
  linkPath String?

  brandId      String? @db.Uuid
  resourceType String?
  resourceId   String? @db.Uuid

  /// NULL until the recipient reads it. The one mutable column, and the reason
  /// this is not derived from `audit_event`, which is append-only by design.
  readAt DateTime? @db.Timestamptz(6)

  /// One notification per logical event per recipient, however many times the
  /// producing action is retried.
  idempotencyKey String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, userId, readAt, createdAt(sort: Desc)])
  @@index([workspaceId, userId, createdAt(sort: Desc)])
  @@map("notification")
}
